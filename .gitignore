# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Secrets — never commit real environment files. Only *.example files are tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local caches
.eslintcache
.turbo/
dist-test/

# Generated Prisma client — regenerated by `prisma generate`, never committed
apps/api/src/generated/
dist-scripts/

# Local scratch and caches (Prompt 43 baseline)
logs/
tmp/
temp/
.cache/

# The marketing site is a first-class part of the ubossai.com deployment. Its own lockfile stays
# tracked; the global node_modules, .next and environment-file rules above still exclude local data.
uboss-website/AGENTS.md
uboss-website/CLAUDE.md
uboss-website/DESIGN-V2-NOTES.md
uboss-website/WEBSITE-3D-PLAN.md
uboss-website/image.png
apps/api/scripts/provision-spm-medicare.mjs
docs/UBOSS_MASTER_*.md
apps/api/.file-store/
