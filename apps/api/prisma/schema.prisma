// UBoss — foundation schema.
//
// SCOPE (Prompt 3): tenant/company, user identity/profile, tenant membership, base
// timestamp/version columns and a minimal audit_event shell. Nothing else.
//
// Deliberately NOT here, each owned by its own prompt so it lands with its guards and tests:
//   - tenant lifecycle states (Provisioning/Pending Activation/Active/Suspended/Read-only/Closed)
//     -> Prompt 4
//   - credentials, invitation tokens, sessions, account states -> Prompt 5
//   - roles, scope, module visibility, allowed actions -> Prompt 7
//   - employment records (company Employee ID, designation, department, reporting manager,
//     Aadhaar), Vision/Mission, hierarchy -> Prompt 12 onward
//   - Objectives, Skills, Engine Agents, Executor Agent, approvals, credits -> later prompts
//
// See docs/DB_CHANGELOG.md for the migration policy and the expand/migrate/contract rule.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a customer company. Drives what the TenantGuard permits.
///
/// Only `Active` allows normal work. `ReadOnly` permits reads and blocks writes.
/// `Provisioning`, `PendingActivation`, `Suspended` and `Closed` block workspace access
/// entirely — with a distinct, honest message for each rather than a generic denial.
enum TenantLifecycleState {
  Provisioning
  PendingActivation
  Active
  Suspended
  ReadOnly
  Closed

  @@map("tenant_lifecycle_state")
}

/// A customer company (tenant). The unit of isolation for every tenant-owned row.
///
/// There is no public company signup: tenants are provisioned from the UBoss Master Console.
model Tenant {
  /// Stable primary identity. UUIDv7 is time-ordered, so index locality stays good as rows
  /// are appended, while remaining an opaque UUID externally.
  id String @id @default(uuid(7)) @db.Uuid

  /// URL/lookup handle, e.g. "spm-medicare". Unique across the platform.
  slug String @unique @db.VarChar(63)

  /// Display name shown in `UBOSS AI AMS | {Active Workspace Name}`.
  name String @db.VarChar(200)

  /// Registered legal entity name, when it differs from the display name.
  legalName String? @map("legal_name") @db.VarChar(200)

  // ---- Prompt 10, wizard step 1: company identity ----

  /// The short company/workspace code the client asks for, e.g. `MEDNOVA`. Distinct from
  /// `slug`: the slug is a URL-safe technical key chosen by provisioning, and the code is a
  /// human-facing identifier the customer recognises on an invoice.
  code String? @db.VarChar(20)

  /// Business timezone. Every schedule and due date in the product is computed against this, so
  /// it is company data rather than a per-user preference — a Monday deadline means the
  /// company's Monday.
  timezone String @default("Asia/Kolkata") @db.VarChar(60)

  /// ISO 3166-1 alpha-2, e.g. `IN`. Two letters so it cannot drift into free text.
  countryRegion String? @map("country_region") @db.VarChar(2)

  /// ISO 4217. The currency every minor-unit amount for this company is denominated in.
  currency String @default("USD") @db.VarChar(3)

  // Logo **metadata** only, which is what the client asked for. The bytes live in object
  // storage; a base64 image in a database column would bloat every tenant read.
  logoFileName   String? @map("logo_file_name") @db.VarChar(200)
  logoMimeType   String? @map("logo_mime_type") @db.VarChar(80)
  logoSizeBytes  Int?    @map("logo_size_bytes")
  logoStorageKey String? @map("logo_storage_key") @db.VarChar(300)

  // ---- Prompt 12: company identity shown above the hierarchy ----

  /// The company's Vision, displayed at the top of the Organization Hierarchy screen.
  ///
  /// Company data rather than a settings string: the client's requirement is that the hierarchy
  /// *displays* the active company Vision and Mission, so the structure and the purpose it
  /// serves are read together rather than on separate screens.
  vision String? @db.VarChar(1000)

  /// The company's Mission. See `vision`.
  mission String? @db.VarChar(1000)

  /// Current lifecycle state. New companies start in `Provisioning`; the Master Console moves
  /// them onward. The guard reads this on every tenant-scoped request.
  lifecycleState TenantLifecycleState @default(Provisioning) @map("lifecycle_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency row version, incremented by the application on every update.
  /// NOT the Objective draft/live version chain — that is a separate domain concept.
  version Int @default(1) @map("row_version")

  memberships          TenantMembership[]
  auditEvents          AuditEvent[]
  invitations          Invitation[]
  authPolicy           TenantAuthPolicy?
  ssoConnections       SsoConnection[]
  domainVerifications  DomainVerification[]
  scimClients          ScimClient[]
  ssoAuthRequests      SsoAuthRequest[]
  customRoles          CustomRole[]
  roleAssignments      RoleAssignment[]
  policyRules          PolicyRule[]
  sodPolicies          SeparationOfDutiesPolicy[]
  tcsionMappings       TcsionMapping[]
  securityEvents       SecurityEvent[]
  breakGlassRequests   BreakGlassRequest[]
  subscription         TenantSubscription?
  aiSettings           TenantAiSettings?
  aiBudgetPolicy       TenantAiBudgetPolicy?
  setupTasks           CompanySetupTask[]
  commercialRequests   CommercialChangeRequest[]
  lifecycleTransitions TenantLifecycleTransition[]
  groups               UserGroup[]
  groupMembers         UserGroupMember[]
  departments          Department[]
  employmentRecords    EmploymentRecord[]
  bulkOperations       BulkOperation[]
  offboardings         Offboarding[]
  settings             CompanySetting[]
  performancePolicies  PerformancePolicy[]
  performanceEvents    PerformanceEvent[]
  badgeHistory         BadgeHistory[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  connections          Connection[]
  connectionSecrets    ConnectionSecret[]
  connectionToolGrants ConnectionToolGrant[]
  connectionChecks     ConnectionCheck[]
  skills               Skill[]
  skillVersions        SkillVersion[]
  skillTransitions     SkillTransition[]
  skillEvaluationCases SkillEvaluationCase[]
  skillEvaluationRuns  SkillEvaluationRun[]
  skillComparisons     SkillRegressionComparison[]
  skillCandidates      SkillCandidate[]
  settingChanges       CompanySettingChange[]
  objectives           Objective[]
  objectiveVersions    ObjectiveVersion[]
  objectiveSteps       ObjectiveWorkflowStep[]
  objectiveRewards     ObjectiveReward[]
  rewardAwards         RewardAward[]
  analysisRuns         ObjectiveAnalysisRun[]
  workflowDrafts       ObjectiveWorkflowDraft[]
  humanTasks           HumanTask[]
  humanTaskEvidence    HumanTaskEvidence[]
  humanTaskNotes       HumanTaskNote[]
  engineAgents         EngineAgent[]
  agentRuns            AgentRun[]
  executorExceptions   ExecutorException[]
  exceptionEvents      ExecutorExceptionEvent[]
  agentRunEvents       AgentRunEvent[]
  engineAgentVersions  EngineAgentVersion[]
  aiWorkAssignments    AiWorkAssignment[]
  approvalRequests     ApprovalRequest[]
  approvalDecisions    ApprovalDecisionRecord[]
  approvalDelegations  ApprovalDelegation[]
  providerProfiles     ProviderProfile[]
  providerModels       ProviderModel[]
  logicalModelRoutes   LogicalModelRoute[]
  pricingVersions      PricingVersionRow[]
  modelGatewayCalls    ModelGatewayCall[]
  budgetWallets        BudgetWallet[]
  budgetReservations   BudgetReservation[]
  costLedgerEntries    CostLedgerEntry[]
  creditRequests       CreditRequest[]
  creditGrants         CreditGrant[]
  creditPolicy         CompanyCreditPolicy?
  executorExpectations ExecutorExpectation[]
  memoryPolicies       MemoryPolicyRow[]
  memoryRecords        MemoryRecord[]
  aiOutputFeedback     AiOutputFeedback[]
  outcomeReviews       ObjectiveOutcomeReview[]
  objectivePauses      ObjectivePause[]
  files                StoredFile[]
  knowledgeSources     KnowledgeSource[]
  knowledgeSourceFiles KnowledgeSourceFile[]
  knowledgePolicy      CompanyKnowledgePolicy?
  exits              CompanyExit[]
  supportTickets     SupportTicket[]
  supportTicketNotes SupportTicketNote[]

  idempotencyRecords IdempotencyRecord[]

  // ---- Prompt 40A (CR-03) ----
  employeePhotos      EmployeePhoto[]
  engineAgentOperators EngineAgentOperator[]
  jobMethods          JobMethod[]
  jobMethodImports    JobMethodImport[]
  chatConversations   ChatConversation[]

  /// The Master Console filters companies by lifecycle state.
  @@index([lifecycleState])
  @@map("tenants")
}

/// A person on the UBoss platform, independent of any single company.
///
/// Identity is the UUID `id`. Email is a unique login handle, never the primary identity — a
/// person's email can change while their identity must not.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// The permanent UBoss Unique ID that follows a person across UBoss-enabled companies. It is
  /// not replaced when they change employer. Authorized cross-company profile search uses this,
  /// never Aadhaar.
  ubossUniqueId String @unique @map("uboss_unique_id") @db.VarChar(32)

  /// Login handle. Unique, but not the identity (see the model comment).
  email String @unique @db.VarChar(320)

  /// Name as displayed in the UI.
  displayName String @map("display_name") @db.VarChar(200)

  /// Marks a platform-plane actor who operates the Master Console rather than belonging to a
  /// customer company. The platform role taxonomy (Owner/Admin/Finance/Support/DevOps/Security)
  /// arrives with RBAC at Prompt 7; this is only the minimum discriminator the seed needs.
  isPlatformActor Boolean @default(false) @map("is_platform_actor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  memberships           TenantMembership[]
  auditEvents           AuditEvent[]             @relation("AuditEventActor")
  credential            UserCredential?
  invitations           Invitation[]
  passwordResetTokens   PasswordResetToken[]
  sessions              Session[]
  mfaFactors            MfaFactor[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  mfaChallenges         MfaChallenge[]
  groupMembers          UserGroupMember[]
  roleAssignments       RoleAssignment[]
  securityEventsActed   SecurityEvent[]          @relation("SecurityEventActor")
  securityEventsSubject SecurityEvent[]          @relation("SecurityEventSubject")
  platformRoles         PlatformRoleAssignment[]

  // ---- Prompt 12: the global person registry ----
  //
  // This model **is** the global person. `ubossUniqueId` above is already the permanent
  // cross-company identifier, so a second "global_person" table would be a second answer to
  // "who is this human" — see ADR-062. What Prompt 12 adds is the identifiers used to *match*
  // a person, and their per-company employment records.
  identifiers       PersonIdentifier[]
  employmentRecords EmploymentRecord[] @relation("EmploymentSubject")
  departmentsHeaded Department[]       @relation("DepartmentHead")

  @@map("users")
}

/// Links a platform person to a company. This is the join that authorizes tenant access.
///
/// It is NOT the employment record: company Employee ID, designation, department, reporting
/// manager and Aadhaar belong to the employee/hierarchy model built at Prompt 12. Membership
/// answers only "may this user act inside this tenant".
model TenantMembership {
  id String @id @default(uuid(7)) @db.Uuid

  /// Every tenant-owned row carries tenant_id.
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Employment state of this person inside this company. New memberships start `NotInvited`;
  /// issuing an invitation moves them to `InvitePending`, and activation to `Active`.
  accountState AccountState @default(NotInvited) @map("account_state")

  /// The identity provider's own id for this person in this company, set by SCIM provisioning.
  /// Per membership rather than per user because two companies provisioning the same human will
  /// each have their own id for them.
  scimExternalId String? @map("scim_external_id") @db.VarChar(200)

  /// Whether this membership is externally provisioned. A SCIM-managed membership should not be
  /// edited by hand: the next sync would overwrite the change without warning.
  provisioningSource ProvisioningSource @default(Local) @map("provisioning_source")

  /// What kind of person this is inside THIS company. On the membership rather than on `users`
  /// for the same reason `accountState` is: the same human can be an internal employee at one
  /// company and an external guest at another, so it is a property of the relationship.
  ///
  /// `PlatformUser` never appears here — a platform actor has no company membership, which is
  /// what `User.isPlatformActor` and `TenantGuard` already enforce.
  userType UserType @default(InternalUser) @map("user_type")

  /// When an External Guest's access to this company ends.
  ///
  /// Required for a guest and forbidden for anybody else, enforced by a check constraint. The
  /// client's rule is that guests receive "resource-specific, expiry-capable access", and an
  /// expiry that is optional is one somebody forgets — a guest account with no end date is the
  /// one still open two years after the project finished.
  ///
  /// Separate from `RoleAssignment.expiresAt`, which expires one *grant*. This expires the
  /// person's presence in the company, so revoking it does not depend on having found every
  /// grant they were ever given.
  guestAccessExpiresAt DateTime? @map("guest_access_expires_at") @db.Timestamptz(6)

  /// The external user type and allotment this membership was provisioned from, when it came
  /// through a TCSiON mapping. Free text, holding the client's approved vocabulary verbatim —
  /// nothing here invents a TCSiON definition.
  externalUserType  String? @map("external_user_type") @db.VarChar(120)
  externalAllotment String? @map("external_allotment") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A person holds at most one membership per company.
  @@unique([tenantId, userId])
  /// SCIM addresses users by external id within one company.
  @@unique([tenantId, scimExternalId])
  /// "Show me this company's guests" — an access review's first question.
  @@index([tenantId, userType])
  /// "Which companies does this person belong to" — drives workspace switching.
  @@index([userId])
  @@map("tenant_memberships")
}

/// Append-only audit shell.
///
/// Immutable by design: no `updatedAt`, no `version`, and nothing updates or deletes rows here.
/// Later prompts add their own event types; the shape stays stable.
model AuditEvent {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for platform-plane events that belong to no single company.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Null for system-initiated events with no human actor.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// Stable machine-readable action key, e.g. "tenant.provisioned".
  action String @db.VarChar(120)

  /// The kind of thing acted upon, e.g. "tenant", "user", "tenant_membership".
  resourceType String @map("resource_type") @db.VarChar(60)

  /// Identifier of the affected record, when there is a single one.
  resourceId String? @map("resource_id") @db.VarChar(64)

  /// Short human-readable summary for audit screens.
  summary String? @db.VarChar(500)

  /// Structured detail. Must never contain secrets, credentials or full Aadhaar numbers.
  metadata Json? @db.JsonB

  /// Request correlation id, so an audit trail can be tied to logs.
  correlationId String? @map("correlation_id") @db.VarChar(64)

  // ---- Prompt 8 ----

  /// **Why**, in plain language, distinct from `summary` (which says *what*).
  /// A retention change with no reason is the finding; a reason is what makes
  /// the row answer a question somebody will actually ask.
  reason String? @db.VarChar(1000)

  /// The affected record's optimistic-concurrency version at the time, so a
  /// trail can be lined up against the row it describes. Not the Objective
  /// draft/live version chain — that is a separate domain concept.
  resourceVersion Int? @map("resource_version")

  /// A stable external reference for the affected thing when its id is not
  /// enough: an Objective's version label, a Run id, a document revision.
  resourceRef String? @map("resource_ref") @db.VarChar(120)

  // ---- Tamper evidence. Exact guarantee in ADR-046. ----

  /// Which chain this row belongs to: the tenant id, or `platform` for
  /// tenant-less rows. Nullable because rows written before Prompt 8 predate
  /// the chain and are deliberately NOT retro-chained — see ADR-046.
  chainKey String? @map("chain_key") @db.VarChar(64)

  /// Position in the chain. Strictly increasing with no gaps; a gap is itself
  /// evidence.
  sequence BigInt?

  /// The previous row's `rowHash`. Null on the first row of a chain.
  prevHash String? @map("prev_hash") @db.VarChar(64)

  /// SHA-256 over this row's canonical content and `prevHash`.
  rowHash String? @map("row_hash") @db.VarChar(64)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Chain verification walks this in order. Unique so two rows cannot claim
  /// the same position — which would make the chain ambiguous rather than
  /// merely broken.
  @@unique([chainKey, sequence])
  /// Primary audit read pattern: one tenant's trail, newest first.
  @@index([tenantId, occurredAt(sort: Desc)])
  /// "What did this actor do", newest first.
  @@index([actorUserId, occurredAt(sort: Desc)])
  /// History of one specific record.
  @@index([resourceType, resourceId])
  /// Filtering the trail by action, which is what an export almost always does.
  @@index([tenantId, action, occurredAt(sort: Desc)])
  @@map("audit_events")
}

/// Employment/account state of a person **within one company**.
///
/// Distinct from `TenantLifecycleState`, which is the state of the company itself. A person can
/// be `Suspended` inside an `Active` company, and an `Active` person is still locked out of a
/// `Suspended` company — the guard checks both.
enum AccountState {
  /// Known to the company (e.g. created by HR) but no invitation sent yet.
  NotInvited
  /// Invitation issued; the person has not activated it.
  InvitePending
  /// Activated and permitted to work.
  Active
  /// Temporarily blocked; the membership and history are retained.
  Suspended
  /// Left the company. History is retained; access is gone.
  Offboarded

  @@map("account_state")
}

/// Local password credential for a platform person.
///
/// One row per person, not per company: a person keeps one UBoss identity and one password
/// across every company they work for.
///
/// Only an Argon2id **hash** is ever stored. There is no column that could hold a plaintext or
/// reversible password, so no administrator — and no database reader — can recover one.
model UserCredential {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid

  /// Argon2id PHC string: it embeds the algorithm, parameters and salt, so parameters can be
  /// raised later and old hashes still verify (and can be re-hashed on next successful login).
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// When the password was last set, for policy and for "password changed" notifications.
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at") @db.Timestamptz(6)

  /// Consecutive failed sign-in attempts. Reset to 0 on success.
  failedAttempts Int @default(0) @map("failed_attempts")

  /// Set when the lockout policy trips. Null means not locked.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// A one-time invitation to join a company.
///
/// Only the **hash** of the token is stored, so a database reader cannot mint a working
/// invitation link. The plaintext token exists once, in the response to whoever created the
/// invitation, and is never persisted or logged.
model Invitation {
  id String @id @default(uuid(7)) @db.Uuid

  /// Tenant-owned: an invitation belongs to the inviting company.
  tenantId String @map("tenant_id") @db.Uuid

  /// The person being invited, once their platform identity exists.
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the one-time token. High-entropy random input, so a fast digest is correct here;
  /// a slow KDF is for low-entropy secrets like passwords.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Who issued it, for the audit trail.
  invitedByUserId String? @map("invited_by_user_id") @db.Uuid

  /// Incremented each time the invitation is resent, so the trail shows how many were issued.
  resendCount Int @default(0) @map("resend_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Show me this company's outstanding invitations", newest first.
  @@index([tenantId, createdAt(sort: Desc)])
  /// At most one live invitation per person per company is enforced in the service; this index
  /// makes that check cheap.
  @@index([tenantId, userId])
  @@map("invitations")
}

/// A one-time password-reset token. Hash-only, single-use, expiring.
model PasswordResetToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the one-time token; the plaintext is never stored.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  /// Truncated request origin, for the security trail. Never a full address — see
  /// docs/SECURITY_DECISIONS.md.
  requestedFrom String? @map("requested_from") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_reset_tokens")
}

/// A server-side session.
///
/// UBoss uses opaque server-side sessions rather than self-contained tokens, because every
/// requirement here — Active Sessions, Logout All Devices, admin revoke — depends on being able
/// to revoke a specific session immediately. A stateless token cannot be un-issued.
///
/// Only the token **hash** is stored, so a database reader cannot impersonate a live session.
model Session {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque session token held in the cookie.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// Sliding idle window: refreshed as the session is used.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  /// Hard ceiling, set at creation and never extended, so a session cannot live forever by
  /// being used continuously.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Why it ended, e.g. `logout`, `logout_all`, `admin_revoke`, `password_changed`.
  revokedReason String?   @map("revoked_reason") @db.VarChar(60)

  /// Coarse device description derived from the User-Agent, for the Active Sessions list.
  /// Deliberately not the raw header.
  deviceLabel String? @map("device_label") @db.VarChar(120)

  /// Truncated client address — never the full one. Used to spot a new-location sign-in.
  clientHint String? @map("client_hint") @db.VarChar(64)

  /// How the identity was proved for this session. Recorded so an audit reader can tell a
  /// password sign-in from a federated one without joining anything.
  primaryAuthMethod AuthMethod @default(Password) @map("primary_auth_method")

  /// When a second factor was satisfied. Null on a session that never needed one — which is
  /// different from a session that was *supposed* to have one, because a session is only ever
  /// created after policy has already been satisfied.
  mfaSatisfiedAt DateTime? @map("mfa_satisfied_at") @db.Timestamptz(6)

  /// Which enterprise connection issued this session, for a federated sign-in.
  ssoConnectionId String? @map("sso_connection_id") @db.Uuid

  /// The identity provider's own session identifier (the OIDC `sid` claim). This is what makes
  /// provider-initiated logout possible: a back-channel logout names a provider session, and
  /// UBoss has to be able to find the local sessions that belong to it.
  providerSessionId String? @map("provider_session_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoConnection SsoConnection? @relation(fields: [ssoConnectionId], references: [id], onDelete: SetNull)

  /// "My active sessions" and "revoke everything for this person".
  @@index([userId, revokedAt])
  /// Lets an expiry sweep find dead rows without scanning.
  @@index([absoluteExpiresAt])
  /// Back-channel logout: "end every local session belonging to this provider session".
  @@index([ssoConnectionId, providerSessionId])
  @@map("sessions")
}

// ===========================================================================
// PROMPT 6 — Enterprise identity: MFA, SSO (OIDC/SAML), domain verification,
// SCIM/group provisioning, and per-company authentication policy.
//
// Two storage rules govern everything below, and they differ by design:
//   * A secret that only ever needs to be COMPARED is hashed (SHA-256 for
//     high-entropy tokens, Argon2id for passwords). It can never be read back.
//   * A secret that must be USED — a TOTP shared secret, an OIDC client secret,
//     a PKCE verifier — cannot be hashed, so it is encrypted at rest with a key
//     held outside the database (see src/auth/secret-box.ts). No such value is
//     ever stored, returned or logged in plaintext.
// ===========================================================================

/// How a principal proved who they are. Recorded on the session, so an audit
/// reader can tell a password sign-in from a federated one.
///
/// `WebAuthn` is declared but not implemented at Prompt 6: the model, policy and
/// enrolment flow are method-agnostic so passkeys slot in without a migration.
enum AuthMethod {
  Password
  Totp
  WebAuthn
  Oidc
  Saml
  RecoveryCode

  @@map("auth_method")
}

/// Lifecycle of one enrolled second factor.
///
/// `Pending` exists because enrolment is two-step: a secret is issued, and the
/// factor only becomes usable once the person proves they can generate a code
/// from it. A factor that never reaches `Active` cannot satisfy an MFA policy.
enum MfaFactorState {
  Pending
  Active
  Revoked

  @@map("mfa_factor_state")
}

/// Which federation protocol a connection speaks.
enum SsoProtocol {
  Oidc
  Saml

  @@map("sso_protocol")
}

/// Progress of a company's claim on an email domain.
enum DomainVerificationState {
  /// Token issued, DNS record not yet observed.
  Pending
  /// The expected DNS TXT record was observed. The claim is live.
  Verified
  /// A check ran and the record was absent or wrong.
  Failed
  /// The claim was not completed in time and the token is no longer accepted.
  Expired

  @@map("domain_verification_state")
}

/// Where a group or membership came from, so external provisioning and local
/// edits can be told apart. A SCIM-managed group must not be silently rewritten
/// by hand — the identity provider would overwrite it on the next sync.
enum ProvisioningSource {
  Local
  Scim

  @@map("provisioning_source")
}

/// Per-company authentication policy: how members of this company must sign in.
///
/// One row per tenant, created on demand with safe defaults (password allowed,
/// nothing required) so an absent row and a permissive row mean the same thing.
model TenantAuthPolicy {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Members must present a second factor. Enforced after the password succeeds
  /// and before any session is issued.
  requireMfa Boolean @default(false) @map("require_mfa")

  /// Members must sign in through this company's enterprise identity provider.
  /// Cannot be set without at least one enabled connection — enforced in the
  /// service, because a policy that locks every member out is not a policy.
  requireSso Boolean @default(false) @map("require_sso")

  /// Local password sign-in permitted. Forced false while `requireSso` is true.
  allowPasswordSignIn Boolean @default(true) @map("allow_password_sign_in")

  /// Grace period for a newly-imposed MFA requirement: until this instant a
  /// member with no enrolled factor may still sign in, so switching the policy
  /// on does not instantly lock out everyone who has not enrolled yet.
  mfaGraceUntil DateTime? @map("mfa_grace_until") @db.Timestamptz(6)

  // ---- Prompt 10, wizard step 8: security defaults ----
  //
  // Added here rather than in a new table because they are the same decision as `requireMfa`
  // and `requireSso` — "how does this company govern access" — and a second policy table would
  // give that question two homes.

  /// How long a guest's access lasts by default, in days. The client's "guest expiry defaults".
  /// A guest with no expiry is a permanent external account, which is what this prevents.
  guestExpiryDays Int @default(30) @map("guest_expiry_days")

  /// Whether platform support may request access to this company at all. `false` means even
  /// break-glass is refused for this customer — some contracts require that, and it must be a
  /// company-level switch rather than a support-side convention.
  supportAccessAllowed Boolean @default(true) @map("support_access_allowed")

  /// Whether support access additionally needs this company's own approval, on top of the
  /// platform-side four-eyes rule (ADR-048). Off by default; on for customers who ask.
  supportAccessRequiresCustomerApproval Boolean @default(false) @map("support_access_requires_customer_approval")

  /// Who last changed it, for the audit trail.
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_auth_policies")
}

/// One enrolled second factor for a person.
///
/// Person-level, not company-level: one UBoss identity keeps one set of factors
/// across every company it belongs to, for the same reason it keeps one password.
model MfaFactor {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid

  method AuthMethod     @default(Totp)
  state  MfaFactorState @default(Pending)

  /// Human label shown in Login and Security, e.g. "Authenticator app".
  label String? @db.VarChar(80)

  /// AES-256-GCM envelope holding the TOTP shared secret. NOT a hash: TOTP
  /// verification recomputes the code, so the value must be readable by the
  /// server — and therefore must not be readable from the database alone.
  /// Null for methods that hold no server-side secret (WebAuthn, later).
  secretCiphertext String? @map("secret_ciphertext") @db.VarChar(512)

  /// Highest TOTP time-step already accepted for this factor. A code is refused
  /// if its step is not strictly greater, so an intercepted code cannot be
  /// replayed inside its own validity window.
  lastUsedCounter BigInt? @map("last_used_counter")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Which factors does this person have, and are any active?"
  @@index([userId, state])
  @@map("mfa_factors")
}

/// A single-use MFA recovery code.
///
/// Only a SHA-256 hash is stored and lookup is by hash, so a database reader
/// cannot recover a usable code and verification is one indexed probe rather
/// than a scan of the person's codes.
model MfaRecoveryCode {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the normalised code. Codes carry 100 bits of entropy, so a fast
  /// digest is correct here for the same reason it is for session tokens.
  codeHash String @unique @map("code_hash") @db.VarChar(64)

  usedAt DateTime? @map("used_at") @db.Timestamptz(6)

  /// Regenerating codes retires the whole previous batch at once; the batch id
  /// makes "how many of my current codes are left" a single query.
  batchId String @map("batch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// A password sign-in that has succeeded but is not yet a session, because the
/// company's policy requires a second factor.
///
/// Deliberately NOT a `Session` row with a flag: an unfinished login must not be
/// a session at all, or every guard in the system would have to remember to
/// check whether this particular session is only half-authenticated. Keeping it
/// a separate short-lived object is why `TenantGuard` needed no change.
model MfaChallenge {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque challenge token held in a short-lived cookie.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  /// Failed second-factor attempts against this challenge.
  attempts Int @default(0)

  /// Origin of the original password sign-in, carried through so the session
  /// that eventually gets created records where the login actually came from
  /// rather than where the second step was completed.
  deviceLabel String? @map("device_label") @db.VarChar(120)
  clientHint  String? @map("client_hint") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("mfa_challenges")
}

/// A company's enterprise identity provider connection.
///
/// Tenant-owned and under RLS: an SSO connection carries the company's client
/// secret and its issuer, and one company must never read another's.
model SsoConnection {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  protocol SsoProtocol

  /// Shown on the login screen, e.g. "SPM Medicare SSO".
  displayName String @map("display_name") @db.VarChar(120)

  /// A disabled connection is kept for audit and reconfiguration but cannot be
  /// used to sign in, and does not satisfy `requireSso`.
  enabled Boolean @default(false)

  /// Issuer identifier. Must match the `iss` claim of every accepted ID token.
  issuer String? @db.VarChar(255)

  /// Discovery document URL. Fetched to learn the endpoints and the JWKS URI,
  /// so an identity provider can rotate signing keys without a configuration
  /// change here.
  discoveryUrl String? @map("discovery_url") @db.VarChar(500)

  clientId String? @map("client_id") @db.VarChar(255)

  /// AES-256-GCM envelope holding the OIDC client secret. Used to authenticate
  /// to the token endpoint, so it must be readable by the server — and is
  /// therefore never readable from the database alone, and never returned by
  /// any endpoint.
  clientSecretCiphertext String? @map("client_secret_ciphertext") @db.VarChar(512)

  /// Space-delimited scopes. `openid` is always requested regardless.
  scopes String? @db.VarChar(255)

  /// SAML entity id of the identity provider.
  entityId String? @map("entity_id") @db.VarChar(255)

  /// Identity provider single sign-on and single logout endpoints.
  ssoUrl String? @map("sso_url") @db.VarChar(500)
  sloUrl String? @map("slo_url") @db.VarChar(500)

  /// PEM signing certificate used to verify SAML assertions. A certificate is
  /// public material, so it is stored as-is rather than encrypted.
  signingCertificate String? @map("signing_certificate") @db.Text

  /// Which claim or attribute carries the email and the display name, when the
  /// identity provider does not use the standard names.
  attributeMapping Json? @map("attribute_mapping") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     Session[]
  authRequests SsoAuthRequest[]

  @@index([tenantId, enabled])
  @@map("sso_connections")
}

/// One in-flight SSO authorization request.
///
/// Server-side because every value here is a defence that only works if the
/// server remembers what it sent: `state` binds the callback to this browser,
/// `nonce` binds the ID token to this request, and the PKCE verifier binds the
/// authorization code to this client. Keeping them in a cookie or the URL would
/// mean trusting the attacker-reachable side of the exchange.
model SsoAuthRequest {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  /// SHA-256 of the `state` parameter. Hashed because the plaintext travels in
  /// a URL and therefore through logs, proxies and browser history.
  stateHash String @unique @map("state_hash") @db.VarChar(64)

  /// SHA-256 of the `nonce`. The ID token's nonce claim is hashed and compared,
  /// so the plaintext never has to be stored.
  nonceHash String @map("nonce_hash") @db.VarChar(64)

  /// AES-256-GCM envelope holding the PKCE `code_verifier`. It has to be sent
  /// to the token endpoint verbatim, so it cannot be hashed.
  codeVerifierCiphertext String @map("code_verifier_ciphertext") @db.VarChar(512)

  /// Where to send the browser after a successful sign-in. Validated against an
  /// allow-list before use, so it cannot become an open redirect.
  redirectAfter String? @map("redirect_after") @db.VarChar(500)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sso_auth_requests")
}

/// A company's claim on an email domain.
///
/// Verified control of a domain lets a company invite addresses at that domain
/// without individual confirmation, and lets the login screen route a person to
/// the right company's SSO. It deliberately does NOT create memberships: that
/// would be public signup by another route.
model DomainVerification {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Lower-cased domain, e.g. "spmmedicare.com".
  domain String @db.VarChar(253)

  /// The value the company must publish as a DNS TXT record. Not a secret — it
  /// is proof of control precisely because it is published — but it is
  /// unguessable so one company cannot pre-empt another's verification.
  verificationToken String @map("verification_token") @db.VarChar(80)

  state DomainVerificationState @default(Pending)

  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)

  /// Why the last check failed, in plain language, so the screen can say what
  /// to fix rather than "verification failed".
  failureReason String? @map("failure_reason") @db.VarChar(300)

  /// A pending claim stops being accepted after this instant.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One claim per domain per company. Platform-wide exclusivity for *verified*
  /// domains is a partial unique index added in the migration, because two
  /// companies may legitimately both hold a pending claim while only one can
  /// ever prove control.
  @@unique([tenantId, domain])
  @@index([domain, state])
  @@map("domain_verifications")
}

/// A provisioning client: credentials an identity provider uses to call the
/// UBoss SCIM endpoints on one company's behalf.
model ScimClient {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  displayName String @map("display_name") @db.VarChar(120)

  /// SHA-256 of the bearer token. Returned once at creation and never again,
  /// exactly like an invitation token.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  enabled Boolean @default(true)

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
  @@map("scim_clients")
}

/// A group inside a company, either created locally or provisioned by SCIM.
///
/// Groups carry no permissions at Prompt 6. They are the provisioning target an
/// identity provider pushes, and the thing roles attach to at Prompt 7 —
/// modelling them now means the SCIM contract does not have to change then.
model UserGroup {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  displayName String @map("display_name") @db.VarChar(200)

  /// The identity provider's own id for this group, when SCIM-provisioned.
  externalId String? @map("external_id") @db.VarChar(200)

  source ProvisioningSource @default(Local)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members UserGroupMember[]

  /// A group name is unique within a company.
  @@unique([tenantId, displayName])
  /// SCIM addresses groups by external id, so that lookup must be unique too.
  @@unique([tenantId, externalId])
  @@map("user_groups")
}

/// Membership of a person in a group, within one company.
model UserGroupMember {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  source ProvisioningSource @default(Local)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([tenantId, userId])
  @@map("user_group_members")
}

// ===========================================================================
// PROMPT 7 — the authorization engine.
//
// Five dimensions: User Type, Role, Scope, Module Visibility, Allowed Actions.
// Five policy layers: Platform -> Company -> Department -> Objective ->
// Engine Agent, where a lower layer may be stricter but never weaker than a
// MANDATORY higher-level control.
//
// The vocabulary itself lives in @uboss/types, shared with the web app so a
// permission the server enforces and one the UI renders cannot drift. These
// models are only the storage.
//
// The six built-in roles are deliberately NOT rows — see ROLE_TEMPLATES in
// @uboss/types. A built-in role's meaning must be identical in every company,
// and six rows per tenant would diverge. Only Custom roles are stored.
// ===========================================================================

/// What kind of person is acting. Coarser than a role, and a ceiling a role
/// cannot lift: an External Guest with a Manager role is still a guest.
enum UserType {
  /// An employee of the company.
  InternalUser
  /// A contractor, client contact or partner. Read/comment/draft only, ever.
  ExternalGuest
  /// Operates the UBoss Master Console. Has no company role.
  PlatformUser

  @@map("user_type")
}

/// The role taxonomy. `Custom` means the assignment points at a `CustomRole`.
enum RoleKind {
  Employee
  Manager
  Head
  CompanyAdmin
  Approver
  Auditor
  Custom

  @@map("role_kind")
}

/// How far a role reaches. Ordered narrowest to widest; the order is
/// load-bearing, because "a lower layer may narrow but never widen" is a
/// comparison against this ordering rather than a rule per pair.
enum ScopeKind {
  OwnWork
  SelectedResource
  TeamSubtree
  Department
  MultipleDepartments
  WholeCompany

  @@map("scope_kind")
}

/// The precedence chain, outermost first.
enum PolicyLayer {
  Platform
  Company
  Department
  Objective
  EngineAgent

  @@map("policy_layer")
}

enum PolicyEffect {
  /// Removes an action. Any layer may add one; a mandatory one is sealed.
  Deny
  /// Grants an exception to a NON-mandatory denial from a higher layer. Cannot
  /// lift a mandatory one — the engine records the refused override rather
  /// than silently ignoring it.
  Allow

  @@map("policy_effect")
}

/// Separation-of-duties rules.
enum SodRule {
  /// The person who created the thing cannot approve it.
  NoSelfApproval
  /// Two distinct people must act. An automated agent can never satisfy this.
  FourEyes

  @@map("sod_rule")
}

/// A company-defined role.
///
/// Built-in roles are code (see the file header). This exists so a company can
/// express something the six built-ins do not, and it is stored as a permission
/// matrix rather than as a set of rows per module/action: the matrix is read as
/// a whole on every authorization decision, and normalising it would turn one
/// read into a join for no benefit.
model CustomRole {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  displayName String  @map("display_name") @db.VarChar(120)
  description String? @db.VarChar(500)

  /// `{ "<moduleKey>": ["View", "EditDraft", ...] }`. Read through
  /// `sanitisePermissionSet`, which drops any module or action it does not
  /// recognise — so a renamed module fails CLOSED rather than becoming an
  /// unenforceable grant.
  permissions Json @db.JsonB

  /// The widest scope this role may be assigned. An assignment narrower than
  /// this is always allowed; a wider one is refused.
  maxScope ScopeKind @default(OwnWork) @map("max_scope")

  /// A disabled role keeps its assignments for audit but grants nothing.
  enabled Boolean @default(true)

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([tenantId, displayName])
  @@index([tenantId, enabled])
  @@map("custom_roles")
}

/// A person holding a role, at a scope, inside one company.
///
/// Several assignments per person are normal and intended: Employee for their
/// own work plus Approver on three named objectives is two assignments, and the
/// effective permission is the UNION of what they grant. Policy layers then
/// narrow that union — which is the only direction anything tightens.
model RoleAssignment {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  roleKind RoleKind @map("role_kind")

  /// Set only when `roleKind` is `Custom`. Enforced in the service, because a
  /// check constraint across an enum and a nullable FK is not expressible in
  /// Prisma and would be invisible to the reader here.
  customRoleId String? @map("custom_role_id") @db.Uuid

  scopeKind ScopeKind @map("scope_kind")

  /// For `Department` and `MultipleDepartments`. Department identifiers are
  /// stored as opaque strings because the hierarchy model arrives at Prompt 12;
  /// a foreign key would have to be added then and cannot be added now.
  departmentIds String[] @map("department_ids")

  /// For `SelectedResource` — the explicit list a scope of that kind means.
  selectedResourceIds String[] @map("selected_resource_ids")

  /// Time-boxed access, for a contractor or a temporary approver. Null means
  /// no expiry. An expired assignment grants nothing and is not deleted, so the
  /// audit trail keeps "this person did have access, until this date".
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  grantedByUserId String? @map("granted_by_user_id") @db.Uuid

  /// True when provisioning created this grant rather than a person.
  ///
  /// The client's bootstrap rule: the first Company Admin must not require an existing Company
  /// Admin to grant it. Provisioning is therefore the one grantor with no human behind it, and
  /// this column makes those grants **queryable** — "show me every authority nobody chose" is
  /// the first question an access review asks, and an audit event alone cannot answer it in a
  /// list. A check constraint ties it to a null grantor so the two cannot disagree.
  bootstrap Boolean @default(false)

  /// Why it was granted. Not decoration: an access review asks this question,
  /// and an empty answer is the finding.
  justification String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  /// One assignment per person per role per company. A second Approver
  /// assignment for the same person would be two answers to one question.
  @@unique([tenantId, userId, roleKind, customRoleId])
  /// The hot path: "what does this person hold in this company".
  @@index([tenantId, userId])
  @@index([tenantId, roleKind])
  @@map("role_assignments")
}

/// One policy statement at one layer of the precedence chain.
///
/// Restrictions only, plus explicit exceptions to non-mandatory ones. There is
/// no way to express a *grant* here, deliberately: grants come from roles, and
/// a policy layer that could grant would let a department award itself
/// permissions its company never gave it.
model PolicyRule {
  id String @id @default(uuid(7)) @db.Uuid

  layer PolicyLayer

  /// Null for a `Platform` rule, which applies to every company. Set for every
  /// other layer.
  tenantId String? @map("tenant_id") @db.Uuid

  /// The subject at layers below Company. Opaque strings for the same reason as
  /// `departmentIds` — the Objective and Engine Agent models arrive later, and
  /// a policy written now must not have to be rewritten then.
  departmentId  String? @map("department_id") @db.VarChar(64)
  objectiveId   String? @map("objective_id") @db.VarChar(64)
  engineAgentId String? @map("engine_agent_id") @db.VarChar(64)

  /// Null means every module. How a broad control is expressed without
  /// enumerating the matrix.
  module String? @db.VarChar(64)
  /// Null means every action.
  action String? @db.VarChar(32)

  effect PolicyEffect

  /// Sealed against lower layers. Only meaningful on a `Deny`: a mandatory
  /// `Allow` would be a grant lower layers could not tighten, which is the one
  /// thing the precedence rule forbids.
  mandatory Boolean @default(false)

  /// A scope ceiling this layer imposes. Only ever narrows — the engine ignores
  /// and records an attempt to widen.
  maxScope ScopeKind? @map("max_scope")

  /// Shown in the denial message when this rule is the one that refused, so it
  /// has to be written for the person who will read it.
  reason String @db.VarChar(300)

  enabled Boolean @default(true)

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The read pattern: every rule that could apply to one company, including
  /// the platform rules that apply to all of them.
  @@index([tenantId, layer, enabled])
  @@index([layer, enabled])
  @@map("policy_rules")
}

/// A configured separation-of-duties control.
///
/// Separate from `PolicyRule` because it is not about authority. The same
/// person with the same role may approve one thing and not another, purely
/// because they wrote the second one — so it cannot be folded into a permission
/// matrix without becoming invisible in every permissions screen.
model SeparationOfDutiesPolicy {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a platform-wide baseline that every company inherits.
  tenantId String? @map("tenant_id") @db.Uuid

  layer PolicyLayer @default(Company)

  /// Null means every module.
  module String? @db.VarChar(64)
  action String  @db.VarChar(32)

  rule SodRule

  /// Sealed against lower layers, exactly as a mandatory `PolicyRule` is. A
  /// mandatory four-eyes control on Approve is the kind of thing a regulator
  /// asks about, and a department must not be able to remove it.
  mandatory Boolean @default(false)

  reason String @db.VarChar(300)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
  @@index([action, enabled])
  @@map("separation_of_duties_policies")
}

/// The TCSiON mapping extension point.
///
/// **No TCSiON definitions are invented anywhere in this codebase.** The client
/// has stated that TCSiON user types and allotments are an external dependency,
/// and the approved reference has not been supplied. This table is the shape
/// that reference maps INTO, and it is empty until someone loads the client's
/// approved list.
///
/// `externalUserType` and `externalAllotment` are free-text on purpose: they
/// hold whatever the client's document says, verbatim. Constraining them to an
/// enum would mean guessing the vocabulary, which is exactly what was forbidden.
///
/// A sign-in by someone whose external type has no row here resolves to NO
/// UBoss role, which fails closed with a distinct reason naming the missing
/// mapping — rather than silently defaulting to Employee.
model TcsionMapping {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The external user type, exactly as the approved reference spells it.
  externalUserType String @map("external_user_type") @db.VarChar(120)

  /// The external allotment, when the reference distinguishes them. Null when
  /// the mapping is by user type alone.
  externalAllotment String? @map("external_allotment") @db.VarChar(120)

  // ---- The UBoss side: all five dimensions ----
  ubossUserType UserType  @map("uboss_user_type")
  roleKind      RoleKind  @map("role_kind")
  customRoleId  String?   @map("custom_role_id") @db.Uuid
  scopeKind     ScopeKind @map("scope_kind")

  departmentIds String[] @map("department_ids")

  /// `{ "<moduleKey>": true|false }` — module visibility. Absent modules are
  /// not visible, so this fails closed.
  moduleVisibility Json @map("module_visibility") @db.JsonB

  /// `{ "<moduleKey>": ["View", ...] }` — a further RESTRICTION on top of the
  /// role, never an addition. Applied as an intersection, so a mapping cannot
  /// grant an action the role does not have.
  allowedActions Json @map("allowed_actions") @db.JsonB

  /// Which client document and version this row came from. Mandatory, because
  /// the whole point of this table is that its contents are traceable to an
  /// approved external reference rather than to someone's assumption.
  approvedReference String @map("approved_reference") @db.VarChar(300)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalUserType, externalAllotment])
  @@index([tenantId, enabled])
  @@map("tcsion_mappings")
}

// ===========================================================================
// PROMPT 8 — audit and security foundations.
//
// Three things:
//   1. `audit_events` gains the fields the client named (reason, resource
//      version/ref) and a per-chain hash chain for tamper evidence.
//   2. `security_events` becomes its own table. This REVERSES a Prompt 5
//      decision, deliberately and with a stated reason — see ADR-045.
//   3. Break-glass recovery becomes a first-class record with a lifecycle,
//      rather than an out-of-band arrangement nobody can audit.
//
// The exact tamper-evidence guarantee is documented in ADR-046 and
// SECURITY_DECISIONS S-049. It is deliberately narrower than "the audit trail
// cannot be altered", because that would be false.
// ===========================================================================

/// Which part of the system a security event came from.
///
/// The client named four: login, session, risk and support. `Access` is added
/// because Prompt 7 produces permission and role events that are none of those
/// four and would otherwise have nowhere honest to go.
enum SecurityEventCategory {
  /// Sign-in, activation, password reset, MFA.
  Login
  /// Session lifecycle: issue, revoke, expire, logout-all.
  Session
  /// Suspicious activity: new device, lockout, replay, separation-of-duties block.
  Risk
  /// Support and break-glass access to a customer's company.
  Support
  /// Authorization: role grants, policy changes, permission denials.
  Access

  @@map("security_event_category")
}

/// How much attention an event deserves.
///
/// Deliberately coarse. A finer scale invites arguing about whether something
/// is a 6 or a 7 instead of deciding whether anyone has to look at it.
enum SecurityEventSeverity {
  /// Routine and expected. A successful sign-in.
  Info
  /// Worth noticing in aggregate. A failed sign-in, a new device.
  Notice
  /// Someone should look. A lockout, a blocked self-approval, a replay.
  Warning
  /// Someone should look now. Break-glass activation, a mandatory control bypassed.
  Critical

  @@map("security_event_severity")
}

/// Did the thing being attempted succeed?
///
/// Separate from severity: a *successful* break-glass activation is Critical,
/// and a *failed* sign-in is only Notice.
enum SecurityEventOutcome {
  Succeeded
  Failed
  Blocked

  @@map("security_event_outcome")
}

/// The security event trail.
///
/// Append-only, and enforced by more than convention — see the migration:
/// UPDATE and DELETE privileges are revoked from the application role, and a
/// trigger raises an exception on either. There is no repository method that
/// could update or delete one.
///
/// Separate from `audit_events` because the two answer different questions and
/// have genuinely different shapes: an audit event is "who changed what", a
/// security event is "what happened to an identity or a session". A security
/// event frequently has NO actor (a failed sign-in for an address that does not
/// exist) and no resource, and it carries device and network context that a
/// business audit row has no business holding.
model SecurityEvent {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a platform-plane event: a failed sign-in belongs to no company,
  /// and a sign-in happens before any workspace is chosen.
  tenantId String? @map("tenant_id") @db.Uuid

  category SecurityEventCategory
  severity SecurityEventSeverity @default(Info)
  outcome  SecurityEventOutcome  @default(Succeeded)

  /// Stable machine-readable key from the closed `SECURITY_ACTIONS` set.
  action String @db.VarChar(120)

  /// Who did it. Null when the account could not be identified — which is the
  /// normal case for a failed sign-in, and is why this is nullable rather than
  /// defaulted to something.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// Who it was done TO, when that differs from the actor: an administrator
  /// revoking somebody else's session, a role granted to a colleague.
  subjectUserId String? @map("subject_user_id") @db.Uuid

  resourceType String? @map("resource_type") @db.VarChar(60)
  resourceId   String? @map("resource_id") @db.VarChar(64)

  /// Why, in plain language, for whoever reads this during an investigation.
  reason String? @db.VarChar(500)

  /// Structured detail. Never a password, token, credential or full client
  /// address — enforced by the publisher's redaction pass.
  metadata Json? @db.JsonB

  /// Coarse device and network context. A truncated prefix, never a full
  /// address — see SECURITY_DECISIONS S-025.
  deviceLabel String? @map("device_label") @db.VarChar(120)
  clientHint  String? @map("client_hint") @db.VarChar(64)

  correlationId String? @map("correlation_id") @db.VarChar(64)

  // ---- Tamper evidence. See ADR-046 for the exact guarantee. ----

  /// Which chain this row belongs to: the tenant id, or the literal `platform`
  /// for tenant-less rows. Per-chain rather than one global chain so an
  /// auditor can verify one company's trail without reading everyone's, and so
  /// inserts for different companies do not serialise on one head.
  chainKey String @map("chain_key") @db.VarChar(64)

  /// Position in the chain. Strictly increasing, no gaps — a gap is itself
  /// evidence, which is why this is not simply an ordering hint.
  sequence BigInt

  /// The previous row's `rowHash` in this chain. Null only for the first row.
  prevHash String? @map("prev_hash") @db.VarChar(64)

  /// SHA-256 over this row's canonical content and `prevHash`. Any change to
  /// any field, or to the row's position, breaks every subsequent hash.
  rowHash String @map("row_hash") @db.VarChar(64)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor   User?   @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject User?   @relation("SecurityEventSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  /// Chain verification walks this in order.
  @@unique([chainKey, sequence])
  /// The primary read: one company's security trail, newest first.
  @@index([tenantId, occurredAt(sort: Desc)])
  /// "What happened to this person", newest first.
  @@index([actorUserId, occurredAt(sort: Desc)])
  /// Filtering a Security Centre by category and severity.
  @@index([tenantId, category, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@map("security_events")
}

/// A signed position in a hash chain, exported so the chain cannot be silently
/// rewritten wholesale.
///
/// The chain alone proves nothing against an attacker who can rewrite every
/// row, because they can recompute every hash. What defeats that is a
/// previously-published chain head that they cannot reach. This table records
/// each such head; `externalAnchorRef` is where it was published to.
///
/// **No external sink is implemented at Prompt 8.** The column exists, it is
/// nullable, and an unanchored checkpoint is honestly weaker than an anchored
/// one — the API reports which it is rather than implying they are equivalent.
model AuditChainCheckpoint {
  id String @id @default(uuid(7)) @db.Uuid

  /// Which chain and which trail. A tenant has one audit chain and one
  /// security chain, and they are sealed independently.
  chainKey String @map("chain_key") @db.VarChar(64)
  trail    String @db.VarChar(16)

  /// The sequence and hash this checkpoint attests to.
  sequence BigInt
  rowHash  String @map("row_hash") @db.VarChar(64)

  /// How many rows the chain held when sealed. A later verification comparing
  /// this against the live count detects wholesale deletion even if the
  /// remaining chain is internally consistent.
  rowCount BigInt @map("row_count")

  /// Where this head was published, when it was. Null means it was sealed but
  /// never exported anywhere an attacker could not also reach — which the
  /// verification API reports rather than glossing over.
  externalAnchorRef String?   @map("external_anchor_ref") @db.VarChar(300)
  anchoredAt        DateTime? @map("anchored_at") @db.Timestamptz(6)

  sealedByUserId String? @map("sealed_by_user_id") @db.Uuid

  sealedAt DateTime @default(now()) @map("sealed_at") @db.Timestamptz(6)

  @@index([chainKey, trail, sealedAt(sort: Desc)])
  @@map("audit_chain_checkpoints")
}

/// Where a break-glass request has got to.
///
/// The order is the workflow, and every transition is audited. It is a state
/// machine rather than a set of booleans because "approved but identity not
/// verified" must be unrepresentable.
enum BreakGlassState {
  /// Raised, nothing verified or approved yet. Grants nothing.
  Requested
  /// The requester's identity has been verified out of band.
  IdentityVerified
  /// A second person approved it. Still grants nothing until activated.
  Approved
  /// Refused. Terminal.
  Denied
  /// In force. This is the only state that grants anything.
  Active
  /// The window passed. Terminal.
  Expired
  /// Ended early, by the approver or by the customer. Terminal.
  Revoked

  @@map("break_glass_state")
}

/// How the requester's identity was confirmed.
///
/// `Unverified` is the default and grants nothing: a break-glass request from
/// an unverified requester is a request, not an entitlement.
enum IdentityVerificationState {
  Unverified
  /// Confirmed by a live human channel — a call to a known number, a video
  /// call. Recorded with who confirmed it and how.
  VerifiedByHuman
  /// Confirmed by a second factor the requester already held.
  VerifiedBySecondFactor
  /// Verification was attempted and failed. Terminal for this request.
  Failed

  @@map("identity_verification_state")
}

/// Whether the customer has been told.
///
/// Break-glass is access to a customer's data without their prior consent.
/// Notifying them is not optional courtesy, it is the thing that makes the
/// mechanism defensible — so its status is a tracked field with a failure
/// state, not a checkbox someone remembers.
enum CustomerNotificationState {
  /// Not sent yet. Visible as an outstanding obligation.
  Pending
  Sent
  /// Delivery failed. Distinct from Pending so a failure is not mistaken for
  /// "not yet attempted".
  Failed
  /// Deliberately withheld, with a recorded reason — e.g. an active
  /// investigation where the customer is the subject. Requires the reason.
  Suppressed

  @@map("customer_notification_state")
}

/// A break-glass recovery record.
///
/// Break-glass is a platform operator reaching into a customer's company
/// outside the normal authorization engine — for a lockout, a data-recovery
/// request, an incident. It exists because refusing to have a mechanism does
/// not prevent the access, it just moves it somewhere unaudited.
///
/// Every field the client named is here, and the model is built so the unsafe
/// combinations cannot be stored: `Active` requires a verified identity, an
/// approver who is not the requester, and an expiry.
model BreakGlassRequest {
  id String @id @default(uuid(7)) @db.Uuid

  /// Which company is being reached into. Not nullable: break-glass without a
  /// subject company is not break-glass, it is a platform operation.
  tenantId String @map("tenant_id") @db.Uuid

  /// Who asked. Never null, and never the approver — enforced by a check
  /// constraint as well as by the service.
  requesterUserId String @map("requester_user_id") @db.Uuid

  state BreakGlassState @default(Requested)

  // ---- Identity verification ----
  identityVerificationState IdentityVerificationState @default(Unverified) @map("identity_verification_state")
  /// How it was verified, in words: "called the number on file", "confirmed on
  /// the incident bridge". Required to leave `Unverified`.
  identityVerificationNote  String?                   @map("identity_verification_note") @db.VarChar(500)
  identityVerifiedByUserId  String?                   @map("identity_verified_by_user_id") @db.Uuid
  identityVerifiedAt        DateTime?                 @map("identity_verified_at") @db.Timestamptz(6)

  /// Why this access is needed. Mandatory and free text, because the whole
  /// point of the record is that somebody had to write down a reason a person
  /// will later read.
  reason String @db.VarChar(1000)

  /// A reference to the authorising context — an incident id, a support
  /// ticket, a customer's written request.
  externalReference String? @map("external_reference") @db.VarChar(300)

  // ---- Allowed scope ----
  /// Which modules this grant covers. Empty means none: a break-glass record
  /// with no scope grants nothing, which is the safe reading of an
  /// incompletely filled request.
  allowedModules     String[] @map("allowed_modules")
  /// Which actions. Restricted by the service to a read-oriented set unless
  /// the request explicitly justifies more.
  allowedActions     String[] @map("allowed_actions")
  /// Optional narrowing to named records, for a single-record recovery.
  allowedResourceIds String[] @map("allowed_resource_ids")

  // ---- Approval ----
  approverUserId String?   @map("approver_user_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  /// Why it was approved or denied. Read during a review, so it has to say
  /// something.
  approvalNote   String?   @map("approval_note") @db.VarChar(500)
  deniedAt       DateTime? @map("denied_at") @db.Timestamptz(6)

  // ---- The window ----
  /// When it starts being usable. Set at activation, not at request.
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(6)
  /// Hard ceiling, set at approval. Break-glass without an expiry is a
  /// standing back door, so this is not nullable once approved.
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  revocationReason String?   @map("revocation_reason") @db.VarChar(500)

  // ---- Customer notification ----
  customerNotificationState     CustomerNotificationState @default(Pending) @map("customer_notification_state")
  customerNotifiedAt            DateTime?                 @map("customer_notified_at") @db.Timestamptz(6)
  /// Required when the state is `Suppressed`: withholding notification needs a
  /// recorded justification, not silence.
  notificationSuppressionReason String?                   @map("notification_suppression_reason") @db.VarChar(500)

  // ---- Customer authorization (Prompt 36) ----
  /// Whether this company's own policy required them to authorize this session, and what they
  /// said. From `CUSTOMER_AUTHORIZATION_STATES`.
  ///
  /// Distinct from `customerNotificationState`, which is *telling* them. A company on the
  /// `Required` policy must **say yes** before the session can start, and there is no bypass —
  /// an emergency override would make the control advisory, which is worse than not having it.
  customerAuthorizationState String    @default("NotRequired") @map("customer_authorization_state") @db.VarChar(20)
  /// Which of their administrators decided, and when. Both or neither, by check constraint.
  customerAuthorizedByUserId String?   @map("customer_authorized_by_user_id") @db.Uuid
  customerAuthorizedAt       DateTime? @map("customer_authorized_at") @db.Timestamptz(6)
  /// Required on a decline: a refusal nobody explained cannot be answered.
  customerAuthorizationNote  String?   @map("customer_authorization_note") @db.VarChar(500)

  /// The ticket this access was asked for, when it came from one. Optional: an incident-driven
  /// session has no ticket, and inventing one would be a fiction in the record.
  supportTicketId String? @map("support_ticket_id") @db.Uuid

  /// How many times the grant was actually used. Zero on a closed request is
  /// a useful finding: access was granted and never needed.
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a session can never point at another company's ticket.
  /// NO ACTION for the reason ADR-204 records: SET NULL over a composite key would null
  /// `tenant_id` too. A ticket that a support session references is not deleted; it is closed.
  supportTicket SupportTicket? @relation(fields: [tenantId, supportTicketId], references: [tenantId, id], onDelete: NoAction)

  /// "What break-glass access does this company have or has it had", newest first.
  @@index([tenantId, createdAt(sort: Desc)])
  /// The operational question: what is live right now.
  @@index([state, expiresAt])
  /// Outstanding notification obligations.
  @@index([customerNotificationState, state])
  @@map("break_glass_requests")
}

// ===========================================================================
// Prompt 9 — the UBoss Master Console
// ===========================================================================
//
// Everything below is **platform-plane**: owned by UBoss, not by a customer company. That is the
// distinction that decides Row-Level Security. `plans`, `feature_flags`, `platform_settings`,
// `service_alerts` and `platform_role_assignments` have no `tenant_id` at all and therefore no
// RLS policy — there is no tenant to isolate. They are protected by the `uboss_app` grants plus
// the platform-role guards, and a company-plane request has no route to them because every
// Master Console controller is `@PlatformOnly`.
//
// `tenant_subscriptions` is the one exception: it is *about* a company, so it carries a
// `tenant_id`, gets RLS like every other tenant-owned table, and a company can eventually be
// shown its own plan without the platform having to hand it over.

enum PlatformRoleKind {
  /// Everything, including global settings and feature releases.
  PlatformOwner
  /// The role the client's UI names. Everything except the two global controls.
  PlatformAdmin
  /// Plans, billing and AI allowance.
  PlatformCommercial
  /// Tenant support and operational tasks.
  PlatformSupport
  /// Security posture and audit. Sees everything, changes only security.
  PlatformSecurity
  /// The AI platform and operations. Reads releases, does not control them.
  PlatformEngineer

  @@map("platform_role_kind")
}

enum PlanTier {
  Starter
  Growth
  Enterprise
  /// A time-boxed evaluation. Not in the client's plan table, but the reference
  /// UI shows a `Pilot` badge, so the tier exists rather than being smuggled in
  /// as a `Starter` with a different price.
  Pilot

  @@map("plan_tier")
}

enum SubscriptionState {
  /// Provisioned but the company has not been activated yet.
  Pending
  Active
  /// Suspended for non-payment or by platform decision. Distinct from the
  /// tenant's own lifecycle state: a suspended subscription and a closed
  /// company are different situations with different recovery paths.
  Suspended
  /// The term ended and was not renewed.
  Expired
  Cancelled

  @@map("subscription_state")
}

enum BillingState {
  /// Paid up. The reference UI's `Current`.
  Current
  /// Past due but inside the grace period.
  Grace
  /// Past due beyond grace. The reference UI's `Overdue`.
  Overdue

  @@map("billing_state")
}

enum AttentionFlag {
  /// No attention needed. Rendered as the reference's em dash.
  None
  Billing
  Budget
  Security
  Seats
  Renewal

  @@map("attention_flag")
}

enum FeatureStage {
  Dev
  Staging
  Uat
  Prod

  @@map("feature_stage")
}

enum FeatureFlagState {
  /// Off for everybody. The safe default for a new flag.
  Paused
  /// Being reviewed before it may be enabled.
  InReview
  Active
  /// Permanently on and no longer a flag; kept for the record.
  Retired

  @@map("feature_flag_state")
}

enum ServiceAlertSeverity {
  Info
  Warning
  Critical

  @@map("service_alert_severity")
}

enum ServiceAlertState {
  Open
  Acknowledged
  /// The impact has stopped but the cause has not been fixed. Added at Prompt 36: without it, an
  /// operator has to choose between claiming an outage is resolved and leaving it looking
  /// untouched.
  Mitigated
  Resolved

  @@map("service_alert_state")
}

/// Which platform roles a person holds.
///
/// `isPlatformActor` on `users` still answers "is this platform staff"; this
/// answers "which parts of the Master Console". Before Prompt 9 the second
/// question had no answer, so every platform actor was granted all fifteen
/// modules and a permission decorator on a Master Console route could not
/// refuse anybody. See ADR-049.
///
/// A person may hold several: the permissions union, for the same reason they
/// union on the company side.
model PlatformRoleAssignment {
  id String @id @default(uuid(7)) @db.Uuid

  userId String           @map("user_id") @db.Uuid
  role   PlatformRoleKind

  /// Who granted it. Null only for the migration backfill and the seed, which
  /// have no granting human — recorded as null rather than attributed to
  /// somebody who did not do it.
  grantedByUserId String? @map("granted_by_user_id") @db.Uuid

  /// Why. Platform authority is the most consequential grant in the product,
  /// so the reason is a column rather than something to reconstruct later.
  justification String? @db.VarChar(500)

  /// A time-boxed grant, for a contractor or an on-call rotation. Null means
  /// standing. Expiry is evaluated on read, never by a sweep.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per person per role. A second grant of the same role updates the
  /// existing row rather than creating an ambiguous duplicate.
  @@unique([userId, role])
  @@index([role])
  @@map("platform_role_assignments")
}

/// A commercial plan: seats, module entitlements, AI allowance and price.
///
/// Platform-owned and shared across companies, which is why it is a table
/// rather than a per-tenant record: "Growth" must mean the same thing
/// everywhere, and a plan whose terms differed per company would make the
/// Plans screen meaningless.
model Plan {
  id String @id @default(uuid(7)) @db.Uuid

  /// Stable machine key, e.g. `growth`. Referenced by configuration and by the
  /// platform default setting, so it must not change when the label does.
  code String   @db.VarChar(40)
  tier PlanTier

  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  /// Licensed seats, or null for "Custom" as the reference's Enterprise row
  /// shows. Null means negotiated per company and read from the subscription.
  seatLimit Int? @map("seat_limit")

  /// The company modules this plan turns on. Validated against
  /// `COMPANY_MODULES` on write and read through `sanitisePermissionSet`'s
  /// sibling, so a renamed module fails closed rather than silently entitling.
  entitledModules String[] @map("entitled_modules")

  /// Monthly AI allowance in minor units of `currency`. Null for "Custom".
  ///
  /// Minor units and an integer, never a float: money in a float is how
  /// rounding differences become invoice disputes.
  aiAllowanceMinor Int?   @map("ai_allowance_minor")
  /// Monthly price in minor units. Null for "Custom".
  priceMinor       Int?   @map("price_minor")
  currency         String @default("USD") @db.VarChar(3)

  /// A retired plan keeps its subscriptions but cannot be chosen for a new
  /// company. Deleting it would orphan the companies on it.
  active Boolean @default(true)

  /// Display order on the Plans screen, so it is not alphabetical by accident.
  sortOrder Int @default(0) @map("sort_order")

  // ---- Prompt 11 ----

  /// Which account states consume a contracted seat, for companies on this plan.
  ///
  /// On the **plan** because it is a commercial term: a per-provisioned-person contract and a
  /// per-concurrent-user contract count differently, and that is negotiated, not preferred. A
  /// company may have a documented override on its subscription; see `seatCountingOverride`.
  seatCountingRule SeatCountingRule @default(ActiveAndInvited) @map("seat_counting_rule")

  /// Which release channel this plan grants. **Not** the same as an entitlement: entitlement
  /// says whether a company has a module, the channel says which version of it they see.
  releaseChannel ReleaseChannel @default(Stable) @map("release_channel")

  /// Whether a company on this plan may **request** more seats when it hits the ceiling, or is
  /// simply blocked.
  ///
  /// The client's instruction is "block new counted user OR Request/Buy More Seats according to
  /// policy", so which of the two happens has to be a policy value rather than a hard-coded
  /// behaviour. A Pilot plan blocks; a paid plan invites the conversation.
  allowSeatRequests Boolean @default(true) @map("allow_seat_requests")

  /// Days of grace after a downgrade before the lower ceiling is enforced, so a company that
  /// drops from 40 seats to 25 with 30 people is not instantly locked out of its own workspace.
  downgradeGraceDays Int @default(30) @map("downgrade_grace_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  subscriptions        TenantSubscription[]
  pendingSubscriptions TenantSubscription[] @relation("PendingPlan")

  @@unique([code])
  @@index([active, sortOrder])
  @@map("plans")
}

/// A company's current commercial position: plan, seats, billing, renewal and
/// AI allowance.
///
/// Tenant-owned, so it carries `tenant_id` and gets RLS. One row per company —
/// the *current* subscription. Historic terms belong in an events table when
/// billing history is built; modelling history now would be guessing at the
/// shape of a module that does not exist.
model TenantSubscription {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  state        SubscriptionState @default(Pending)
  billingState BillingState      @default(Current) @map("billing_state")

  /// Wizard step 3. Drives when `renewsAt` advances; no invoicing depends on it yet.
  billingCycle BillingCycle @default(Annual) @map("billing_cycle")

  /// Seats bought. Falls back to the plan's `seatLimit` when null, which is how
  /// a "Custom" Enterprise plan gets a real number.
  seatsLicensed Int? @map("seats_licensed")

  /// The current term. `renewsAt` is what the dashboard's renewal window reads.
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  renewsAt  DateTime? @map("renews_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  /// This period's AI allowance and what has been consumed of it, both in minor
  /// units. Consumption is written by the metering that arrives with the AI
  /// modules; until then it is demo data, and the API says which it is.
  aiAllowanceMinor Int    @default(0) @map("ai_allowance_minor")
  aiConsumedMinor  Int    @default(0) @map("ai_consumed_minor")
  currency         String @default("USD") @db.VarChar(3)

  /// Per-company entitlement overrides, layered over the plan's modules. The
  /// reference's Company Detail screen shows exactly this ("Master extras:
  /// Off"), so it is a column rather than a plan edit.
  extraModules   String[] @map("extra_modules")
  removedModules String[] @map("removed_modules")

  // ---- Prompt 11 ----

  /// A documented per-company override of the plan's seat-counting rule. Null means "use the
  /// plan's". Rare and deliberate: it exists because negotiated contracts exist.
  seatCountingOverride SeatCountingRule? @map("seat_counting_override")

  /// A per-company release channel override, for a design partner on an otherwise Stable plan.
  releaseChannelOverride ReleaseChannel? @map("release_channel_override")

  // ---- A future-effective plan change ----
  //
  // Held on the subscription rather than applied immediately, because the client asks for
  // "future-effective changes where applicable". A downgrade normally takes effect at renewal:
  // applying it the moment it is agreed would take away seats the customer has already paid
  // for through the end of the term.

  /// The plan this company moves to, and when. Both null when no change is pending.
  pendingPlanId      String?   @map("pending_plan_id") @db.Uuid
  pendingSeats       Int?      @map("pending_seats")
  pendingEffectiveAt DateTime? @map("pending_effective_at") @db.Timestamptz(6)
  pendingReason      String?   @map("pending_reason") @db.VarChar(500)

  /// While set, the **previous** (higher) ceiling is still enforced.
  ///
  /// This is what makes a downgrade non-destructive: the company keeps working at the old
  /// ceiling until the grace period ends, and the platform can see exactly how long it has to
  /// help them get under the new one.
  seatGraceUntil   DateTime? @map("seat_grace_until") @db.Timestamptz(6)
  seatGraceCeiling Int?      @map("seat_grace_ceiling")

  /// The reference's `flag` column: the one thing about this company that needs
  /// attention. Derived on read from billing, budget, seats, renewal and
  /// security signals — stored so the platform can also pin one by hand.
  pinnedFlag AttentionFlag @default(None) @map("pinned_flag")

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan   @relation(fields: [planId], references: [id])
  pendingPlan Plan?  @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  /// The dashboard's renewal window and billing-attention queries.
  @@index([billingState, renewsAt])
  @@index([state, renewsAt])
  @@map("tenant_subscriptions")
}

/// A feature flag and its staged rollout.
///
/// Platform-owned, and the only role that may change one is `PlatformOwner`:
/// a flag decides what the product is for every customer at once, which is a
/// different decision from administering one company (ADR-049).
model FeatureFlag {
  id String @id @default(uuid(7)) @db.Uuid

  key         String  @db.VarChar(80)
  description String? @db.VarChar(500)

  stage FeatureStage     @default(Dev)
  state FeatureFlagState @default(Paused)

  /// Who sees it: a plan tier, `Internal`, or a company allow-list. Free text
  /// matching the reference's `Audience` column, because the real targeting
  /// vocabulary belongs with the module that consumes flags.
  audience String @default("Internal") @db.VarChar(120)

  /// Staged percentage, 0–100. Constrained by a check constraint, because a
  /// rollout at 140% would be a silently broken gate rather than an error.
  rolloutPercent Int @default(0) @map("rollout_percent")

  /// Companies explicitly opted in regardless of stage or percentage, so a
  /// design-partner can be enabled without moving the whole rollout.
  enabledTenantIds String[] @map("enabled_tenant_ids")

  /// Why this flag exists and what removing it would mean. A flag with no
  /// stated purpose is the one nobody dares delete.
  rationale String? @db.VarChar(1000)

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  @@unique([key])
  @@index([state, stage])
  @@map("feature_flags")
}

/// Global platform configuration, one row per setting.
///
/// A key/value table rather than a single wide row, so adding a setting is an
/// insert rather than a migration — and so each setting carries its own
/// "who changed this, and when", which a wide row cannot.
model PlatformSetting {
  id String @id @default(uuid(7)) @db.Uuid

  /// Dotted key, e.g. `provisioning.default_plan_code`.
  key String @db.VarChar(120)

  /// The value, as JSON, so a setting can be a string, a number, a boolean or a
  /// list without a column per shape.
  value Json @db.JsonB

  /// What this controls, shown next to the field. A setting whose meaning is
  /// only in someone's head is a setting nobody changes.
  description String? @db.VarChar(500)

  /// Grouping for the Platform Settings screen, matching the reference's two
  /// cards: `Global defaults` and `Governance`.
  section String @default("Global defaults") @db.VarChar(60)

  /// A locked setting is shown and cannot be changed through the API. Used for
  /// the ones that are product rules rather than configuration — "no public
  /// company signup" is a locked client requirement, not a preference.
  locked Boolean @default(false)

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  @@unique([key])
  @@index([section])
  @@map("platform_settings")
}

/// A platform service alert — the dashboard's "service alerts" and the System
/// Health module's live state.
///
/// Written by health checks and by hand. Not an audit trail: an alert is
/// mutable state that gets acknowledged and resolved, which is why it is a
/// normal table and not append-only. What *happened* to an alert belongs in
/// the audit trail, and the service writes one on each transition.
model ServiceAlert {
  id String @id @default(uuid(7)) @db.Uuid

  /// The service this is about, e.g. `api-gateway`, `model-gateway`.
  service  String               @db.VarChar(80)
  severity ServiceAlertSeverity @default(Warning)
  state    ServiceAlertState    @default(Open)

  summary String  @db.VarChar(300)
  detail  String? @db.VarChar(1000)

  /// Set when one company is affected; null for a platform-wide alert. Not a
  /// foreign key on purpose: an alert about a company must survive that
  /// company being closed, which is when the alert history matters most.
  affectedTenantId String? @map("affected_tenant_id") @db.Uuid

  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  acknowledgedByUserId String? @map("acknowledged_by_user_id") @db.Uuid
  resolvedByUserId     String? @map("resolved_by_user_id") @db.Uuid

  // ---- Declared incident (Prompt 36) ----
  //
  // **Not every alert is an incident.** An alert is *raised*; an incident is *declared* — a human
  // judgement that this is serious enough to own, publish and post-mortem. So the incident fields
  // hang off the alert rather than living in a second table: one row, one state, and the Master
  // Console's alert count can never disagree with the System Health incident list.

  /// From `INCIDENT_SEVERITIES` — P0, P1, P2, exactly as §30 names them. **Null means this alert
  /// has not been declared an incident**, which is the ordinary case.
  ///
  /// Deliberately a separate column from `severity`. That one is the alert's own Info/Warning/
  /// Critical scale, and mapping Critical onto P0 would assert something nobody decided.
  incidentSeverity String? @map("incident_severity") @db.VarChar(10)

  declaredAt       DateTime? @map("declared_at") @db.Timestamptz(6)
  declaredByUserId String?   @map("declared_by_user_id") @db.Uuid

  /// §30 asks for an owner. An incident with none is an incident nobody is working on.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// What stopped the impact, recorded when the incident is mitigated.
  mitigation  String?   @map("mitigation") @db.VarChar(4000)
  mitigatedAt DateTime? @map("mitigated_at") @db.Timestamptz(6)

  /// **What customers are told**, written for them and separate from `summary` and `detail`,
  /// which are internal. Required before publishing, by check constraint — otherwise a status
  /// page would have to assemble customer wording out of an operator's internal note.
  customerVisible Boolean @default(false) @map("customer_visible")
  customerImpact  String? @map("customer_impact") @db.VarChar(2000)

  // ---- The incident workflow (Prompt 39) ----
  //
  // `INCIDENT_WORKFLOW_BOUNDARY` at Prompt 36 said the timeline, postmortem and corrective
  // actions belonged to this prompt and would extend this record rather than adding a second one.
  // This is that extension.

  /// **The postmortem.** Required before a P0 or P1 may be resolved — §30 lists it as part of the
  /// incident, and the whole value of a severity scale is that the serious ones are treated
  /// differently. A P2 may close on its mitigation note alone.
  postmortem           String?   @db.Text
  postmortemAt         DateTime? @map("postmortem_at") @db.Timestamptz(6)
  postmortemByUserId   String?   @map("postmortem_by_user_id") @db.Uuid

  /// Tickets that turned out to be about this incident.
  tickets SupportTicket[]

  timeline        IncidentTimelineEntry[]
  correctiveActions CorrectiveAction[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  /// The dashboard question: what is open, worst first.
  @@index([state, severity, openedAt(sort: Desc)])
  @@index([service, state])
  /// System Health asks two questions: what is declared and active, and what is published.
  @@index([incidentSeverity, state])
  @@index([customerVisible, state])
  @@map("service_alerts")
}

// ===========================================================================
// Prompt 10 — Company provisioning and initial admin activation
// ===========================================================================
//
// The no-public-signup tenant creation journey. Every enum value and field below comes from the
// approved wizard table in `UBoss_Final_1` §"Create Company" (steps 1–10) — the AI modes, the
// skill packs, the budget thresholds and the checklist are the client's own vocabulary, not a
// structure invented here.

enum BillingCycle {
  Monthly
  Quarterly
  Annual

  @@map("billing_cycle")
}

enum CompanyAiMode {
  /// UBoss supplies and pays for the models.
  UBossManaged
  /// The company brings its own provider keys. Credentials live in the Prompt 6 secret box,
  /// never in a normal field — see `TenantAiSettings`.
  CompanyByok
  /// A negotiated enterprise provider, typically self-hosted or private-endpoint.
  CustomEnterpriseProvider

  @@map("company_ai_mode")
}

enum OutboxState {
  Pending
  /// Claimed by a dispatcher. Distinct from Pending so a crashed dispatcher's work is visible
  /// rather than looking un-started.
  InFlight
  Delivered
  Failed
  /// Abandoned after the retry budget. Terminal, and deliberately not deleted.
  DeadLettered

  @@map("outbox_state")
}

enum SetupTaskState {
  NotStarted
  InProgress
  Done
  /// Deliberately skipped, with a reason. A checklist that cannot be skipped is a checklist
  /// people work around.
  Skipped

  @@map("setup_task_state")
}

/// Company-level AI governance, set at provisioning step 5 and 6.
///
/// Separate from `TenantSubscription` because AI *mode* is a governance decision and the
/// subscription is a commercial one: a company can change provider without changing plan, and
/// changing plan must not silently re-point its models.
model TenantAiSettings {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String        @unique @map("tenant_id") @db.Uuid
  mode     CompanyAiMode @default(UBossManaged)

  /// Approved logical model profiles and fallback order, e.g.
  /// `{ "profiles": ["reasoning-high","drafting-fast"], "fallback": ["primary","secondary"] }`.
  ///
  /// A **placeholder** by instruction: the prompt asks for "logical model-profile policy
  /// placeholders only where appropriate". Storing it as JSON rather than as tables is the
  /// honest shape for a policy whose real vocabulary arrives with the model gateway — a set of
  /// tables now would be guessing at a schema the AI module owns.
  modelProfilePolicy Json? @map("model_profile_policy") @db.JsonB

  /// **No credential ever lives here.** For `CompanyByok` the provider secret is held in the
  /// Prompt 6 `SecretBox` under its own purpose, and this column holds only the reference plus
  /// a masked hint for display. The client's locked rule is "no plaintext passwords or reusable
  /// provider credentials in normal UI/database fields", and a nullable `apiKey` column here is
  /// exactly the field that rule forbids.
  providerCredentialRef  String? @map("provider_credential_ref") @db.VarChar(120)
  providerCredentialHint String? @map("provider_credential_hint") @db.VarChar(40)
  /// Free text for a custom enterprise endpoint. Not a secret; a hostname is configuration.
  customProviderEndpoint String? @map("custom_provider_endpoint") @db.VarChar(300)

  // ---- Step 6: skill packs ----
  /// The universal core pack. On by default because it is what makes the product work at all.
  universalPackEnabled  Boolean  @default(true) @map("universal_pack_enabled")
  /// Industry packs by code, e.g. `healthcare`. The client's example is the Healthcare pack.
  industryPacks         String[] @map("industry_packs")
  /// Whether the company may author its own skills. A *capability flag*, not a catalogue.
  ///
  /// Explicitly **not** a Templates Library, which is out of scope for this baseline.
  customSkillCapability Boolean  @default(false) @map("custom_skill_capability")

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_settings")
}

/// Step 7 — the cost guardrails that must exist *before* any AI work starts.
///
/// Four thresholds, ordered, and the ordering is enforced by a check constraint: a warning above
/// the approval threshold, or an approval threshold above the hard stop, would make the middle
/// one unreachable and the guardrail decorative.
model TenantAiBudgetPolicy {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid

  /// All amounts in minor units of the company's currency. Integers, never floats.
  monthlyAllowanceMinor Int @map("monthly_allowance_minor")

  /// Notify at this percentage of the allowance. The client's "warning threshold".
  warningPercent Int @default(80) @map("warning_percent")

  /// Beyond this, a spend needs a human approval before it runs. The Executor Agent raises the
  /// exception; it may never approve it itself.
  approvalThresholdMinor Int @map("approval_threshold_minor")

  /// Beyond this, nothing runs. The client's "hard stop".
  hardStopMinor Int @map("hard_stop_minor")

  /// Optional initial per-department allocations: `{ "<departmentId>": <minor> }`.
  ///
  /// JSON rather than a table because departments do not exist until Prompt 12, and a foreign
  /// key to a table that has no rows yet would make step 7 impossible to complete at
  /// provisioning time — which is when the client requires it.
  departmentAllocations Json? @map("department_allocations") @db.JsonB

  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_budget_policies")
}

/// The transactional outbox.
///
/// ## Why an outbox rather than sending inline
///
/// Provisioning is one database transaction: the tenant, its subscription, its AI settings, its
/// budget policy, its security defaults, the first administrator's identity, the bootstrap role
/// grant and the activation invitation all commit together or not at all. Sending the activation
/// email inside that transaction would break it in one of two ways — an SMTP round-trip holding
/// a database transaction open, or a mail that goes out and then a rollback, leaving a customer
/// holding an activation link for a company that does not exist.
///
/// So the *intent to send* is written in the same transaction as everything else, and a
/// dispatcher delivers it afterwards. That is the standard outbox, and the property it buys is
/// exactly the one provisioning needs: no message is ever sent for work that rolled back, and no
/// committed work is ever left without its message.
///
/// **No dispatcher runs at Prompt 10.** Email delivery is the notifications module (Prompt 28).
/// Rows accumulate as `Pending` and the Master Console can see them, which is the honest state —
/// the alternative is pretending mail is being sent.
model OutboxMessage {
  id String @id @default(uuid(7)) @db.Uuid

  /// What kind of message, e.g. `company.activation_invitation`.
  topic String @db.VarChar(120)

  /// The company this concerns, when it concerns one. Nullable for platform-plane messages.
  tenantId String? @map("tenant_id") @db.Uuid

  /// Everything the dispatcher needs. **Never a token or a credential** — an activation payload
  /// carries the invitation's *id*, and the dispatcher reads the one-time token through the
  /// service that owns it. An outbox row is long-lived and widely readable; a token in one would
  /// be a credential at rest in a queue.
  payload Json @db.JsonB

  state OutboxState @default(Pending)

  /// Deduplication key, so a retried provisioning cannot enqueue two activation emails.
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)

  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(1000)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  @@unique([idempotencyKey])
  /// The dispatcher's query: what is due, oldest first.
  @@index([state, availableAt])
  @@index([tenantId, topic])
  @@map("outbox_messages")
}

/// One row per company setup checklist item.
///
/// The ten items and their order are the client's, from `UBoss_Final_1` §33 "Client Company Admin
/// — First Login & Setup Checklist". Rows are created by provisioning so the checklist exists
/// before the administrator has activated — which is the point: on first login they must not land
/// on an empty dashboard.
///
/// A table rather than a derived view, because the client's list mixes things the system can
/// detect (a hierarchy exists) with things only a person can assert ("run readiness review and
/// mark workspace ready"). A derived checklist cannot represent the second kind, and a checklist
/// that silently ticks itself is one nobody trusts.
model CompanySetupTask {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Stable machine key, e.g. `company_profile`. Referenced by the screens that complete a task.
  key      String @db.VarChar(60)
  /// 1–10, the client's order.
  position Int

  title     String @db.VarChar(200)
  /// The client's "why it comes here" column. Shown, because a checklist without reasons is a
  /// list of chores.
  rationale String @db.VarChar(500)

  /// Where completing this task happens, e.g. `/hierarchy`. Null for the final review item,
  /// which is asserted rather than navigated to.
  targetRoute String? @map("target_route") @db.VarChar(120)

  state SetupTaskState @default(NotStarted)

  /// Set when a task is skipped. Required by a check constraint, because "skipped" with no
  /// reason is indistinguishable from "forgotten".
  skipReason String? @map("skip_reason") @db.VarChar(500)

  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, position])
  @@map("company_setup_tasks")
}

// ===========================================================================
// Prompt 11 — plans, entitlements, seats and company lifecycle
// ===========================================================================
//
// ## The five concepts this prompt keeps provably separate
//
// The client is explicit that these must not be confused, and the separation is structural
// rather than a naming convention:
//
//   1. **Commercial Plan** — `plans` + `tenant_subscriptions.planId`. What was bought.
//   2. **Module Entitlements** — `plans.entitledModules` + the subscription's extra/removed
//      lists. Which modules the company *has*.
//   3. **Feature / Release Channel** — `feature_flags` (Prompt 9) + `tenant_subscriptions
//      .releaseChannel` below. Which *version* of a module the company sees.
//   4. **Commercial Allowance** — `tenant_subscriptions.aiAllowanceMinor` and the Prompt 10
//      budget policy. How much AI spend was bought.
//   5. **RBAC** — `role_assignments`, `custom_roles`, `policy_rules` (Prompt 7). Who inside the
//      company may do what.
//
// Nothing below touches (5), and nothing in (5) reads (1)–(4). A module a company is not
// entitled to is invisible to everyone; a module it *is* entitled to is still governed entirely
// by role, scope and allowed actions. Conflating them is the classic SaaS bug where buying a
// bigger plan silently grants somebody administrative rights.

enum ReleaseChannel {
  /// Only what has shipped to everybody. The default, and what most customers want.
  Stable
  /// Opts in to staged features ahead of general availability.
  Early
  /// Internal use only; never assigned to a customer by the plan.
  Internal

  @@map("release_channel")
}

enum SeatCountingRule {
  /// A seat is consumed once somebody can actually sign in. Invitations are free.
  ///
  /// Generous, and the risk is real: a company can invite a thousand people on a ten-seat plan
  /// and only discover the ceiling as they activate, one refusal at a time.
  ActiveOnly
  /// A seat is consumed from the moment an invitation is issued. The safer default.
  ///
  /// An outstanding invitation is a committed seat, so the ceiling is hit at invitation time —
  /// where an administrator can still do something about it — rather than at activation time,
  /// where the person being refused has already been told they have an account.
  ActiveAndInvited
  /// Also counts suspended accounts.
  ///
  /// For contracts priced per *provisioned* person rather than per concurrent user. Suspending
  /// somebody then does not free a seat, which is the point: it prevents seat churn being used
  /// to run a 50-person company on 10 seats.
  ActiveInvitedAndSuspended

  @@map("seat_counting_rule")
}

enum CommercialChangeKind {
  MoreSeats
  FewerSeats
  PlanUpgrade
  PlanDowngrade
  MoreAiAllowance
  /// A module the company wants that its plan does not include.
  ModuleEntitlement

  @@map("commercial_change_kind")
}

enum CommercialChangeState {
  /// Raised by the company. Grants nothing.
  Requested
  /// The platform accepted it. The change may be immediate or future-effective.
  Approved
  Declined
  /// Approved and applied.
  Applied
  /// Withdrawn by the company before a decision.
  Withdrawn

  @@map("commercial_change_state")
}

/// A company's request for a commercial change.
///
/// ## Why a request rather than a self-service control
///
/// The client's rule: *Company Admin may view permitted plan/seat position and may request
/// allowed commercial changes; Platform Admin controls contracted ceiling/entitlements.* A
/// company changing its own contracted ceiling would make the ceiling meaningless — it is a
/// contractual number, not a preference — so the company asks and the platform decides.
///
/// This is also what makes "at the ceiling, block **or** Request/Buy More Seats according to
/// policy" implementable: the second half of that instruction needs somewhere for the request to
/// go.
model CommercialChangeRequest {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String                @map("tenant_id") @db.Uuid
  kind     CommercialChangeKind
  state    CommercialChangeState @default(Requested)

  /// What is being asked for. Interpreted against `kind`: a seat count, a plan code, an
  /// allowance in minor units, or a module key.
  requestedSeats          Int?     @map("requested_seats")
  requestedPlanCode       String?  @map("requested_plan_code") @db.VarChar(40)
  requestedAllowanceMinor Int?     @map("requested_allowance_minor")
  requestedModules        String[] @map("requested_modules")

  /// Why the company needs it. Required — a commercial request with no business reason is one
  /// the platform cannot evaluate, and it is the record both sides refer back to.
  justification String @db.VarChar(1000)

  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?   @map("decision_note") @db.VarChar(1000)

  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The company's own view: what have we asked for, newest first.
  @@index([tenantId, state, requestedAt(sort: Desc)])
  /// The platform's queue: what is waiting for a decision.
  @@index([state, requestedAt])
  @@map("commercial_change_requests")
}

/// A record of every company lifecycle transition.
///
/// ## Why a table when the audit trail exists
///
/// The audit trail records that a transition *happened*. This answers a different question the
/// client's lifecycle requirement needs: **what was the company's state on a given date, and for
/// how long**. That is a query over intervals, and reconstructing it by replaying an append-only
/// trail is both slow and fragile — a single missed event silently shifts every subsequent
/// interval.
///
/// It also carries the one thing a trail cannot: a transition scheduled for the *future*, which
/// is how a downgrade at renewal or a suspension at the end of a grace period is represented
/// before it happens.
model TenantLifecycleTransition {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  fromState TenantLifecycleState @map("from_state")
  toState   TenantLifecycleState @map("to_state")

  /// Why. Mandatory in substance — a suspension with no recorded reason is the one a customer
  /// disputes and nobody can explain.
  reason String @db.VarChar(1000)

  /// Null when the transition was applied immediately; set for a scheduled one.
  effectiveAt DateTime  @default(now()) @map("effective_at") @db.Timestamptz(6)
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz(6)

  /// Null for a transition the system made (a grace period elapsing), set for a human decision.
  actorUserId String? @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// "What state was this company in, when" — the interval query.
  @@index([tenantId, effectiveAt(sort: Desc)])
  /// The scheduler's query: what is due and not yet applied.
  @@index([appliedAt, effectiveAt])
  @@map("tenant_lifecycle_transitions")
}

// ---------------------------------------------------------------------------
// Prompt 12 — hierarchy, departments and reporting relationships
// ---------------------------------------------------------------------------

/// What kind of identifier a `PersonIdentifier` row holds.
///
/// An enum rather than free text because the *handling rules differ per kind* and the code
/// switches on them: an Aadhaar number is entered-only and never verified, while a work email
/// can be proved by a domain claim. A typo'd kind would silently pick the wrong rules.
enum PersonIdentifierKind {
  /// Indian Aadhaar number. **Entered-only in this client flow.** See `PersonIdentifier`.
  AadhaarEnteredOnly
  /// Official work email, used as a secondary match signal.
  WorkEmail
  /// A government or employer identifier a later prompt may add. Reserved so the enum does not
  /// have to change shape when it arrives.
  Other

  @@map("person_identifier_kind")
}

/// How much UBoss actually knows about an identifier.
///
/// There are only two values, and that is the point: nothing in this baseline can produce
/// `Verified`, so the state cannot be claimed by accident. Adding verification means adding a
/// value *and* the flow that earns it.
enum IdentifierAssurance {
  /// Somebody typed it in. UBoss has not checked it against any authority, and does not claim to.
  EnteredOnly
  /// Explicitly recorded as not verified. Distinct from `EnteredOnly` only in intent: it marks a
  /// value that was *considered* for verification and is not verified.
  NotVerified

  @@map("identifier_assurance")
}

/// Whether an employment record is current.
enum EmploymentState {
  /// Currently employed by this company.
  Active
  /// No longer employed. The record is **kept** — employment history is not deleted, which is
  /// the same rule that governs seat reduction (ADR-061).
  Ended

  @@map("employment_state")
}

/// A department inside one company.
///
/// ## Why departments are a tree of their own
///
/// A department hierarchy and a reporting hierarchy are different structures that people
/// routinely conflate. "Regulatory Affairs sits under Quality" is an organisational fact;
/// "Kavya reports to Priya" is a personal one, and the two do not have to agree — a person can
/// report to somebody in another department, which happens constantly with matrix teams and
/// dotted lines. Keeping them separate is the client's requirement ("reporting manager
/// relationship separate from department membership") and it is also the only way to represent
/// a real organisation.
///
/// ## The referential check the authorization engine has been waiting for
///
/// `RoleAssignment.departmentIds` and `PolicyRule.subjectIds` have carried department identifiers
/// as opaque strings since Prompt 7, with a comment saying a foreign key could not be added yet.
/// It still cannot: PostgreSQL has no foreign key on the *elements* of an array column, and
/// changing the column to a join table would rewrite the authorization engine's storage.
///
/// What Prompt 12 adds instead is a **trigger** that rejects a `Department`-scoped assignment
/// naming a department that does not exist in that company, which delivers the same guarantee
/// through the mechanism the column shape allows. A dangling department id would silently widen
/// or narrow somebody's scope with nothing to look at.
model Department {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Display name, e.g. "Regulatory Affairs".
  name String @db.VarChar(160)

  /// Company-facing short code, e.g. `REG`. Optional: not every company uses them.
  code String? @db.VarChar(20)

  /// Parent department, for a department tree. Null for a top-level department.
  parentDepartmentId String? @map("parent_department_id") @db.Uuid

  /// The person who heads this department, when one is named.
  ///
  /// Separate from the reporting tree: heading a department is a role, and the head's own
  /// reporting manager may sit somewhere else entirely.
  headUserId String? @map("head_user_id") @db.Uuid

  /// One-line purpose, shown on the department node.
  description String? @db.VarChar(500)

  /// Ordering hint for the tree, so a company can put Executive before Production.
  sortOrder Int @default(100) @map("sort_order")

  /// Archived rather than deleted. A department with employment history cannot be removed
  /// without rewriting that history, so it is closed instead.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// **A composite relation, on purpose** (ADR-064). Referencing `(tenant_id, id)` rather than
  /// `id` alone means PostgreSQL refuses a parent department belonging to another company — the
  /// single-column version proves only that the parent *exists*, not whose it is.
  ///
  /// Declared here rather than hand-written in SQL so Prisma owns the constraint. A constraint
  /// Prisma cannot see is drift, and the next generated migration drops it.

  /// `onDelete: NoAction`, not `SetNull`, and that is a correctness fix rather than a preference.
  /// A composite foreign key's `SET NULL` nulls **every** referencing column — including
  /// `tenant_id`, which is NOT NULL — so the delete would fail with a confusing error instead of
  /// detaching the row. Prompt 12's hand-written SQL had this latent bug and it never fired only
  /// because nothing deletes these rows: a department is archived and an employment record is
  /// ended, both of which keep the row. Refusing a delete is therefore the honest action.
  parent   Department?  @relation("DepartmentParent", fields: [tenantId, parentDepartmentId], references: [tenantId, id], onDelete: NoAction)
  children Department[] @relation("DepartmentParent")
  head     User?        @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)

  employmentRecords EmploymentRecord[]

  /// Objectives filed under this department, and the Form 2 versions naming it.
  objectives        Objective[]
  objectiveVersions ObjectiveVersion[]

  /// A department name is unique within a company, so two "Quality Assurance" departments
  /// cannot exist and make every scope decision ambiguous.
  @@unique([tenantId, name])
  /// Exists **only** so a composite foreign key can reference the pair. `id` alone is already
  /// unique; this adds nothing to uniqueness and everything to same-tenant referential integrity.
  @@unique([tenantId, id])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, archivedAt])
  @@map("departments")
}

/// One person's employment inside one company.
///
/// ## The record that makes a hierarchy possible before anybody logs in
///
/// The client's requirement is a "stable internal user identity before invitation". That already
/// exists: a `User` row plus a `TenantMembership` in `NotInvited` is a person the company knows
/// about who cannot sign in. What was missing is the *employment* facts — Employee ID,
/// designation, department, reporting manager — which is this table. An organisation chart can
/// therefore be built completely before a single invitation is sent, which is how companies
/// actually onboard.
///
/// ## Company Employee ID stays tenant-specific
///
/// `employeeId` is unique **within a company** and means nothing outside it. The identifier that
/// crosses companies is `User.ubossUniqueId`, and the two are deliberately different things: a
/// person joining a second UBoss company keeps their UBoss Unique ID and gets a new Employee ID.
///
/// ## Nothing here is ever deleted
///
/// Offboarding sets `state = Ended` and `endedAt`. The record stays, because employment history
/// is exactly the thing a person needs later — and the client's non-destructive rule applies to
/// it explicitly.
model EmploymentRecord {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The person. This is the global person — see the note on `User`.
  userId String @map("user_id") @db.Uuid

  /// The company's own employee identifier, e.g. `E-1130`. Mandatory: it is one of the six
  /// required Add Employee fields.
  employeeId String @map("employee_id") @db.VarChar(40)

  /// Job title, e.g. "Regulatory Associate". Mandatory field 3.
  designation String @db.VarChar(160)

  /// Mandatory field 4. A department that must exist, now that departments do.
  departmentId String @map("department_id") @db.Uuid

  /// Mandatory field 5 — **the reporting relationship**, and deliberately a separate column
  /// from `departmentId`. Null only for the top of the tree, which every company has exactly
  /// one or a few of.
  ///
  /// Cycles are prevented by a database trigger using a recursive walk, not only by the
  /// service: a cycle would make the subtree query non-terminating, and that is the sort of
  /// invariant that must not depend on which code path wrote the row.
  reportingManagerUserId String? @map("reporting_manager_user_id") @db.Uuid

  state EmploymentState @default(Active)

  /// Optional employment details. Optional in the schema **and** unmarked in the UI: the client
  /// is explicit that only the six required fields carry an asterisk.
  joinedOn       DateTime? @map("joined_on") @db.Date
  employmentType String?   @map("employment_type") @db.VarChar(60)
  workEmail      String?   @map("work_email") @db.VarChar(320)
  workPhone      String?   @map("work_phone") @db.VarChar(40)

  /// Set when employment ends. The row is kept — see the model comment.
  endedAt DateTime? @map("ended_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("EmploymentSubject", fields: [userId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): the department must be in the same company.
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)

  /// **The reporting manager, as a self-relation on `(tenant_id, user_id)`.**
  ///
  /// This is the constraint most worth having in the database. A single-column foreign key to
  /// `users` would permit a manager from *another company*, which would be a tenant-isolation
  /// breach reachable through the org chart — and every `TeamSubtree` authorization decision
  /// downstream would silently span the boundary. Referencing this table's own
  /// `(tenant_id, user_id)` means the manager must be **employed here**, which is both checks in
  /// one.
  reportingManager EmploymentRecord?  @relation("EmploymentReportingManager", fields: [tenantId, reportingManagerUserId], references: [tenantId, userId], onDelete: NoAction)
  directReports    EmploymentRecord[] @relation("EmploymentReportingManager")

  /// One employment record per person per company.
  @@unique([tenantId, userId])
  /// The Employee ID is unique inside the company and nowhere else.
  @@unique([tenantId, employeeId])
  /// The subtree walk and the department roll-up.
  @@index([tenantId, reportingManagerUserId])
  @@index([tenantId, departmentId])
  @@map("employment_records")
}

/// An identifier used to recognise a person across companies.
///
/// ## Aadhaar is a match input and nothing else
///
/// The client's rule, in their words: Aadhaar is entered for internal person matching only in
/// this flow. So this table stores **no Aadhaar number**. It stores:
///
///   * `matchHash` — a keyed HMAC-SHA-256 of the normalised value. Keyed, not a plain hash: a
///     bare SHA-256 of a 12-digit number is trivially reversible by enumerating all 10^12
///     candidates, which is minutes of GPU time. With a server-side key that is not possible
///     without the key.
///   * `lastFour` — the only part ever displayed, and the reference UI shows exactly
///     `XXXX XXXX 5510`.
///
/// The full value is **not stored at all**, encrypted or otherwise. It is never needed again:
/// matching uses the hash and display uses the last four, so keeping it would be holding a
/// national identity number for no purpose. That is a stronger position than encrypting it, and
/// it is recorded as a decision (ADR-063) rather than left as an omission.
///
/// `assurance` can only be `EnteredOnly` or `NotVerified`. There is no `Verified` value, so no
/// screen and no API can claim verified Aadhaar status — the guarantee is structural.
///
/// **Aadhaar is never the UBoss Unique ID**, and cross-company profile search never keys on it.
/// `User.ubossUniqueId` is the search key.
model PersonIdentifier {
  id String @id @default(uuid(7)) @db.Uuid

  /// Platform-plane: an identifier belongs to a person, not to a company. That is what makes
  /// match-or-create work across employers, and it is why this table has no `tenant_id`.
  userId String @map("user_id") @db.Uuid

  kind PersonIdentifierKind

  /// Keyed HMAC-SHA-256, hex. The matching key. See the model comment.
  matchHash String @map("match_hash") @db.VarChar(64)

  /// Which key produced `matchHash`, so the key can be rotated without losing the ability to
  /// tell a stale hash from a current one.
  matchKeyId String @map("match_key_id") @db.VarChar(40)

  /// The only fragment ever shown. Four characters, because that is what the reference displays.
  lastFour String? @map("last_four") @db.VarChar(4)

  /// Always `EnteredOnly` or `NotVerified`. There is no verified state — see the model comment.
  assurance IdentifierAssurance @default(EnteredOnly)

  /// The company whose administrator entered it, for accountability. A reference, not ownership:
  /// the identifier belongs to the person.
  enteredByTenantId String? @map("entered_by_tenant_id") @db.Uuid
  enteredByUserId   String? @map("entered_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The match lookup: "is there already a person with this identifier?" Unique on the hash per
  /// kind, so one Aadhaar cannot resolve to two people — which is the whole purpose.
  @@unique([kind, matchHash])
  @@index([userId, kind])
  @@map("person_identifiers")
}

// ---------------------------------------------------------------------------
// Prompt 13 — Users & Access, guests and bulk enterprise lifecycle
// ---------------------------------------------------------------------------

/// What a bulk operation does. Each kind has its own validator and applier.
enum BulkOperationKind {
  /// CSV/XLS import of employees, with preview and per-row errors.
  ImportEmployees
  /// Invite, or resend to, many people at once.
  InviteOrResend
  /// Change role and scope for many people.
  RoleAndScope
  /// Move many people to a new manager or department.
  ManagerOrDepartment
  /// Suspend or offboard many people.
  SuspendOrOffboard

  @@map("bulk_operation_kind")
}

/// The state machine every bulk operation runs through.
///
/// `Validated` is a first-class state, not an implementation detail: the client asks for
/// "preview/validation and per-row errors", which means validating **without applying** has to
/// be a thing the system can be in the middle of and report on.
enum BulkOperationState {
  /// Rows parsed and being checked. Nothing has been applied.
  Validating
  /// Every row checked. Valid and invalid rows both recorded; **nothing applied yet**.
  Validated
  /// Being applied, row by row.
  Applying
  /// Finished. Some rows may have been skipped or failed — see the row states.
  Applied
  /// Abandoned before applying, or applied and then abandoned. Rows keep their outcomes.
  Cancelled

  @@map("bulk_operation_state")
}

/// One row's outcome. Per-row rather than per-file, because a 400-row import with three bad
/// rows must apply the 397 and report the three — the client asks for exactly that.
enum BulkRowState {
  /// Parsed and valid. Will be applied.
  Valid
  /// Rejected by validation. Carries its errors; will never be applied.
  Invalid
  /// Applied successfully.
  Applied
  /// Valid, but deliberately not applied — the operation was cancelled, or the row was a no-op.
  Skipped
  /// Attempted and failed at apply time. Distinct from `Invalid`: validation passed and the
  /// write did not, which is a different problem with a different fix.
  Failed

  @@map("bulk_row_state")
}

enum OffboardingState {
  /// Recorded, with a successor named where anything needs moving.
  Requested
  /// Everything transferable has been moved and access is revoked.
  Completed
  /// Abandoned before completion. The person's access is unchanged.
  Cancelled

  @@map("offboarding_state")
}

/// One bulk administration run: an import, a bulk invite, a bulk role change, a bulk move.
///
/// ## Why this is a table rather than a request/response
///
/// The client asks for **preview** — validate, show what would happen, then apply. That is two
/// round trips with state in between, and putting that state in a table rather than in memory
/// means a 400-row import survives a page reload, and the per-row errors are still there
/// tomorrow when somebody asks why three people were not imported.
///
/// ## Every row is auditable, and the operation is too
///
/// A bulk change is the easiest way to make a large mistake, so the record of what was attempted
/// is as important as the record of what succeeded. Rows keep their outcomes forever; nothing is
/// deleted when an operation is cancelled.
model BulkOperation {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  kind  BulkOperationKind
  state BulkOperationState @default(Validating)

  /// Who asked for it. Every row is applied **as this person**, so their permissions are what
  /// the operation can do — a bulk operation is not a privilege escalation path.
  requestedByUserId String @map("requested_by_user_id") @db.Uuid

  /// The uploaded file's name, for the audit trail. The file itself is not stored: the parsed
  /// rows are, which is what anybody actually needs later.
  sourceFileName String? @map("source_file_name") @db.VarChar(260)

  /// Row counts, maintained as rows are validated and applied. Stored rather than counted on
  /// read so a summary screen does not aggregate ten thousand rows to show four numbers.
  totalRows   Int @default(0) @map("total_rows")
  validRows   Int @default(0) @map("valid_rows")
  invalidRows Int @default(0) @map("invalid_rows")
  appliedRows Int @default(0) @map("applied_rows")
  failedRows  Int @default(0) @map("failed_rows")

  /// Parameters that apply to every row — the target role for a bulk role change, the target
  /// department for a move. Validated against the operation's kind.
  parameters Json @default("{}")

  /// Why. Required for anything destructive; a bulk suspension nobody can explain is the one
  /// that gets disputed.
  reason String? @db.VarChar(1000)

  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   BulkOperationRow[]

  /// Exists only so the row table's composite foreign key can reference the pair.
  @@unique([tenantId, id])
  @@index([tenantId, state, createdAt(sort: Desc)])
  @@map("bulk_operations")
}

/// One row of a bulk operation, with its own outcome and its own errors.
model BulkOperationRow {
  id String @id @default(uuid(7)) @db.Uuid

  bulkOperationId String @map("bulk_operation_id") @db.Uuid

  /// Denormalised so a row can be read under Row-Level Security without joining its parent.
  /// Kept honest by a composite foreign key: the row's tenant and its operation's must agree.
  tenantId String @map("tenant_id") @db.Uuid

  /// 1-based, as the person who made the spreadsheet counts. Off-by-one in an error message
  /// pointing at the wrong line is worse than no line number.
  rowNumber Int @map("row_number")

  state BulkRowState @default(Valid)

  /// The row exactly as supplied, so "what did I upload" is answerable. Never contains an
  /// Aadhaar number: the parser normalises and discards it the same way Add Employee does.
  input Json

  /// Every problem with this row, not just the first — somebody fixing a spreadsheet wants all
  /// of them in one pass.
  errors String[]

  /// The person this row created or affected, once known.
  subjectUserId String? @map("subject_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Composite (ADR-064): a row belongs to an operation **in its own tenant**. The row carries
  /// its own `tenant_id` so it can be read under Row-Level Security without joining its parent,
  /// and this is what keeps the two from disagreeing.
  operation BulkOperation @relation(fields: [tenantId, bulkOperationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([bulkOperationId, rowNumber])
  @@index([tenantId, state])
  @@map("bulk_operation_rows")
}

/// Offboarding one person, and the handover it requires.
///
/// ## Why a record rather than just a state change
///
/// Setting `accountState = Offboarded` answers "can they sign in". It does not answer the
/// question that matters six months later: **who took over their work**. The client asks for
/// "transfer open work/Agent ownership/connections", and a transfer with no record of where
/// things went is indistinguishable from things being lost.
///
/// ## Nothing is deleted
///
/// Offboarding preserves the employment record, the audit history and every task the person
/// ever touched. `EmploymentRecord.state` becomes `Ended` with a date; the row stays. The same
/// non-destructive rule as seat reduction (ADR-061) and department archival.
model Offboarding {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  subjectUserId String @map("subject_user_id") @db.Uuid

  /// Who takes over. Required when there is anything to transfer — see `handover`.
  successorUserId String? @map("successor_user_id") @db.Uuid

  state OffboardingState @default(Requested)

  /// Why. Mandatory: this removes somebody's access to their employer's systems.
  reason String @db.VarChar(1000)

  /// What was moved, and what could not be. A structured record rather than prose, so a later
  /// prompt that adds a transferable domain can add to it without changing the shape:
  /// `{ "roleAssignments": { "revoked": 2 }, "openWork": { "reason": "not-implemented" } }`.
  handover Json @default("{}")

  /// The last day of access, when the offboarding is scheduled rather than immediate.
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)

  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([tenantId, subjectUserId])
  @@map("offboardings")
}

// ---------------------------------------------------------------------------
// Prompt 14 — company settings
// ---------------------------------------------------------------------------

/// One company's value for one setting.
///
/// ## Effective inheritance, in three layers
///
/// A setting's effective value is the first of:
///
///   1. this company's row, if one exists;
///   2. a **platform default** in `platform_settings` under the same key, if one exists;
///   3. the **code default** in `SETTING_DEFINITIONS`.
///
/// Layer 3 is what makes the store safe: a company with no rows at all is fully configured, and
/// a new setting works on the day it ships without a migration to backfill it. Layer 2 is what
/// lets the platform set a floor — the Prompt 9 `platform_settings` table already exists and
/// already has locked rows, so this reuses it rather than inventing a second default mechanism.
///
/// ## Why the value is JSON and the type is not
///
/// The column holds a JSON scalar so one table serves booleans, integers, strings and enums. The
/// **type** lives in the catalogue in code, and `validateSetting` is the only way a value gets
/// in — so an integer setting cannot come to hold a string, even though the column would let it.
/// A key that is not in the catalogue is refused outright, which is what stops a typo becoming a
/// setting that silently does nothing.
model CompanySetting {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The catalogue key, e.g. `notifications.approval_reminder_hours`. Refused if unknown.
  key String @db.VarChar(120)

  /// A JSON scalar. Validated against the catalogue's declared type before it is written.
  value Json

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One value per setting per company.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("company_settings")
}

/// The change history for a **material** setting.
///
/// ## Why only material settings
///
/// The client asks for "version/change history where material". A branding colour changing twenty
/// times is noise that buries the one entry somebody needs; an escalation window or an Employee
/// ID uniqueness rule changing once is exactly what an auditor reconstructs a decision from. The
/// catalogue marks which is which, so the history stays readable.
///
/// The audit trail records *that* every setting changed, material or not. This answers the
/// different question: **what was the value before**, which a chained append-only log can only
/// answer by replaying every event for that key.
model CompanySettingChange {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  key      String @db.VarChar(120)

  /// Null for the first change: there was no company value, only the inherited default.
  previousValue Json?
  newValue      Json

  /// Why. Required for a material change — a governance setting that changed for no recorded
  /// reason is the one nobody can account for at a review.
  reason String @db.VarChar(1000)

  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, key, changedAt(sort: Desc)])
  @@map("company_setting_changes")
}

// ---------------------------------------------------------------------------
// Prompt 12B — performance score and badge engine
// ---------------------------------------------------------------------------

/// What happened, from the performance engine's point of view.
///
/// A closed set, because each kind carries a fixed sign and the policy weights it. A free-text
/// kind would let a caller invent an event nothing scores.
enum PerformanceEventKind {
  /// Work completed by its required time **and** accepted. The positive case.
  OnTimeAccepted
  /// Completed after its required time.
  LateCompletion
  /// Never completed.
  Missed
  /// Completed on time but rejected on review. On-time delivery of unacceptable work is not a
  /// positive outcome, and treating it as one is how a score stops meaning anything.
  QualityRejected
  /// An approved blocker or exception that neutralises an earlier negative event.
  BlockerNeutralised
  /// A deliberate adjustment by an authorised person, always with a reason.
  ManualAdjustment

  @@map("performance_event_kind")
}

/// The badge ladder, matching the approved UI reference's `BADGE_LADDER`.
enum BadgeLevel {
  Bronze
  Silver
  Gold
  Platinum
  Diamond

  @@map("badge_level")
}

/// A company's performance policy, versioned.
///
/// ## Why versioned rather than editable
///
/// A score is only meaningful next to the rules that produced it. Editing thresholds in place
/// would silently restate every past score — somebody who earned Gold under one policy would
/// appear to have earned it under another. A change creates a **new version**, past events keep
/// the version they were scored under, and "why was this person Gold in March" stays answerable.
///
/// One active version at a time, enforced by a partial unique index.
model PerformancePolicy {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  version  Int

  /// Points per event kind. Positive for good outcomes, negative for bad ones.
  onTimeAcceptedPoints  Int @default(10) @map("on_time_accepted_points")
  lateCompletionPoints  Int @default(-5) @map("late_completion_points")
  missedPoints          Int @default(-15) @map("missed_points")
  qualityRejectedPoints Int @default(-10) @map("quality_rejected_points")

  /// Configurable thresholds, as the client requires. A score at or above each earns that level.
  bronzeThreshold   Int @default(0) @map("bronze_threshold")
  silverThreshold   Int @default(100) @map("silver_threshold")
  goldThreshold     Int @default(300) @map("gold_threshold")
  platinumThreshold Int @default(600) @map("platinum_threshold")
  diamondThreshold  Int @default(1000) @map("diamond_threshold")

  /// Whether an approved blocker fully cancels the negative event it neutralises.
  blockersNeutraliseFully Boolean @default(true) @map("blockers_neutralise_fully")

  /// **Whether an approved reward's points may reach the performance score.**
  ///
  /// The client's rule is that approved points and achievements link to performance *only
  /// through policy*. `false` by default, and deliberately so: a company that has not decided
  /// this has not agreed that a bonus can move somebody's score, and the safe reading of an
  /// unanswered question is no. An approved points award with this off finishes as `Recorded`
  /// with a note saying policy refused — which is an ending, not a failure.
  rewardPointsReachPerformance Boolean @default(false) @map("reward_points_reach_performance")

  /// Null while active; set when a newer version supersedes it.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  reason          String  @db.VarChar(500)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events PerformanceEvent[]

  @@unique([tenantId, version])
  @@index([tenantId, supersededAt])
  @@map("performance_policies")
}

/// One scored thing that happened. **Append-only, and the score is derived from it.**
///
/// ## Why a ledger rather than a running total
///
/// A stored total nobody can reconstruct is a number people argue about. Every score in UBoss is
/// the sum of its events, so "why is my score 240" is answerable line by line — and a policy
/// change re-derives cleanly instead of needing a migration to fix up totals.
///
/// ## Idempotency
///
/// `sourceKind` + `sourceId` + `kind` is unique per person, so the same completion reported twice
/// scores once. That matters more here than in most places: the callers will be a task-completion
/// handler and a scheduler, both of which retry.
model PerformanceEvent {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  subjectUserId String @map("subject_user_id") @db.Uuid

  kind PerformanceEventKind

  /// What produced this event: `todo`, `objective`, `agent_run`, `manual`. Opaque on purpose —
  /// the modules that own those arrive later, and this engine must not wait for them.
  sourceKind String @map("source_kind") @db.VarChar(40)
  /// The producing record's id, opaque for the same reason.
  sourceId   String @map("source_id") @db.VarChar(120)

  /// The employment record this counted against, so a score stays company-specific.
  employmentRecordId String? @map("employment_record_id") @db.Uuid

  /// Points as scored **at the time**, under `policyVersion`. Kept rather than recomputed, so a
  /// later policy change does not rewrite history.
  points        Int
  policyId      String @map("policy_id") @db.Uuid
  policyVersion Int    @map("policy_version")

  /// Which earlier event this neutralises. Set only for `BlockerNeutralised`.
  neutralisesEventId String? @map("neutralises_event_id") @db.Uuid

  /// Required for a manual adjustment and for a neutralisation.
  reason String? @db.VarChar(1000)

  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy PerformancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  /// The idempotency key. One event per source per kind per person.
  @@unique([tenantId, subjectUserId, sourceKind, sourceId, kind])
  @@index([tenantId, subjectUserId, occurredAt(sort: Desc)])
  @@map("performance_events")
}

/// Every badge level a person has held in a company, and when.
///
/// A history rather than a current-level column: "they were Gold last quarter" is what a
/// performance review asks, and a column overwritten on each change cannot answer it. The
/// current level is the row with no `endedAt`.
model BadgeHistory {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  subjectUserId String @map("subject_user_id") @db.Uuid

  level         BadgeLevel
  /// The score that earned it, so a transition is explicable without re-deriving.
  scoreAtChange Int        @map("score_at_change")

  /// Null for the level they hold now.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)

  /// Set on the final snapshot written when employment ends.
  isExitSnapshot Boolean @default(false) @map("is_exit_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectUserId, startedAt(sort: Desc)])
  @@map("badge_history")
}

// ---------------------------------------------------------------------------
// Prompt 15 — Notification and Escalation Center
// ---------------------------------------------------------------------------

/// Where a notification came from.
///
/// The client's initial six sources, and a closed set so a dispatcher can switch exhaustively and
/// a per-kind preference row can never name a kind nothing produces.
enum NotificationKind {
  /// An invitation was sent, resent, accepted or has expired.
  Invitation
  /// Something is waiting on this person's approval.
  ApprovalWaiting
  /// Work assigned to this person has passed its required time.
  Overdue
  /// A connection's credential is expiring or has expired.
  ConnectionExpiry
  /// AI spend has crossed a configured threshold.
  BudgetThreshold
  /// A security event concerning this person or this company. **Never mutable.**
  SecurityEvent

  @@map("notification_kind")
}

enum NotificationSeverity {
  Info
  Warning
  /// Must be acknowledged, and can never be muted by a preference.
  Critical

  @@map("notification_severity")
}

/// How often a person wants the non-urgent ones batched into an email.
enum NotificationDigest {
  /// Every notification is emailed as it happens, subject to the per-kind preference.
  Off
  Daily
  Weekly

  @@map("notification_digest")
}

/// One notification, for one person, in one company.
///
/// ## Why a row per recipient rather than a row per event with a join table
///
/// Read state, acknowledgement and escalation are all **per person**. Six approvers waiting on the
/// same objective have six different answers to "have you seen this", and a shared event row would
/// need a per-recipient side table carrying every one of those columns — which is this table with
/// an extra join. The cost is duplication of the title and body; the benefit is that the one query
/// the Notification Center runs ("what is unread for me") touches one table.
///
/// ## Deduplication is a constraint, not a convention
///
/// `UNIQUE (tenant, recipient, dedupe_key)`. The client requires duplicate suppression, and the
/// callers are retrying schedulers and event handlers — so a duplicate has to be impossible rather
/// than merely unlikely.
///
/// **The dedupe key is the caller's design decision, and it decides what "duplicate" means.** An
/// approval waiting on one person is `approval:<id>` — notify once, however many times the queue
/// re-runs. An overdue task is `overdue:<id>:<yyyy-mm-dd>` — once *per day*, because a second
/// day's silence is new information. A key with no time component would notify once and never
/// again; a key with a timestamp would notify every tick. Both are wrong for the other case,
/// which is why this is not decided here.
model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId        String @map("tenant_id") @db.Uuid
  recipientUserId String @map("recipient_user_id") @db.Uuid

  kind     NotificationKind
  severity NotificationSeverity @default(Info)

  title String @db.VarChar(200)
  body  String @db.VarChar(2000)

  /// **The deep link to the exact resource**, as a workspace-relative path — `/approvals/abc`.
  /// Relative rather than absolute so it survives a domain change, and stored rather than derived
  /// so a notification about a resource whose route later moves still says where it pointed.
  deepLink String @map("deep_link") @db.VarChar(500)

  /// What it concerns, for filtering and for the audit trail. Opaque strings: the modules that
  /// own approvals, connections and budgets arrive at later prompts.
  resourceType String  @map("resource_type") @db.VarChar(60)
  resourceId   String? @map("resource_id") @db.VarChar(120)

  /// True when the recipient is the person the work is **assigned to**, rather than somebody
  /// being kept informed. Drives the client's "assigned to me" filter, which is the difference
  /// between a to-do list and a news feed.
  isAssignedToRecipient Boolean @default(false) @map("is_assigned_to_recipient")

  /// **Cannot be muted by a preference.** Set for every `Critical` and every `SecurityEvent`.
  /// Stored rather than derived so the row itself carries the guarantee — a later change to the
  /// mandatory set cannot retroactively make a delivered mandatory alert optional.
  isMandatory Boolean @default(false) @map("is_mandatory")

  /// A `Critical` item is not cleared by being read; somebody has to say they have seen it.
  requiresAcknowledgement Boolean @default(false) @map("requires_acknowledgement")

  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)

  /// The idempotency key. See the model comment — its shape decides what "duplicate" means.
  dedupeKey String @map("dedupe_key") @db.VarChar(200)

  /// When this should escalate if still unacknowledged. Null for something that never escalates.
  escalatesAt     DateTime? @map("escalates_at") @db.Timestamptz(6)
  escalatedAt     DateTime? @map("escalated_at") @db.Timestamptz(6)
  /// Set on the notification an escalation *created*, pointing at the one that went unanswered.
  escalatedFromId String?   @map("escalated_from_id") @db.Uuid

  /// When an email was enqueued for this. Null when the preference suppressed it or it is
  /// waiting for a digest. Visibility rather than state: the outbox is the source of truth for
  /// whether it was actually delivered.
  emailQueuedAt DateTime? @map("email_queued_at") @db.Timestamptz(6)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): an escalation chain can never reach another company's notification.
  /// A single-column key on `escalatedFromId` alone would permit exactly that, and the chain is
  /// followed when showing "this was escalated from", so a breach would surface in the UI.
  ///
  /// `NoAction`, not `SetNull`: a composite `SET NULL` nulls **every** referencing column,
  /// including `tenant_id`, which is NOT NULL — the Prompt 12 lesson. Nothing deletes a
  /// notification anyway (`DELETE` is revoked from the application role), so refusing is honest.
  escalatedFrom Notification?  @relation("NotificationEscalation", fields: [tenantId, escalatedFromId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  escalations   Notification[] @relation("NotificationEscalation")

  @@unique([tenantId, id])
  @@unique([tenantId, recipientUserId, dedupeKey])
  /// The Notification Center's query: mine, newest first.
  @@index([tenantId, recipientUserId, occurredAt(sort: Desc)])
  /// The unread badge's query.
  @@index([tenantId, recipientUserId, readAt])
  /// The escalation sweeper's query.
  @@index([escalatesAt, escalatedAt])
  @@map("notifications")
}

/// What one person wants to be told about, per kind.
///
/// Absent means the documented default for that kind, so a person who has never opened the screen
/// is fully configured and no backfill migration exists — the same shape as company settings
/// (Prompt 14).
///
/// **A mandatory kind cannot be muted.** Enforced by a check constraint rather than only in the
/// service, because "the alert nobody could turn off" is a security property and a service is one
/// missed branch away from breaking it.
model NotificationPreference {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  kind NotificationKind

  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  emailEnabled Boolean @default(true) @map("email_enabled")

  /// Batching applies to email only. There is no digest for the in-app center: a bell that
  /// updates once a day is a bell nobody trusts.
  digest NotificationDigest @default(Off)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, kind])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Prompt 16 — Integrations, Connections, Secrets and Agent Tool Permission
// ---------------------------------------------------------------------------

enum ConnectionScopeKind {
  /// Company infrastructure. Survives its owner leaving, and may be transferred.
  Company
  /// One person's own account. **Never transferred** — the credential is theirs.
  User

  @@map("connection_scope_kind")
}

enum ConnectionEnvironmentKind {
  Test
  Production

  @@map("connection_environment_kind")
}

/// What an Engine Agent may do through a connection.
///
/// **Deliberately not the human `Action` enum.** A person needs `settings:Administer` to
/// configure a connection; an agent needs a grant from this set to use one. Merging the two would
/// let "administer the Integrations module" silently become "let an agent delete records in the
/// connected ERP", and the client's rule is that they stay separate.
enum ToolActionCategoryKind {
  Read
  Write
  Delete
  ExternalBulkSend
  SensitiveExport
  FinancialChange
  ProductionChange

  @@map("tool_action_category_kind")
}

/// The sealed value behind a `secret_ref`. **The only table in UBoss that holds one.**
///
/// ## Why a separate table rather than a column on `Connection`
///
/// So that reading a connection cannot read its secret. Every screen, every list, every
/// `affected agent count` query touches `connections`; none of them touch this. That makes the
/// grant surface narrow enough to reason about, and it makes the client's "secret_ref only" rule
/// structural rather than a convention somebody has to remember.
///
/// The value is sealed with `SecretBox` (AES-256-GCM, keyed and versioned), so even a read of
/// this table yields ciphertext. `SecretsVault` is the adapter seam: a deployment with a real
/// Secrets Manager provides its own implementation and this table stays empty.
model ConnectionSecret {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The opaque handle a `Connection` stores. Never derived from the credential.
  secretRef String @unique @map("secret_ref") @db.VarChar(120)

  /// `SecretBox` envelope. Never plaintext, at any point.
  sealedValue String @map("sealed_value") @db.Text
  /// Which encryption key sealed it, so a key rotation can find what needs resealing.
  keyId       String @map("key_id") @db.VarChar(60)

  /// When the value was last replaced. Distinct from `updatedAt`, which any write moves.
  rotatedAt DateTime @default(now()) @map("rotated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, secretRef])
  @@map("connection_secrets")
}

/// One integration: who owns it, what it talks to, and what state it is in.
///
/// ## The state is derived, not trusted
///
/// `derivedConnectionState` computes it from `disabledAt`, `credentialExpiresAt`,
/// `needsReauthorization` and `lastError` **at read time**. A credential that expired an hour ago
/// is expired now, whether or not a sweep has run — and every Engine Agent run in the gap would
/// otherwise be authorised against a stale answer. The same rule as break-glass and platform-role
/// expiry (ADR-047).
///
/// There is therefore no `state` column. A stored one would be a second answer to a question that
/// already has one.
///
/// ## The secret is a reference
///
/// `secretRef` points at a `ConnectionSecret`, or at whatever a real Secrets Manager adapter
/// resolves. This row never holds a credential, which is why it can be listed freely.
model Connection {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String              @map("tenant_id") @db.Uuid
  scope    ConnectionScopeKind

  /// Which connector, from the code catalogue. A kind not in it is refused by the service.
  connectorKind String @map("connector_kind") @db.VarChar(60)
  label         String @db.VarChar(120)

  /// Who is accountable for it. For a `User` connection this is also whose account it is.
  ownerUserId String @map("owner_user_id") @db.Uuid

  /// Null where the connector has one environment. Test and Production are separate rows.
  environment ConnectionEnvironmentKind?

  /// The handle, never the value. See `ConnectionSecret`.
  secretRef String? @map("secret_ref") @db.VarChar(120)

  /// Which departments may use it. Empty means the whole company — stated rather than implied,
  /// because an empty list read as "nobody" would silently break every existing connection the
  /// day departments were introduced.
  allowedDepartmentIds String[] @map("allowed_department_ids") @db.Uuid

  /// State inputs. Each is a fact; the state is the reading of them.
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledReason       String?   @map("disabled_reason") @db.VarChar(500)
  credentialExpiresAt  DateTime? @map("credential_expires_at") @db.Timestamptz(6)
  needsReauthorization Boolean   @default(false) @map("needs_reauthorization")
  /// The last check's failure, cleared by a successful one.
  lastError            String?   @map("last_error") @db.VarChar(1000)

  /// The client's field: when this last actually worked.
  lastSuccessfulCheckAt DateTime? @map("last_successful_check_at") @db.Timestamptz(6)
  lastCheckedAt         DateTime? @map("last_checked_at") @db.Timestamptz(6)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  toolGrants ConnectionToolGrant[]
  knowledgeSources KnowledgeSource[]
  checks     ConnectionCheck[]

  @@unique([tenantId, id])
  /// One connection per connector, environment and owner. A second identical one is almost
  /// always a mistake, and two rows for the same credential make "affected agents" wrong.
  @@unique([tenantId, connectorKind, environment, ownerUserId, label])
  @@index([tenantId, connectorKind])
  @@index([tenantId, ownerUserId])
  /// The expiry sweep's query.
  @@index([credentialExpiresAt, disabledAt])
  @@map("connections")
}

/// **Agent Tool Permission.** What one Engine Agent may do through one connection.
///
/// ## This is not a human permission, and the separation is the point
///
/// A person's access comes from `role_assignments` and the Prompt 7 engine. An agent's comes from
/// here. The client's rule is that the two are separate, and the reason is concrete: somebody
/// granted `settings:Administer` should be able to *configure* an integration without thereby
/// gaining the ability to make an agent delete records through it.
///
/// So a grant names the Engine Agent, the category, who approved it and why — and a high-risk
/// category has no default. `agent_id` is an opaque uuid because Engine Agents arrive at a later
/// prompt; this table does not wait for them, and gains a foreign key when they exist.
model ConnectionToolGrant {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  /// Which Engine Agent. Opaque until the Engine Agent model exists.
  agentId String @map("agent_id") @db.Uuid

  category ToolActionCategoryKind

  /// Required for a high-risk category, enforced by a check constraint. An unexplained grant to
  /// delete from a company's ERP is the one somebody will be asked about.
  reason String? @db.VarChar(1000)

  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Revoked rather than deleted: "who could do this in March" has to stay answerable.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a grant can never point at another company's connection.
  connection Connection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, connectionId, revokedAt])
  @@index([tenantId, agentId, revokedAt])
  @@map("connection_tool_grants")
}

/// One *Test Connection* result. Append-only history.
///
/// A history rather than a pair of columns, because "it has been failing since Tuesday" is what
/// somebody debugging an integration needs, and two columns can only say "it failed".
model ConnectionCheck {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  succeeded  Boolean
  /// The adapter's own message. Never a credential — the adapters are responsible for that and
  /// the service truncates.
  detail     String  @db.VarChar(1000)
  /// How long the check took, so a slow provider is distinguishable from a broken one.
  durationMs Int     @map("duration_ms")

  /// Null for a check run by a sweep rather than a person.
  checkedByUserId String?  @map("checked_by_user_id") @db.Uuid
  checkedAt       DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, connectionId, checkedAt(sort: Desc)])
  @@map("connection_checks")
}

// ---------------------------------------------------------------------------
// Prompt 17 — Skill Catalog and Company Skills & AI
// ---------------------------------------------------------------------------

/// Who owns a Skill's lifecycle.
///
/// **Not a template category.** A layer decides who may author and approve, not what the Skill
/// can do. A company cannot edit a platform Skill; it clones one into its own layer, which is a
/// different Skill with its own approval trail — and that difference is why cloning is not
/// "copying a template".
enum SkillLayerKind {
  /// Published by UBoss, available to every company.
  UbossVerified
  /// Published by UBoss for one industry.
  IndustryPack
  /// This company's own. The only layer a company may author.
  CompanyCustom

  @@map("skill_layer_kind")
}

/// The client's lifecycle. `Approved` and `Published` are separate on purpose: approving is a
/// decision about content, publishing is the moment work may reference it.
enum SkillStatusKind {
  Draft
  Test
  Review
  Approved
  Published
  Deprecated
  Archived

  @@map("skill_status_kind")
}

enum SkillAutonomyKind {
  SuggestOnly
  ProposeForApproval
  ActThenReport
  FullyAutonomous

  @@map("skill_autonomy_kind")
}

enum SkillCreationModeKind {
  Manual
  CreateWithUbossAi
  FromDocument
  Clone

  @@map("skill_creation_mode_kind")
}

/// A Skill's **identity**: the thing that persists across versions.
///
/// ## Why identity and content are separate tables
///
/// "Published V1 is immutable; an edit creates a V2 Draft" only means something if there is
/// something for both versions to be versions **of**. Work references a *version*; a person talks
/// about the *Skill*. One table would force a choice between rewriting history and duplicating
/// identity on every version.
///
/// ## `tenantId` is nullable, and that is the platform/company split
///
/// Null means platform-owned — a Verified Skill or an Industry Pack, readable by every company.
/// A value means one company's custom Skill. The Row-Level Security policy therefore permits
/// **reading** a null-tenant row from inside a company (that is what "available to every company"
/// means) while its `WITH CHECK` half refuses **writing** one, so a company can never author or
/// alter a platform Skill.
model Skill {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a platform-owned Skill. See the model comment.
  tenantId String?        @map("tenant_id") @db.Uuid
  layer    SkillLayerKind

  /// Stable, human-readable handle — `tender-eligibility-screen`. Unique within its owner, so a
  /// company may have its own `tender-eligibility-screen` alongside the Verified one.
  key      String  @db.VarChar(80)
  name     String  @db.VarChar(160)
  /// Which industry, for a pack. Null otherwise.
  industry String? @db.VarChar(80)

  /// Accountable person. Null for a platform Skill, whose owner is UBoss.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// The version work should reference. Null until something is published.
  publishedVersionId String? @map("published_version_id") @db.Uuid

  /// Set when this Skill was cloned from another. The provenance impact analysis follows.
  clonedFromSkillId String? @map("cloned_from_skill_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions SkillVersion[]

  /// Self-reference for clone provenance. `NoAction`: nothing deletes a Skill, and a clone must
  /// not lose the record of where it came from.
  clonedFrom Skill?  @relation("SkillClone", fields: [clonedFromSkillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clones     Skill[] @relation("SkillClone")

  evaluationCases SkillEvaluationCase[]
  comparisons     SkillRegressionComparison[]

  @@index([tenantId, layer])
  @@index([layer, industry])
  @@index([clonedFromSkillId])
  @@map("skills")
}

/// One version of a Skill, with all of the client's content fields.
///
/// ## Immutable once approved
///
/// The client's rule names publication; this is deliberately stricter and freezes content at
/// **`Approved`**. An approval is a governance decision about specific content, so content that
/// could change afterwards would make the approval worthless — somebody could get "delete
/// records" approved by having "read records" reviewed.
///
/// Enforced by a `BEFORE UPDATE` trigger rather than a revoked grant, because the status must
/// still be able to move (`Published` → `Deprecated` → `Archived`) while the content cannot. A
/// blanket `REVOKE UPDATE` would have made deprecation impossible.
model SkillVersion {
  id String @id @default(uuid(7)) @db.Uuid

  /// Mirrors the Skill's. Null for a platform Skill; carried on the row so RLS can read it
  /// without a join.
  tenantId String? @map("tenant_id") @db.Uuid
  skillId  String  @map("skill_id") @db.Uuid

  versionNumber Int             @map("version_number")
  status        SkillStatusKind @default(Draft)

  // ---- The client's content fields, in their order ----
  purpose      String @db.VarChar(2000)
  category     String @db.VarChar(40)
  whenToUse    String @map("when_to_use") @db.VarChar(2000)
  /// Its own field, not folded into `whenToUse`: knowing when *not* to reach for a Skill is what
  /// stops it being used for the wrong work, and it is the field people skip.
  whenNotToUse String @map("when_not_to_use") @db.VarChar(2000)

  /// Declared inputs, IF/THEN rules and numbered steps. JSON because each is a list of small
  /// structured records that nothing queries across — a table per list would be three joins to
  /// render one form.
  inputs Json @db.JsonB
  rules  Json @db.JsonB
  steps  Json @db.JsonB

  /// Tool categories from Prompt 16. A Skill **declares** what it needs; a
  /// `ConnectionToolGrant` decides what an agent actually gets. Declaring is not being granted.
  allowedToolCategories String[] @map("allowed_tool_categories")

  outputSchema    String @map("output_schema") @db.Text
  validation      String @db.VarChar(2000)
  failureHandling String @map("failure_handling") @db.VarChar(2000)

  requiresApproval    Boolean           @default(true) @map("requires_approval")
  autonomy            SkillAutonomyKind @default(ProposeForApproval)
  evidenceRequirement String            @map("evidence_requirement") @db.VarChar(2000)

  // ---- Provenance and governance trail ----
  creationMode        SkillCreationModeKind @default(Manual) @map("creation_mode")
  /// For `FromDocument`: what the draft was written from. Stored so a reviewer can check the
  /// Skill against its source, not to reproduce the document.
  sourceReference     String?               @map("source_reference") @db.VarChar(500)
  /// For `Clone`: which version this was copied from.
  clonedFromVersionId String?               @map("cloned_from_version_id") @db.Uuid

  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  deprecatedAt      DateTime? @map("deprecated_at") @db.Timestamptz(6)
  /// Why it was deprecated or archived. Required for both.
  retirementReason  String?   @map("retirement_reason") @db.VarChar(1000)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion      Int      @default(1) @map("row_version")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  transitions SkillTransition[]

  @@unique([skillId, versionNumber])
  @@index([tenantId, status])
  @@index([skillId, status])
  @@map("skill_versions")
}

/// Every lifecycle move, append-only.
///
/// A history rather than the timestamps alone, because "who sent this back to draft, and what did
/// they say" is the question a governance review asks — and the timestamp columns can only record
/// the *last* time each thing happened.
model SkillTransition {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId       String? @map("tenant_id") @db.Uuid
  skillVersionId String  @map("skill_version_id") @db.Uuid

  fromStatus SkillStatusKind @map("from_status")
  toStatus   SkillStatusKind @map("to_status")

  /// Required for anything that rejects, deprecates or archives.
  reason String? @db.VarChar(1000)

  actorUserId String?  @map("actor_user_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant  Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)

  @@index([skillVersionId, occurredAt(sort: Desc)])
  @@map("skill_transitions")
}

// ---------------------------------------------------------------------------
// Prompt 18 — Skill Router, evaluation cases and regression comparison
// ---------------------------------------------------------------------------

enum EvaluationAssertionKind {
  /// The output must equal the expectation exactly.
  ExactMatch
  /// Every expected fragment must appear.
  ContainsAll
  /// A person judged it. Recorded, never computed.
  HumanJudged

  @@map("evaluation_assertion_kind")
}

enum RegressionVerdictKind {
  Improved
  NoChange
  /// The candidate fails something the current version passes. **Blocks publication.**
  Regressed
  Mixed
  /// Not enough cases ran to say anything.
  Inconclusive

  @@map("regression_verdict_kind")
}

enum SkillCandidateStatusKind {
  Suggested
  UnderReview
  /// A **Draft** Skill was created. There is no path from here to Published.
  Accepted
  Rejected

  @@map("skill_candidate_status_kind")
}

/// One saved evaluation case for a Skill: an input, an expectation, and how to judge.
///
/// ## Attached to the Skill, not to a version
///
/// A case describes what the *capability* must do, so it survives a version change — which is the
/// whole point: a regression comparison runs the same cases against the live version and a
/// candidate. A case per version could never compare two.
///
/// ## Why the expectation is frozen once it has been used
///
/// A case whose expectation can be edited after a run is evidence that can be made to agree with
/// whatever happened. `usedInComparison` records that a comparison has depended on it, and the
/// service refuses to change the expectation afterwards.
model SkillEvaluationCase {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a case on a platform Skill, mirroring `skills`.
  tenantId String? @map("tenant_id") @db.Uuid
  skillId  String  @map("skill_id") @db.Uuid

  name        String @db.VarChar(160)
  description String @db.VarChar(1000)

  /// The named inputs this case supplies, as the Skill declares them.
  inputs Json @db.JsonB

  assertion EvaluationAssertionKind
  /// What the output must be, or contain, or what a person was asked to judge.
  expected  String                  @db.Text

  /// Set once a regression comparison has depended on this case. Freezes the expectation.
  usedInComparison Boolean @default(false) @map("used_in_comparison")

  /// Cases can be retired without deleting the runs that referenced them.
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredReason String?   @map("retired_reason") @db.VarChar(500)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  runs SkillEvaluationRun[]

  @@unique([skillId, name])
  @@index([tenantId, skillId, retiredAt])
  @@map("skill_evaluation_cases")
}

/// One recorded result of one case against one version. Append-only.
///
/// ## There is no evaluator yet, and this table is honest about it
///
/// Running a Skill needs the Model Gateway, which arrives at a later prompt. So a run's output is
/// **recorded** rather than produced: an operator or a test supplies what the Skill returned, the
/// assertion decides pass or fail, and `producedBy` says which it was. A stub evaluator that
/// invented plausible output would make every green comparison worthless.
model SkillEvaluationRun {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId       String? @map("tenant_id") @db.Uuid
  caseId         String  @map("case_id") @db.Uuid
  skillVersionId String  @map("skill_version_id") @db.Uuid

  /// What the Skill returned. Recorded, not generated.
  actualOutput String @map("actual_output") @db.Text

  /// Null for a `HumanJudged` case nobody has judged yet — which counts as neither pass nor
  /// fail, so a comparison cannot report success on the strength of it.
  passed Boolean?

  /// How the output got here: `Recorded` (an operator or a test) or, later, a provider name.
  producedBy String @default("Recorded") @map("produced_by") @db.VarChar(60)

  /// A person's note, required when they overrode a computed verdict.
  note String? @db.VarChar(1000)

  durationMs Int? @map("duration_ms")

  runByUserId String?  @map("run_by_user_id") @db.Uuid
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz(6)

  tenant Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   SkillEvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, skillVersionId, runAt(sort: Desc)])
  @@index([skillVersionId])
  @@map("skill_evaluation_runs")
}

/// Current version against candidate version, case by case.
///
/// The client's "regression comparison data model". A row per comparison, with the aggregate the
/// verdict is computed from — stored rather than derived, because a comparison is evidence
/// somebody published on and re-deriving it later against changed cases would give a different
/// answer to the same question.
model SkillRegressionComparison {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String? @map("tenant_id") @db.Uuid
  skillId  String  @map("skill_id") @db.Uuid

  /// Null when there is no live version yet — the first publication has nothing to regress from.
  currentVersionId   String? @map("current_version_id") @db.Uuid
  candidateVersionId String  @map("candidate_version_id") @db.Uuid

  casesCompared Int      @map("cases_compared")
  regressions   String[] @map("regression_case_ids") @db.Uuid
  improvements  String[] @map("improvement_case_ids") @db.Uuid
  /// Cases nobody judged. Counted separately so a verdict cannot lean on them.
  unjudged      String[] @map("unjudged_case_ids") @db.Uuid

  verdict RegressionVerdictKind

  /// Set when somebody publishes despite a regression. Requires a reason.
  acceptedDespiteRegressionByUserId String?   @map("accepted_despite_regression_by_user_id") @db.Uuid
  acceptedDespiteRegressionAt       DateTime? @map("accepted_despite_regression_at") @db.Timestamptz(6)
  acceptanceReason                  String?   @map("acceptance_reason") @db.VarChar(1000)

  runByUserId String?  @map("run_by_user_id") @db.Uuid
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([tenantId, skillId, runAt(sort: Desc)])
  @@index([candidateVersionId])
  @@map("skill_regression_comparisons")
}

/// A capability the router could not find, recorded rather than improvised.
///
/// ## This is not a Skill
///
/// The client's rule: when the required capability is missing, create or suggest a Skill
/// Candidate and route it to authorized governance — **never silently publish or auto-use it**.
///
/// So a Candidate is a *request*, carrying the routing context that produced it, and it has
/// exactly two outcomes: accepted, which creates a **Draft** Skill that then goes through the
/// normal lifecycle, or rejected with a reason. **There is no transition from here to Published**,
/// and `Accepted` and `Rejected` are both terminal — a re-openable Candidate would be a second,
/// weaker lifecycle running beside the real one.
model SkillCandidate {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String                   @map("tenant_id") @db.Uuid
  status   SkillCandidateStatusKind @default(Suggested)

  /// What the work was, in the requester's words. The router's `aiTask`.
  requestedCapability String @map("requested_capability") @db.VarChar(2000)

  /// The routing context that produced it, so a reviewer can see what was asked for and what was
  /// rejected. Snapshot, not a live reference: the context is what mattered at the time.
  routingContext        Json @map("routing_context") @db.JsonB
  /// Which approved Skills were considered and why each was ruled out.
  consideredAndRejected Json @map("considered_and_rejected") @db.JsonB

  suggestedName    String? @map("suggested_name") @db.VarChar(160)
  suggestedPurpose String? @map("suggested_purpose") @db.VarChar(2000)

  /// The Draft Skill created when this was accepted. The only thing acceptance produces.
  createdSkillId String? @map("created_skill_id") @db.Uuid

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// Required to reject, and to accept — somebody has to say why a new capability is warranted.
  decisionReason   String?   @map("decision_reason") @db.VarChar(1000)

  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("skill_candidates")
}

// ---------------------------------------------------------------------------
// Prompt 19 — Objective Builder (Form 2)
// ---------------------------------------------------------------------------

/// The client's objective lifecycle. `UnderReview` is the source document's "Submitted/Under
/// Review" and `Active` is its "Published/Active" — the slash pairs are one state each, and the
/// full approved wording lives in `OBJECTIVE_STATUS_LABELS` on the shared vocabulary.
enum ObjectiveStatusKind {
  Draft
  UnderReview
  AiAnalysis
  WorkflowDraft
  ReadyForApproval
  Active
  /// Prompt 34 — §27.1's "controlled Pause/Resume" on a *live* objective. Beside `Active` rather
  /// than after `Completed` because it is reversible and is not a step towards closure.
  Paused
  Completed
  /// Prompt 34 — §27.1's chain: Completed -> Outcome Review -> Closed -> Archived.
  OutcomeReview
  Closed
  Archived

  @@map("objective_status_kind")
}

/// Duration units for Target Completion Time. Separate from the workload `unit` free-text column
/// on purpose — the client's locked instruction is that the two are never collapsed.
/// Why a version exists. A **minor** edit is still an `Edit`: the client's rule gives it no
/// exemption, and a "this barely changed so reuse the version" shortcut is exactly how a live
/// plan gets rewritten under the people executing it.
enum ObjectiveVersionOriginKind {
  Initial
  Edit
  Rollback

  @@map("objective_version_origin_kind")
}

enum ObjectiveTimeUnitKind {
  WorkingDays
  CalendarDays
  Hours
  Weeks

  @@map("objective_time_unit_kind")
}

/// Who performs a workflow step. `Engine` is the reusable AI worker; `Executor` is the
/// monitoring / validation / escalation layer and therefore a *checking* step, never a
/// doing-the-work step.
enum ObjectiveStepEngineKind {
  Human
  Engine
  SubEngine
  Executor

  @@map("objective_step_engine_kind")
}

/// What approval a step needs. `FourEyes` is a second *person*, not a more senior one.
enum ObjectiveStepApprovalKind {
  NotRequired
  Manager
  Head
  FourEyes

  @@map("objective_step_approval_kind")
}

/// Reward kinds. `Cash` and `Points` are quantified; the other two are not.
enum ObjectiveRewardTypeKind {
  Cash
  Points
  Recognition
  Other

  @@map("objective_reward_type_kind")
}

/// An Objective's **identity**: the thing that persists across versions.
///
/// ## Why identity and content are separate tables
///
/// Same reason as `Skill`, and here the client stated the rule outright: a published/live version
/// is immutable, and any authorized edit after Live creates a new Draft version rather than
/// overwriting the live one. That is only expressible if there is something for V1 and V2 to be
/// versions **of**. Running work references a *version*; a person talks about the *objective*.
///
/// ## Why `departmentId` appears here as well as on the version
///
/// Department is a Form 2 field, so the version carries it — that is the value the form recorded.
/// This copy exists because authorization scope evaluation asks "which department is this
/// objective in?" on every read, and answering it through a join into versions would make the
/// scope check depend on version state. The service keeps them in step inside one transaction
/// (creation copies the draft's, publishing copies the published version's) and a test asserts
/// they agree. It is a denormalization with a named owner, not two sources of truth.
model Objective {
  id String @id @default(uuid(7)) @db.Uuid

  /// Always a company. There is no platform-owned objective — unlike Skills, an objective is
  /// business intent belonging to one company, so this column is NOT NULL and the RLS policy is
  /// the ordinary symmetric one.
  tenantId String @map("tenant_id") @db.Uuid

  /// Company-facing handle, e.g. `OBJ-2026-014`. Unique within the company.
  code String @db.VarChar(40)

  /// Scope anchor. See the model comment.
  departmentId String @map("department_id") @db.Uuid

  /// The accountable person named on the form.
  objectiveOwnerUserId String @map("objective_owner_user_id") @db.Uuid

  /// The version live work references. Null until something is published.
  activeVersionId String? @map("active_version_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): the department must be in the same company.
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)

  awards               RewardAward[]
  outcomeReviews       ObjectiveOutcomeReview[]
  pauses               ObjectivePause[]
  versions             ObjectiveVersion[]       @relation("ObjectiveVersions")
  analysisRuns         ObjectiveAnalysisRun[]
  workflowDrafts       ObjectiveWorkflowDraft[]
  humanTasks           HumanTask[]
  aiWorkAssignments    AiWorkAssignment[]
  approvalRequests     ApprovalRequest[]
  executorExpectations ExecutorExpectation[]
  reward               ObjectiveReward?

  /// Composite (ADR-064): the live pointer must name a version of **this company's** objective.
  ///
  /// `Skill.publishedVersionId` is a bare column with no key, which turned out to be a gap worth
  /// closing rather than a precedent worth copying: a dangling live pointer means work executing
  /// a plan that no longer exists. `NoAction` rather than `SetNull` for the usual reason — a
  /// composite `SET NULL` nulls every referencing column, `tenant_id` included, which is NOT
  /// NULL. Refusing to delete the version an objective is currently running is the honest answer.
  activeVersion ObjectiveVersion? @relation("ObjectiveActiveVersion", fields: [tenantId, activeVersionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  /// Lets children hold a composite foreign key back to their objective *within the tenant*.
  @@unique([tenantId, id])
  @@index([tenantId, departmentId])
  @@index([tenantId, objectiveOwnerUserId])
  @@map("objectives")
}

/// One version of an objective, holding the Form 2 content.
///
/// ## The column list is the client's field list
///
/// Every column below maps to an entry in `FORM2_OBJECTIVE_FIELDS`, and an invariant test walks
/// that array to confirm none has been dropped. `unit` and `time_unit` are separate columns and
/// must stay separate; `prepared_by` and `form_date` are kept even though they are usually
/// derivable, because they are source fields and the rule is that no source field is dropped.
///
/// ## Immutability
///
/// Once the status reaches `Active`, `Completed` or `Archived` a database trigger refuses any
/// change to the content columns while still permitting the status to move. The trigger is what
/// makes the client's versioning rule structural rather than a convention the service happens to
/// follow — the same approach as `SkillVersion`.
model ObjectiveVersion {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  objectiveId String @map("objective_id") @db.Uuid

  versionNumber Int                 @map("version_number")
  status        ObjectiveStatusKind @default(Draft)

  // ---- Form 2, source section, in the source document's order ----
  objectiveName        String                 @map("objective_name") @db.VarChar(200)
  departmentId         String                 @map("department_id") @db.Uuid
  objectiveOwnerUserId String                 @map("objective_owner_user_id") @db.Uuid
  expectedFinalResult  String                 @map("expected_final_result") @db.VarChar(4000)
  currentWorkload      Int?                   @map("current_workload")
  unit                 String?                @db.VarChar(60)
  targetCompletionTime Int?                   @map("target_completion_time")
  timeUnit             ObjectiveTimeUnitKind? @map("time_unit")
  preparedBy           String?                @map("prepared_by") @db.VarChar(160)
  /// The form's own Date field. A business date, not an instant — hence `@db.Date`.
  formDate             DateTime?              @map("form_date") @db.Date

  // ---- UBoss routing controls (shown in their own card, never inside the source section) ----
  responsibleOwnerUserId String? @map("responsible_owner_user_id") @db.Uuid
  executionTeam          String? @map("execution_team") @db.VarChar(200)

  /// When this version was sent for review, and by whom. Null while it is still a private draft.
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?   @map("submitted_by_user_id") @db.Uuid

  // ---- Prompt 20: review routing and strict versioning ----

  /// Why this version exists. `Initial` for V1, `Edit` for the client's "any later edit
  /// automatically creates V2 Draft copied from V1", `Rollback` for "rollback creates a new
  /// version based on an older version". A minor edit is still an `Edit`; there is no exemption.
  origin ObjectiveVersionOriginKind @default(Initial)

  /// Which version this one was copied from. Null only for V1.
  ///
  /// Carries the provenance for both an ordinary edit and a rollback, so the history can answer
  /// "where did this come from" without inferring it from version numbers — which would be wrong
  /// the moment a rollback makes V4 a copy of V1 rather than of V3.
  copiedFromVersionId String? @map("copied_from_version_id") @db.Uuid

  /// The approve act, recorded separately from publishing.
  ///
  /// The client's chain is `... -> Approved -> Published -> LIVE`, two acts. The status enum is
  /// the client's own eight-state list and has no `Approved` member, so approval is recorded as a
  /// *fact on the version* rather than as a ninth state: a version can be approved and not yet
  /// published, and the screen says "Approved — awaiting publish". See ADR-104.
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid

  /// Send Back / Request Changes, with the reason the reviewer gave. A send-back with no reason
  /// is the one the author cannot act on, so a constraint insists.
  sentBackAt       DateTime? @map("sent_back_at") @db.Timestamptz(6)
  sentBackByUserId String?   @map("sent_back_by_user_id") @db.Uuid
  sentBackReason   String?   @map("sent_back_reason") @db.VarChar(2000)

  /// Confirm Execution Team — the responsible manager accepting who will do the work. Distinct
  /// from approving the plan: agreeing the team and agreeing the objective are different
  /// findings, and the client lists them as separate manager actions.
  executionTeamConfirmedAt       DateTime? @map("execution_team_confirmed_at") @db.Timestamptz(6)
  executionTeamConfirmedByUserId String?   @map("execution_team_confirmed_by_user_id") @db.Uuid

  /// When it went live. Null unless it has been published.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a version can never belong to another company's objective.
  objective Objective @relation("ObjectiveVersions", fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  /// Composite (ADR-064): a version can only have been copied from one in the same company.
  ///
  /// `NoAction`: nothing deletes a version, and a copy must not lose the record of where it
  /// came from — the client requires that historical records keep exact version ids.
  copiedFrom ObjectiveVersion?  @relation("ObjectiveVersionProvenance", fields: [tenantId, copiedFromVersionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  copies     ObjectiveVersion[] @relation("ObjectiveVersionProvenance")

  /// Back-relation for the live pointer. At most one objective points here at a time, which the
  /// partial unique index on `status = 'Active'` is what actually guarantees.
  activeFor Objective[] @relation("ObjectiveActiveVersion")

  /// Composite (ADR-064): the department named on the form must be in the same company.
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)

  steps                ObjectiveWorkflowStep[]
  analysisRuns         ObjectiveAnalysisRun[]
  workflowDrafts       ObjectiveWorkflowDraft[]
  humanTasks           HumanTask[]
  aiWorkAssignments    AiWorkAssignment[]
  approvalRequests     ApprovalRequest[]
  executorExpectations ExecutorExpectation[]
  outcomeReview        ObjectiveOutcomeReview?

  @@unique([tenantId, objectiveId, versionNumber])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, objectiveId, versionNumber(sort: Desc)])
  @@map("objective_versions")
}

/// One row of the Form 2 workflow grid.
///
/// ## There is no `step` column
///
/// `Step` in the source grid is the row's position, and storing the number as well as the ordering
/// invites the two to disagree the first time somebody reorders rows. `position` is stored and
/// `Step` is rendered from it.
///
/// ## The row count is not fixed
///
/// The approved UI says so explicitly. A company whose process has nineteen steps records
/// nineteen; nothing here caps it beyond the per-version sanity ceiling in the CHECK constraints.
model ObjectiveWorkflowStep {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId           String @map("tenant_id") @db.Uuid
  objectiveVersionId String @map("objective_version_id") @db.Uuid

  /// 1-based. Contiguous within a version — enforced by the service, since a partial reorder
  /// legitimately passes through a non-contiguous state inside one transaction.
  position Int

  whoPersonName        String?                   @map("who_person_name") @db.VarChar(160)
  whoDesignation       String?                   @map("who_designation") @db.VarChar(160)
  whoEngine            ObjectiveStepEngineKind   @default(Human) @map("who_engine")
  whenTrigger          String?                   @map("when_trigger") @db.VarChar(200)
  whenFrequency        String?                   @map("when_frequency") @db.VarChar(120)
  whatExactWork        String                    @map("what_exact_work") @db.VarChar(2000)
  inputWhatIsUsed      String?                   @map("input_what_is_used") @db.VarChar(400)
  inputReceivedFrom    String?                   @map("input_received_from") @db.VarChar(200)
  whereWorkIsDone      String?                   @map("where_work_is_done") @db.VarChar(200)
  outputWhatIsProduced String?                   @map("output_what_is_produced") @db.VarChar(400)
  outputSentTo         String?                   @map("output_sent_to") @db.VarChar(200)
  timeTaken            String?                   @map("time_taken") @db.VarChar(60)
  currentProblem       String?                   @map("current_problem") @db.VarChar(2000)
  approval             ObjectiveStepApprovalKind @default(NotRequired)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a step can never belong to another company's version.
  objectiveVersion ObjectiveVersion @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, objectiveVersionId, position])
  @@index([tenantId, objectiveVersionId])
  @@map("objective_workflow_steps")
}

/// The optional Performance & Reward panel.
///
/// ## Why it is its own table
///
/// The client's rule is that the panel sits *around* the objective assignment and never inside the
/// canonical Form 2 field list. Its own table, its own endpoint and its own permission is what
/// makes that structural: there is no column on `objective_versions` for a future change to add a
/// reward field to by accident, and the Form 2 invariant test would fail if one appeared.
///
/// ## Nothing here pays anybody
///
/// `amountMinorUnits` is a *declared* amount. The client's instruction is explicit — no auto-pay
/// on completion — so this table has no approved, settled or paid state, no link to the
/// performance ledger, and no connector call. Eligibility and approval are decided by the reward
/// lifecycle that comes later; the condition and the named approver are recorded here so that
/// lifecycle has something to evaluate rather than having to ask again.
model ObjectiveReward {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  /// One panel per objective — the reward is about the assignment, not about a form revision.
  objectiveId String @unique @map("objective_id") @db.Uuid

  /// The client's "Reward/Bonus Applicable". False is a recorded decision, not an empty panel.
  applicable Boolean @default(false)

  rewardType ObjectiveRewardTypeKind? @map("reward_type")

  /// Integer minor units for `Cash`, whole points for `Points`. Never a float — money is always
  /// minor units in this codebase.
  amountMinorUnits Int? @map("amount_minor_units")

  eligibilityCondition String? @map("eligibility_condition") @db.VarChar(2000)

  /// A business date, like the form's own Date field.
  completionDeadline DateTime? @map("completion_deadline") @db.Date

  evidence       String? @db.VarChar(2000)
  approverUserId String? @map("approver_user_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): the panel can never point at another company's objective.
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  awards RewardAward[]

  /// Lets an award hold a composite foreign key back to its rule *within the tenant* (ADR-064).
  @@unique([tenantId, id])
  @@unique([tenantId, objectiveId])
  @@map("objective_rewards")
}

// ---------------------------------------------------------------------------
// Prompt 19A — Objective extra work, bonus and reward controls
// ---------------------------------------------------------------------------

/// The client's chain, with both slash pairs expanded into their four distinct states.
///
/// `Settled` and `Recorded` are separate because "was this paid?" is the first question an audit
/// asks: `Settled` means money moved through an approved connector and there is a provider
/// reference for it, `Recorded` means nothing was paid.
enum RewardAwardStatusKind {
  Draft
  Assigned
  Completed
  Eligible
  Approved
  Rejected
  Settled
  Recorded

  @@map("reward_award_status_kind")
}

/// One person's claim under an objective's reward rule.
///
/// ## Rule and award are separate, and the rule is not this table
///
/// The **rule** is `objective_rewards` — the Performance & Reward panel from Prompt 19, one per
/// objective. This is the **award**: one person's claim under it, carrying the lifecycle, because
/// the lifecycle belongs to an instance. Two people can be assigned under one rule and one of
/// them rejected. There is deliberately no second `reward_rules` table; the panel is the rule.
///
/// ## The promise is snapshotted at assignment
///
/// `rewardType`, `amountMinorUnits`, `eligibilityCondition` and `completionDeadline` are copied
/// from the rule when the award is assigned, and frozen by a trigger. Reading them through the
/// rule instead would let somebody change what was promised after the work was done — raise the
/// amount, or soften the condition — and the audit trail would show the new terms as though they
/// had always been the terms. This is the same reasoning as a comparison freezing the evaluation
/// case it depended on (S-114).
///
/// ## Nothing here pays anybody
///
/// `Approved` is a decision, not a payment. Money moves only in `Settled`, which needs a
/// configured payroll connector, a second person, and a stored provider reference.
model RewardAward {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The rule this claim is under.
  objectiveRewardId String @map("objective_reward_id") @db.Uuid
  /// Carried as well as the rule, so "which objective is this reward for" needs no join.
  objectiveId       String @map("objective_id") @db.Uuid

  /// Whose claim it is. The person who would be paid or scored.
  subjectUserId String @map("subject_user_id") @db.Uuid

  status RewardAwardStatusKind @default(Draft)

  // ---- The promise, snapshotted from the rule at assignment and then frozen ----
  rewardType           ObjectiveRewardTypeKind @map("reward_type")
  amountMinorUnits     Int?                    @map("amount_minor_units")
  eligibilityCondition String                  @map("eligibility_condition") @db.VarChar(2000)
  completionDeadline   DateTime?               @map("completion_deadline") @db.Date
  /// The approver named on the rule when the award was assigned. Who *may* decide it.
  approverUserId       String                  @map("approver_user_id") @db.Uuid

  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid

  /// When the work was reported complete, and who reported it.
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid

  /// When the condition was judged met. Separate from `completedAt`: finishing the work and
  /// meeting the reward's condition are different findings, and the client's chain names both.
  eligibleAt       DateTime? @map("eligible_at") @db.Timestamptz(6)
  eligibleByUserId String?   @map("eligible_by_user_id") @db.Uuid

  /// The Approved-or-Rejected decision. A rejection carries a reason; a constraint insists.
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decisionReason  String?   @map("decision_reason") @db.VarChar(2000)

  /// How it finished, and by whom. `settledByUserId` must differ from `decidedByUserId`: paying
  /// out your own approval is the four-eyes case the client's high-risk rules exist for.
  settledAt       DateTime? @map("settled_at") @db.Timestamptz(6)
  settledByUserId String?   @map("settled_by_user_id") @db.Uuid

  /// The payroll provider's own reference. Present for `Settled`, absent otherwise.
  payoutReference String? @map("payout_reference") @db.VarChar(200)

  /// **Whether real money actually moved.** False for every adapter that ships today. Stored
  /// rather than inferred, so a report can never claim a settlement was real when it was not.
  payoutWasReal Boolean @default(false) @map("payout_was_real")

  /// The performance event a points award produced, if policy permitted one. Null when policy
  /// refused — which is a legitimate ending, not a failure.
  performanceEventId String? @map("performance_event_id") @db.Uuid

  /// Why no performance event was written, when none was. Recorded so the absence is explained
  /// rather than looking like a bug.
  performanceNote String? @map("performance_note") @db.VarChar(500)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): an award can never be under another company's rule.
  rule ObjectiveReward @relation(fields: [tenantId, objectiveRewardId], references: [tenantId, id], onDelete: Cascade)

  /// Composite (ADR-064): nor point at another company's objective.
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, subjectUserId, status])
  @@index([tenantId, objectiveId])
  @@index([tenantId, objectiveRewardId])
  @@map("reward_awards")
}

// ---------------------------------------------------------------------------
// Prompt 21 — Objective AI analysis
// ---------------------------------------------------------------------------

/// The client's seven stages, in order.
enum AnalysisStageKind {
  UnderstandingObjective
  ReadingTeamStructure
  DetectingHumanWork
  IdentifyingAiWork
  MatchingSkills
  AssigningOwners
  BuildingWorkflow

  @@map("analysis_stage_kind")
}

/// `Cancelled` and `Failed` are separate because they mean opposite things about the product: one
/// is somebody choosing to stop, the other is the product not working. Collapsing them would make
/// "how often does analysis fail" unanswerable.
enum AnalysisRunStatusKind {
  Queued
  Running
  Completed
  Cancelled
  Failed

  @@map("analysis_run_status_kind")
}

/// One AI decomposition of one objective version.
///
/// ## Why this is a durable row rather than an in-flight promise
///
/// The approved UI says it outright: *"Analysis runs as a durable job. You can leave this screen
/// and return — progress is preserved."* A promise held in one process cannot honour that, and it
/// cannot be cancelled from a second tab either. So the run, its stage and its output are rows,
/// and the screen reads them.
///
/// ## The output is always a draft
///
/// `draft` holds the workflow the analysis proposes, stamped with `schema_version`. It is never
/// published by anything here: a person reviews it, and the Prompt 20 approve-then-publish path is
/// the only way anything goes live. That is the client's rule, and the reason this table has no
/// approval columns at all — approval belongs to the objective *version*, not to an analysis.
model ObjectiveAnalysisRun {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  /// The exact version analysed. Two runs of different versions are different analyses, and the
  /// client requires historical records to keep exact version ids.
  objectiveVersionId String @map("objective_version_id") @db.Uuid

  status AnalysisRunStatusKind @default(Queued)
  /// The stage reached. Null while queued.
  stage  AnalysisStageKind?

  /// How many of the seven stages have finished. Stored rather than derived from `stage` so a
  /// screen can show a bar without knowing the stage order.
  stagesCompleted Int @default(0) @map("stages_completed")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Cancellation is attributed. "Who stopped this" is the first question when a run vanishes.
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid

  /// Why it failed, for a `Failed` run. Never a stack trace — words a person can act on.
  failureReason String? @map("failure_reason") @db.VarChar(2000)

  /// The proposed workflow, validated against `schemaVersion` before it was stored. Null until
  /// the run completes.
  draft Json? @db.JsonB

  /// The schema version the draft was written with. Checked on read; a draft this build cannot
  /// read is refused rather than guessed at.
  schemaVersion Int @default(1) @map("schema_version")

  // ---- What the Model Gateway actually did ----

  /// The opaque capability label the gateway reported. **Never a provider or model name** — the
  /// client's locked rule is that provider names stay behind the gateway.
  modelCapability String? @map("model_capability") @db.VarChar(80)

  /// **Whether a real model produced this.** False for every adapter that ships today. Stored so
  /// no screen, report or audit entry can present mock output as a model's judgement.
  producedByRealModel Boolean @default(false) @map("produced_by_real_model")

  /// Tokens the gateway reported consuming. The estimate range lives in the draft; this is what
  /// was actually spent producing it.
  promptTokens     Int @default(0) @map("prompt_tokens")
  completionTokens Int @default(0) @map("completion_tokens")

  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a run can never analyse another company's objective.
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  /// Composite (ADR-064): nor another company's version.
  objectiveVersion ObjectiveVersion         @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)
  seededDrafts     ObjectiveWorkflowDraft[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, objectiveId, createdAt(sort: Desc)])
  @@index([tenantId, objectiveVersionId])
  @@map("objective_analysis_runs")
}

// ---------------------------------------------------------------------------
// Prompt 22 — the manager-editable workflow draft
// ---------------------------------------------------------------------------

/// The workflow a manager shapes, separate from the AI proposal it started as.
///
/// ## Why this is not the analysis run
///
/// `objective_analysis_runs` is frozen the moment it finishes: it is the historical record of
/// **what the AI proposed**, and a later cost review or dispute reads it. The manager's edits are a
/// different thing — **what the company decided to do** — and they change repeatedly before
/// anything is published. Writing them back onto the run would destroy the record; keeping the
/// record and refusing edits would make the workflow uneditable. So there are two rows, and the
/// link between them is `seeded_from_run_id`.
///
/// ## One per objective version, versioned by revision
///
/// The objective version is the thing being planned, so the draft hangs off it. `revision`
/// increments on every save, which is what lets the editor detect a concurrent edit rather than
/// silently overwriting somebody: two managers on one plan is a real situation and last-write-wins
/// is the wrong answer for a document this consequential.
model ObjectiveWorkflowDraft {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  /// The exact version being planned. One draft per version.
  objectiveVersionId String @map("objective_version_id") @db.Uuid

  /// The analysis run this was seeded from. Null when a manager built the plan by hand.
  seededFromRunId String? @map("seeded_from_run_id") @db.Uuid

  /// The graph, in `ANALYSIS_SCHEMA_VERSION` shape, validated before every write.
  graph Json @db.JsonB

  /// The schema version `graph` was written with. Checked on read; a draft this build cannot read
  /// is refused rather than guessed at.
  schemaVersion Int @map("schema_version")

  /// Increments on every save. The editor sends the revision it read and the server refuses a
  /// stale one, so a concurrent edit is reported rather than silently losing somebody's work.
  revision Int @default(1)

  /// Set when Approve & Assign has accepted this draft. Prompt 23 owns the transaction; this
  /// column exists so the editor can refuse to edit a draft that has already been assigned —
  /// editing what people are already working to is the thing versioning exists to prevent.
  assignedAt       DateTime? @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a draft can never plan another company's objective.
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  /// Composite (ADR-064): nor another company's version.
  objectiveVersion ObjectiveVersion @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)

  /// Composite (ADR-064). `NoAction`: the run is the historical AI proposal and a draft must not
  /// lose the record of what it was seeded from.
  seededFrom ObjectiveAnalysisRun? @relation(fields: [tenantId, seededFromRunId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  humanTasks        HumanTask[]
  aiWorkAssignments AiWorkAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, objectiveVersionId])
  @@index([tenantId, objectiveId])
  @@map("objective_workflow_drafts")
}

/// A unit of human work, created when a workflow is approved and assigned.
///
/// The field list is the client's own To-do UI list: task, Objective, Assigned By, input,
/// due/trigger, expected output, evidence, dependencies, approval. Everything a person needs to
/// do the work is on the row, so the To-do screen is not a join across five tables — and so the
/// task still reads correctly after the objective moves to a new version.
///
/// One task per workflow node per version, enforced by a unique index. That is what makes
/// Approve & Assign safe to retry: a second attempt cannot create a second copy of somebody's
/// work.
model HumanTask {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  objectiveVersionId String @map("objective_version_id") @db.Uuid
  /// The draft this was assigned from, kept so "what plan created this task?" stays answerable.
  workflowDraftId    String @map("workflow_draft_id") @db.Uuid
  /// The graph node. Stable within a draft, which is what makes the uniqueness rule meaningful.
  nodeId             String @map("node_id") @db.VarChar(80)

  /// What the person is asked to do. The node's label.
  title String @db.VarChar(300)

  assignedToUserId String @map("assigned_to_user_id") @db.Uuid
  /// The client's "Assigned By". The person who ran Approve & Assign, never a system name.
  assignedByUserId String @map("assigned_by_user_id") @db.Uuid

  /// The client's "input": what the person works from, and where it comes from.
  inputDescription String @default("") @map("input_description") @db.VarChar(2000)

  /// The client's "due/trigger" — deliberately both. Real work is often triggered by an event
  /// rather than a clock, and a task with no due time is never reported as overdue.
  dueAt              DateTime? @map("due_at") @db.Timestamptz(6)
  triggerDescription String    @default("") @map("trigger_description") @db.VarChar(300)

  expectedOutput String @default("") @map("expected_output") @db.VarChar(2000)

  /// What proves the work happened. When this is non-empty, submitting without evidence is
  /// refused — the Executor Agent's "Missing Completion Evidence" exception, prevented rather
  /// than reported.
  evidenceRequirement String @default("") @map("evidence_requirement") @db.VarChar(2000)

  /// Node ids this task waits on. Node ids rather than task ids: the plan expresses dependencies
  /// between steps, and a step may not have produced a task at all.
  dependsOnNodeIds String[] @map("depends_on_node_ids")

  /// The approval this step requires, from its Definition of Done. Null when none.
  approvalKind String? @map("approval_kind") @db.VarChar(40)

  status String @default("Assigned") @db.VarChar(40)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Why the person cannot proceed. Cleared when they resume; a blocked task must say why.
  blockedReason String? @map("blocked_reason") @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite (ADR-064): a task can never belong to another company's objective.
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  objectiveVersion ObjectiveVersion @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)

  /// `NoAction`: the plan that assigned this work is part of its record.
  workflowDraft ObjectiveWorkflowDraft @relation(fields: [tenantId, workflowDraftId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  evidence HumanTaskEvidence[]
  notes    HumanTaskNote[]

  /// One task per node per version. What makes Approve & Assign safe to retry.
  @@unique([tenantId, objectiveVersionId, nodeId])
  /// So children can carry a same-tenant composite key.
  @@unique([tenantId, id])
  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, dueAt])
  @@map("human_tasks")
}

/// Evidence attached to a task.
///
/// A description and an optional reference, **not** a stored file: no prompt has specified file
/// storage for task evidence, and inventing an upload path would create a place for company
/// documents to live that nothing else in the product governs. The reference is where the
/// evidence actually is — a document id, a run id, a system of record.
model HumanTaskEvidence {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  taskId   String @map("task_id") @db.Uuid

  description String @db.VarChar(2000)
  /// Where the evidence lives. Free text on purpose: it names systems UBoss does not own.
  reference   String @default("") @db.VarChar(500)

  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   HumanTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, taskId])
  @@map("human_task_evidence")
}

/// A comment or a request for clarification on a task.
///
/// The client lists "Comment/Clarify" as one action with two meanings, and they are worth keeping
/// apart: a clarification is a question somebody is waiting on an answer to, and that is what
/// moves a task to `NeedsInput`.
model HumanTaskNote {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  taskId   String @map("task_id") @db.Uuid

  kind String @db.VarChar(40)
  body String @db.VarChar(4000)

  authorUserId String   @map("author_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int      @default(1) @map("row_version")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   HumanTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, taskId])
  @@map("human_task_notes")
}

/// An AI node's assignment.
///
/// The client's instruction is "AI nodes -> assigned Agent Builder setup **OR** existing approved
/// reusable Engine Agent mapping". This row is that decision, recorded. It never creates an
/// Engine Agent: the locked rule is that recurring work creates Runs, and the relationship is
/// Agent -> Assignment -> Run. This is the Assignment.
model AiWorkAssignment {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  objectiveVersionId String @map("objective_version_id") @db.Uuid
  workflowDraftId    String @map("workflow_draft_id") @db.Uuid
  nodeId             String @map("node_id") @db.VarChar(80)

  title String @db.VarChar(300)

  status String @default("AwaitingAgentSetup") @db.VarChar(40)

  /// The Engine Agent performing this work: an existing reusable one it was mapped to, or the
  /// one activation created for it. A same-tenant composite key, declared now that the table
  /// exists — the CHECK tying this column to the status stays, because the key proves the agent
  /// is real while the CHECK proves the row is not claiming a mapping it does not have.
  engineAgentId String? @map("engine_agent_id") @db.Uuid

  /// The execution setup Agent Builder collected — an `AgentExecutionSetup`. Null until somebody
  /// opens the builder; every field inside it is independently nullable, because "not yet
  /// answered" is the state the zero-question rule reads.
  executionSetup Json? @map("execution_setup") @db.JsonB

  /// The last controlled test, so the screen can report it. Deliberately not a gate on
  /// activation: the source document requires readiness, and does not make a passed test part of
  /// it. Inventing that gate would block work the client never said to block.
  lastTestedAt    DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestPassed  Boolean?  @map("last_test_passed")
  lastTestSummary String?   @map("last_test_summary") @db.VarChar(2000)
  /// False whenever the test ran against the mock gateway, which is what ships today. Stored so
  /// no screen and no report can present a mock result as a real provider run.
  lastTestWasReal Boolean?  @map("last_test_was_real")

  /// What the Agent Builder screen already knows, so it can ask only what is genuinely missing.
  /// Its shape is `AgentSetupPrefill`.
  setupPrefill Json @map("setup_prefill") @db.JsonB

  assignedByUserId String @map("assigned_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective        Objective              @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)
  objectiveVersion ObjectiveVersion       @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)
  workflowDraft    ObjectiveWorkflowDraft @relation(fields: [tenantId, workflowDraftId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  engineAgent      EngineAgent?           @relation(fields: [tenantId, engineAgentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, objectiveVersionId, nodeId])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("ai_work_assignments")
}

/// An approval waiting on somebody. **The** approvals table, for every domain.
///
/// The client's requirement is approvals and notifications "without duplicating separate approval
/// tables per module", so this is created generic at the first prompt that needs a queue rather
/// than as an objective-specific table that a later prompt would have to replace.
/// `APPROVAL_REQUEST_TYPES` already carries the full list the Approval Engine prompt names; that
/// prompt adds delegation, separation-of-duties wiring, aging and the queue UI to this row.
///
/// Objective context is columns with composite keys, because that is what this prompt creates and
/// same-tenant integrity is worth having. Domains that are not objectives use `subjectType` and
/// `subjectId`, which cannot carry a foreign key and so are validated by their own service.
model ApprovalRequest {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `APPROVAL_REQUEST_TYPES`.
  type   String @db.VarChar(40)
  status String @default("Pending") @db.VarChar(40)

  title  String @db.VarChar(300)
  detail String @default("") @db.VarChar(4000)

  /// For a domain with no columns here. `subjectType` is the module's own word for the thing.
  subjectType String  @map("subject_type") @db.VarChar(60)
  subjectId   String? @map("subject_id") @db.Uuid

  objectiveId        String? @map("objective_id") @db.Uuid
  objectiveVersionId String? @map("objective_version_id") @db.Uuid
  workflowNodeId     String? @map("workflow_node_id") @db.VarChar(80)

  requestedByUserId String @map("requested_by_user_id") @db.Uuid

  /// The named approver, when the plan named one. Null means the approval is by role, and the
  /// Approval Engine prompt resolves who that is.
  namedApproverUserId String? @map("named_approver_user_id") @db.Uuid
  /// The role expected to decide, e.g. `Manager` or `Head`, from the step's Definition of Done.
  approverRoleKind    String? @map("approver_role_kind") @db.VarChar(40)

  dueAt DateTime? @map("due_at") @db.Timestamptz(6)

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?   @map("decision_note") @db.VarChar(4000)

  /// Set when the person who decided was standing in for the named approver under an
  /// out-of-office delegation. Recorded separately from `decidedByUserId` because "the deputy
  /// decided it" and "the approver decided it" are different facts, and an audit that cannot
  /// tell them apart cannot answer the only question anybody asks about a delegated approval.
  decidedOnBehalfOfUserId String? @map("decided_on_behalf_of_user_id") @db.Uuid

  /// Escalation raises visibility. It never decides: an approval that happens because nobody
  /// looked is not an approval, so nothing in this system approves on a timer.
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz(6)
  escalatedToUserId String?   @map("escalated_to_user_id") @db.Uuid

  /// The request this one replaces, when a sent-back item was corrected and resubmitted.
  ///
  /// A settled request is never reopened — its decision record is immutable — so a resubmission
  /// is a new row pointing back at the old one. That keeps the chain readable without any row
  /// ever changing its verdict.
  supersedesId String? @map("supersedes_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  objective        Objective?        @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)
  objectiveVersion ObjectiveVersion? @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)

  /// NO ACTION rather than SET NULL: nulling a composite FK nulls every referencing column,
  /// `tenant_id` included, which would strip the row out of its own tenant (ADR-064).
  supersedes   ApprovalRequest?  @relation("ApprovalSupersession", fields: [tenantId, supersedesId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy ApprovalRequest[] @relation("ApprovalSupersession")

  decisions ApprovalDecisionRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  @@unique([tenantId, id])
  @@index([tenantId, status, type])
  @@index([tenantId, namedApproverUserId, status])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, approverRoleKind, status])
  @@map("approval_requests")
}

/// One thing somebody did to an approval request: approved it, rejected it, sent it back, or
/// commented on it.
///
/// **This is the client's "immutable decision record", and it is a table rather than a column
/// because a decision is an event, not a state.** `ApprovalRequest.status` says where the request
/// ended up; these rows say how it got there, who said what, and when. A trigger refuses UPDATE
/// and DELETE, so the history cannot be tidied up after the fact — a record that can be edited
/// afterwards is not evidence.
///
/// It also carries the four-eyes evidence. The Approval Engine reads the distinct actors here and
/// passes them to `checkSeparationOfDuties` as `priorActorUserIds`, which is how a `FourEyes`
/// control becomes enforceable without a second policy engine: the rule already knows that the
/// actor must not be the creator and must not be alone.
model ApprovalDecisionRecord {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId          String @map("tenant_id") @db.Uuid
  approvalRequestId String @map("approval_request_id") @db.Uuid

  /// From `APPROVAL_DECISIONS`: Approve, Reject, SendBack or Comment.
  decision String @db.VarChar(20)

  actorUserId String @map("actor_user_id") @db.Uuid

  /// The named approver this actor was standing in for, under a delegation.
  onBehalfOfUserId String? @map("on_behalf_of_user_id") @db.Uuid
  /// Which delegation authorised the stand-in, so it can be produced on request.
  delegationId     String? @map("delegation_id") @db.Uuid

  /// Required on a refusal. An author who is told only "rejected" cannot tell what to change.
  note String @default("") @db.VarChar(4000)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, approvalRequestId, occurredAt])
  @@index([tenantId, actorUserId])
  @@map("approval_decisions")
}

/// One person's temporary delegation of their approval authority while they are away.
///
/// **A delegation moves routing, never authority.** The delegate still passes the same
/// authorization check on the same module and still faces the same separation-of-duties
/// controls: somebody who cannot approve agent activations does not gain that power by being
/// delegated to, and somebody who raised the request cannot decide it by having it delegated to
/// them. That is why this table carries no permissions of any kind.
///
/// Bounded in time by a check constraint, because an open-ended delegation is indistinguishable
/// from a permanent grant and the client asked for out-of-office cover, not a quiet reassignment.
model ApprovalDelegation {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  fromUserId String @map("from_user_id") @db.Uuid
  toUserId   String @map("to_user_id") @db.Uuid

  /// Empty means every type. Stored as a list rather than one row per type so that revoking the
  /// arrangement is one write — a half-revoked delegation is exactly the state nobody wants.
  types String[] @map("types") @db.VarChar(40)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  reason String @db.VarChar(300)

  /// Revocation is immediate, not at `endsAt`: somebody who comes back early means now.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, fromUserId, startsAt, endsAt])
  @@index([tenantId, toUserId])
  @@map("approval_delegations")
}

/// Something the Executor Agent is told to watch, registered when work is assigned.
///
/// Registered at publish rather than inferred later, because an expectation nobody recorded
/// cannot be reported as unmet: a task with no recorded due time can never be "overdue", and a
/// step whose evidence requirement was never written down can never be "missing evidence".
///
/// `kind` is named after the Executor Agent prompt's own exception types so that prompt consumes
/// these rather than deriving a second list from the workflow.
model ExecutorExpectation {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  objectiveVersionId String @map("objective_version_id") @db.Uuid
  nodeId             String @map("node_id") @db.VarChar(80)

  /// From `EXECUTOR_EXPECTATION_KINDS`.
  kind String @db.VarChar(60)

  /// What the expectation is about: `HumanTask`, `AiWorkAssignment` or `ApprovalRequest`.
  subjectType String  @map("subject_type") @db.VarChar(60)
  subjectId   String? @map("subject_id") @db.Uuid

  /// In words, so an exception can quote what was expected rather than a bare code.
  detail String @db.VarChar(2000)

  /// When the expectation comes due, for the kinds that have a time.
  dueAt DateTime? @map("due_at") @db.Timestamptz(6)

  /// Set when the expectation was met, so the Executor stops watching it.
  satisfiedAt DateTime? @map("satisfied_at") @db.Timestamptz(6)

  registeredByUserId String   @map("registered_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int      @default(1) @map("row_version")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective        Objective        @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)
  objectiveVersion ObjectiveVersion @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, objectiveVersionId, nodeId, kind])
  @@index([tenantId, kind, satisfiedAt])
  @@map("executor_expectations")
}

/// A reusable Engine Agent — the identity that performs assigned AI work.
///
/// The locked lifecycle rule lives here: **recurring work does not create a new Agent every day.**
/// The relationship is reusable Agent → Jobs/Assignments → individual Runs, so an agent is created
/// once, at activation, and the work that recurs hangs off it as Runs. A second agent for the same
/// job would split its history, its cost and its health across two identities.
///
/// Created by Agent Builder's *Activate*, per the source document: "Creates/activates the reusable
/// Engine Agent when readiness is satisfied." The registry, versioning UI and the operational
/// action set are a later prompt; they extend this identity rather than introducing another.
model EngineAgent {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Business identity. Unique per company because it is how people refer to the agent; two
  /// agents called the same thing is the state that makes an operations screen unreadable.
  name String @db.VarChar(200)

  /// The employee this agent was built **for**, when somebody built it on their behalf — Prompt
  /// 40A (CR-03) §2.
  ///
  /// ## The only new column here, because four of the five roles already existed
  ///
  /// CR-03 asks that creator/configurator, operator, owner, approver and activator be tracked
  /// distinctly. Most of that was already true: `createdByUserId` is the creator,
  /// `updatedByUserId` with `updatedAt` is the configurator, `ownerUserId` is the accountable
  /// owner, `activatedByUserId` is the activator, and the approver lives on the
  /// `ApprovalRequest` where approval decisions have always lived. Adding parallel columns would
  /// have been a second answer to questions this row already answers.
  ///
  /// What was genuinely missing is the **operator** — and it needed a table rather than a column,
  /// because an agent can be run by several people (a rota, holiday cover). That is
  /// `EngineAgentOperator`.
  ///
  /// This column is the remaining gap: *who was it built for*. Recorded rather than inferred from
  /// the operator list, because "who was this for" and "who may run it" are different questions —
  /// an agent may be built for one person and later shared with their team, and the original
  /// intent is what explains its design.
  ///
  /// **Setting this grants nothing.** Being the assigned employee lets somebody run the agent, via
  /// the operator table and the seven run preconditions; it never gives them Agent Builder. That
  /// separation is the point of the whole amendment.
  builtForUserId String? @map("built_for_user_id") @db.Uuid

  /// The accountable business owner. Never nullable: an agent nobody owns is an agent nobody
  /// answers for when it goes wrong.
  ownerUserId String @map("owner_user_id") @db.Uuid

  status String @default("DraftSetup") @db.VarChar(40)

  /// Which governed memory mode this agent declares. Prompt 33 enforces retention, visibility,
  /// deletion and sharing limits; this records what is to be enforced. Defaults to the only mode
  /// that persists nothing, so an agent cannot keep information before the governance exists.
  memoryMode String @default("CurrentRunOnly") @map("memory_mode") @db.VarChar(40)

  /// The machine-readable schedule, as a five-field cron expression. Null means this agent is
  /// not scheduled — including an agent whose configuration says `Scheduled` but whose trigger
  /// was only ever recorded as free text. The registry reports that as needing input rather than
  /// guessing a cron from a phrase like "Monday 10:30".
  scheduleCron String? @map("schedule_cron") @db.VarChar(120)

  /// Overrides the company setting for this agent. Null means follow the company.
  missedRunPolicy String? @map("missed_run_policy") @db.VarChar(20)
  overlapPolicy   String? @map("overlap_policy") @db.VarChar(20)

  /// Operational visibility, maintained by the scheduler and the run engine.
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt    DateTime? @map("next_run_at") @db.Timestamptz(6)
  /// Set when an agent is paused, so an operations screen can say why rather than only that it
  /// stopped. Cleared on resume.
  pausedReason String?   @map("paused_reason") @db.VarChar(500)

  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid

  /// The version whose configuration is in force. Null only between creation and its first
  /// version, which the activation transaction closes.
  currentVersionId String? @map("current_version_id") @db.Uuid

  activatedAt       DateTime? @map("activated_at") @db.Timestamptz(6)
  activatedByUserId String?   @map("activated_by_user_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    EngineAgentVersion[]
  operators   EngineAgentOperator[]
  assignments AiWorkAssignment[]
  runs        AgentRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("engine_agents")
}

/// One immutable configuration of an Engine Agent.
///
/// The versioning rule is the same one the whole product uses: a published version is frozen, and
/// an authorized change creates a new draft rather than rewriting what is live. It is declared at
/// this prompt rather than the registry prompt on purpose — retrofitting immutability onto a table
/// that has already stored mutable rows means migrating history that was never trustworthy.
///
/// `config` holds the `AgentExecutionSetup` together with the Skill versions and the derived
/// approval and evidence settings: everything needed to run the agent, in one frozen record, so a
/// Run can always say which configuration produced it.
model EngineAgentVersion {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  engineAgentId String @map("engine_agent_id") @db.Uuid

  versionNumber Int @map("version_number")

  /// `Draft` or `Published`. Kept as a string for the same reason as every other status in this
  /// schema: the vocabulary belongs to the shared types package, not to a database enum that
  /// needs a migration to extend.
  status String @default("Draft") @db.VarChar(20)

  config Json @db.JsonB

  /// What would change if this draft were activated — an `AgentVersionImpact`. Null on the first
  /// version, which changes nothing because there was nothing before it.
  impact Json? @db.JsonB

  /// Whether activating this draft needs an approval rather than the owner's say-so, and the
  /// reasons. Computed when the draft is created, stored so a reviewer sees the same answer the
  /// service will enforce.
  approvalRequired Boolean @default(false) @map("approval_required")

  /// The controlled test of this configuration, before activation.
  testedAt    DateTime? @map("tested_at") @db.Timestamptz(6)
  testPassed  Boolean?  @map("test_passed")
  /// False for a mock run. Stored so no report can present mock output as a real provider result.
  testWasReal Boolean?  @map("test_was_real")

  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  EngineAgent @relation(fields: [tenantId, engineAgentId], references: [tenantId, id], onDelete: Cascade)
  runs   AgentRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, engineAgentId, versionNumber])
  @@index([tenantId, engineAgentId, status])
  @@map("engine_agent_versions")
}

/// One execution of an Engine Agent.
///
/// **The row exists before the work does.** The architecture is explicit: "All scheduled/event
/// work creates a durable Run record before execution." That ordering is the whole design — a
/// crashed worker leaves a run somebody can find and resolve, rather than work that silently
/// never happened. The queue is transport; this table is the truth, and a WebSocket update is a
/// convenience that never replaces it.
///
/// `engine_agent_version_id` is not decoration either. A run cites the exact configuration that
/// produced it, and that version is immutable, so "what settings produced this output?" stays
/// answerable for as long as the run is kept.
model AgentRun {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  engineAgentId        String @map("engine_agent_id") @db.Uuid
  /// The immutable configuration this run used.
  engineAgentVersionId String @map("engine_agent_version_id") @db.Uuid

  /// The assigned work this run performs. Null for a run started directly against the agent.
  aiWorkAssignmentId String? @map("ai_work_assignment_id") @db.Uuid
  /// Denormalised for scoping and reporting: a run has to be findable by objective without
  /// walking to the assignment, and the assignment may be null.
  objectiveId        String? @map("objective_id") @db.Uuid

  state   String @default("Queued") @db.VarChar(40)
  trigger String @db.VarChar(20)

  /// Stops one occurrence becoming two runs. Two scheduler ticks that notice the same due moment
  /// compute the same key, and the unique index below refuses the second.
  idempotencyKey String @map("idempotency_key") @db.VarChar(300)

  /// Threaded through the API, the queue, this run and every provider call it makes.
  correlationId String @map("correlation_id") @db.VarChar(80)

  attempt     Int @default(1)
  maxAttempts Int @default(3) @map("max_attempts")

  /// Set when an attempt fails: whether trying again could ever help.
  retryability String? @db.VarChar(30)

  /// The moment this occurrence was due, for a scheduled run.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)

  /// When budget was set aside. A run reaches `Running` only through `Reserved`.
  reservedAt DateTime? @map("reserved_at") @db.Timestamptz(6)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  /// 0-100, or null when the work cannot report a fraction honestly.
  percent         Int?    @db.SmallInt
  progressMessage String? @map("progress_message") @db.VarChar(500)

  output        Json?   @db.JsonB
  /// Every non-completed ending says why, in words a person can act on.
  failureReason String? @map("failure_reason") @db.VarChar(2000)

  /// False whenever the work ran against the mock gateway. Stored so no report can present mock
  /// output as a real provider result.
  producedByRealModel Boolean? @map("produced_by_real_model")

  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid

  /// Set when every attempt is spent. The dead-letter path preserves context and raises an
  /// Executor exception rather than dropping the work.
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  startedByUserId String?  @map("started_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        EngineAgent        @relation(fields: [tenantId, engineAgentId], references: [tenantId, id], onDelete: Cascade)
  agentVersion EngineAgentVersion @relation(fields: [tenantId, engineAgentVersionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  events       AgentRunEvent[]
  memory       MemoryRecord[]
  feedback     AiOutputFeedback[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, engineAgentId, createdAt])
  @@index([tenantId, state])
  @@index([tenantId, correlationId])
  @@map("agent_runs")
}

/// The durable history of one run.
///
/// Exists so live progress is a convenience rather than the record. A client that missed a
/// WebSocket message re-reads these and loses nothing; a run that ended while nobody was watching
/// still has its whole story. Append-only by intent — nothing updates an event.
model AgentRunEvent {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  runId    String @map("run_id") @db.Uuid

  /// The state the run entered, or null for a progress update inside a state.
  state String? @db.VarChar(40)

  percent Int?   @db.SmallInt
  message String @db.VarChar(500)
  attempt Int    @default(1)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    AgentRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, runId, occurredAt])
  @@map("agent_run_events")
}

/// One thing the Executor Agent found that needs somebody.
///
/// Distinct from `ExecutorExpectation`, which is what the Executor is *watching for*. A company
/// needs both answers separately: "what are we monitoring?" and "what needs action now?"
///
/// The source task or run is recorded by type and id rather than by foreign key, because an
/// exception can arise from a human task, an agent run, a connection or an approval, and a column
/// per source would be four nullable keys where three are always null. The type says which table
/// to look in, and a CHECK keeps the pair honest.
model ExecutorException {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  kind     String @db.VarChar(60)
  severity String @db.VarChar(20)
  state    String @default("Open") @db.VarChar(20)

  /// Where it came from: `HumanTask`, `AgentRun`, `Connection`, `ApprovalRequest`.
  sourceType String @map("source_type") @db.VarChar(40)
  sourceId   String @map("source_id") @db.Uuid

  /// Denormalised so the Exception Center can filter by objective and agent without four joins.
  objectiveId   String? @map("objective_id") @db.Uuid
  engineAgentId String? @map("engine_agent_id") @db.Uuid

  /// What went wrong, in words a person can act on.
  detail String @db.VarChar(2000)

  /// What the Executor observed. The evidence a resolver needs, not a stack trace.
  evidence Json? @db.JsonB

  /// Who has it now. Null when routing could not name an individual — the kind's default owner
  /// is shown instead, which is an honest "we know whose kind of problem this is".
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// How many times the underlying work has been attempted, carried from the run.
  attempts Int @default(1)

  /// The escalation window in hours, resolved from severity and company policy when raised, so a
  /// later policy change cannot retroactively make a past exception look overdue.
  escalationHours Int @map("escalation_hours")

  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz(6)
  /// Who it escalated to. Attributed, because "it was escalated" with no destination is not a
  /// route, it is a shrug.
  escalatedToUserId String?   @map("escalated_to_user_id") @db.Uuid

  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  closeReason    String?   @map("close_reason") @db.VarChar(2000)

  /// The expectation this exception came from, where one was being watched.
  expectationId String? @map("expectation_id") @db.Uuid

  /// Stops one condition raising the same exception on every sweep.
  dedupeKey String @map("dedupe_key") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ExecutorExceptionEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, state, severity])
  @@index([tenantId, kind, state])
  @@index([tenantId, engineAgentId])
  @@map("executor_exceptions")
}

/// The resolution history of one exception.
///
/// Append-only, like the run event log and the audit trail, and for the same reason: it is the
/// record of who did what about a problem, and a history that can be edited afterwards is not
/// evidence. The client asks for "resolution history" as a first-class field, so it is a table
/// rather than a JSON blob nobody can query.
model ExecutorExceptionEvent {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  exceptionId String @map("exception_id") @db.Uuid

  /// The resolution action taken, or null for a state change with no action behind it.
  action String? @db.VarChar(40)
  /// The state the exception entered.
  state  String  @db.VarChar(20)

  /// Null when the Executor Agent acted rather than a person. Read together with `byExecutor`,
  /// so "nobody" and "the machine" are never the same value.
  actorUserId String? @map("actor_user_id") @db.Uuid
  byExecutor  Boolean @default(false) @map("by_executor")

  note String @db.VarChar(2000)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exception ExecutorException @relation(fields: [tenantId, exceptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, exceptionId, occurredAt])
  @@map("executor_exception_events")
}

/// One configured AI provider.
///
/// **Configuration, never business object identity.** Technical Architecture §18: "Provider names
/// are configuration, not business object identity." Nothing in a company workspace reads a row
/// from this table — an Objective, an Engine Agent and a Run all name a `LogicalModelProfile`, and
/// the gateway resolves that to a profile here at the moment of the call.
///
/// `tenantId` is null for a platform profile every company may be routed through (UBoss Managed),
/// and set for a company's own BYOK account or custom enterprise endpoint. The fourth instance of
/// the nullable-tenant pattern, after skills, policy rules and separation-of-duties policies.
model ProviderProfile {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a UBoss-managed platform profile; set for a company's own.
  tenantId String? @map("tenant_id") @db.Uuid

  /// From `PROVIDER_KINDS`. Platform-plane only.
  kind String @db.VarChar(40)
  /// From `PROVIDER_MODES`.
  mode String @db.VarChar(40)

  label String @db.VarChar(120)

  /// From `PROVIDER_LIFECYCLE_STATES`.
  lifecycle String  @default("Active") @db.VarChar(30)
  enabled   Boolean @default(true)

  // ---- Custom Enterprise Provider configuration ----
  // Null for a first-party adapter, which has its own endpoint compiled in.

  baseUrl        String? @map("base_url") @db.VarChar(500)
  authType       String? @map("auth_type") @db.VarChar(30)
  authHeaderName String? @map("auth_header_name") @db.VarChar(120)

  /// A `SecretsVault` handle. **Never a credential.** The vault is the same one connections use.
  secretRef String? @map("secret_ref") @db.VarChar(200)

  timeoutMs Int? @map("timeout_ms")

  /// Where the token counts live in this provider's response, so actual usage is read rather
  /// than estimated. An estimate recorded as measured usage is a fabrication.
  usageInputPath       String? @map("usage_input_path") @db.VarChar(200)
  usageOutputPath      String? @map("usage_output_path") @db.VarChar(200)
  usageCachedInputPath String? @map("usage_cached_input_path") @db.VarChar(200)

  /// Where the provider's own request id lives, so a support ticket can quote it.
  requestIdPath String? @map("request_id_path") @db.VarChar(200)

  /// The last Test Connection result. `lastTestReachedProvider` is the field that matters: a
  /// configuration that validates is not a provider that answered.
  lastTestedAt            DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestOk              Boolean?  @map("last_test_ok")
  lastTestReachedProvider Boolean?  @map("last_test_reached_provider")
  lastTestDetail          String?   @map("last_test_detail") @db.VarChar(1000)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  models ProviderModel[]
  calls  ModelGatewayCall[]

  @@index([tenantId, enabled])
  @@index([kind, lifecycle])
  @@map("provider_profiles")
}

/// One model a provider profile can answer with.
///
/// `providerModelRef` is the vendor's own model string and is **platform-plane**: it never
/// appears in a tenant-facing response. `capability` is the opaque label that does —
/// e.g. `high-reasoning-v1` — and it is what a fallback of the same capability is compared on.
model ProviderModel {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId          String? @map("tenant_id") @db.Uuid
  providerProfileId String  @map("provider_profile_id") @db.Uuid

  /// The vendor's model identifier. Configuration. For a custom endpoint this is the model ID
  /// sent in the request body.
  providerModelRef String @map("provider_model_ref") @db.VarChar(200)

  /// An opaque capability label. **Never a provider or model name** — a company reads this.
  capability String @db.VarChar(80)

  /// From `PROVIDER_LIFECYCLE_STATES`. `MigrationRequired` is refused for new work.
  lifecycle String  @default("Active") @db.VarChar(30)
  enabled   Boolean @default(true)

  /// Set when the lifecycle last moved, so a deprecation has a date somebody can act on.
  lifecycleChangedAt DateTime? @map("lifecycle_changed_at") @db.Timestamptz(6)
  lifecycleNote      String?   @map("lifecycle_note") @db.VarChar(500)

  /// The provider's own request limit for this model, per minute — Prompt 40.
  ///
  /// Null means "not declared", which is honest and common: most contracts state a limit nobody
  /// transcribes. When it is null UBoss throttles **reactively** instead, learning the limit from
  /// the 429s the provider sends (`ProviderThrottleService`). Declaring it is better, because
  /// respecting a limit is cheaper than discovering it — a discovered limit costs one refused
  /// call each time, and a refused call still spends a customer's wait.
  quotaRequestsPerMinute Int? @map("quota_requests_per_minute")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  routes  LogicalModelRoute[]
  pricing PricingVersionRow[]
  calls   ModelGatewayCall[]

  @@index([tenantId, lifecycle])
  @@index([providerProfileId, enabled])
  @@map("provider_models")
}

/// Which models answer a logical profile, in preference order.
///
/// This table is the whole seam. A business object stores `OBJECTIVE_PLANNER`; this says what
/// that currently means, and changing it changes nothing about the business object.
model LogicalModelRoute {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for the platform default route every company inherits; set for a company override.
  tenantId String? @map("tenant_id") @db.Uuid

  /// From `LOGICAL_MODEL_PROFILES`. One of exactly five.
  profile String @db.VarChar(40)

  providerModelId String @map("provider_model_id") @db.Uuid

  /// Lower is preferred. Anything after the most preferred is a fallback, and whether it may be
  /// used is decided by the profile's own fallback policy.
  preference Int @default(0)

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Cascade)

  @@index([tenantId, profile, preference])
  @@map("logical_model_routes")
}

/// One immutable pricing version for one model.
///
/// **Versioned rather than edited.** A gateway call cites the pricing version that priced it, so a
/// price change cannot retroactively restate what a Run cost. Prompt 30's ledger builds on these.
///
/// Named `PricingVersionRow` in Prisma because `PricingVersion` is the shared type in
/// `@uboss/types` and having both mean the same thing under one name across two layers is how a
/// DTO quietly becomes a database row.
model PricingVersionRow {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId        String? @map("tenant_id") @db.Uuid
  providerModelId String  @map("provider_model_id") @db.Uuid

  /// Monotonic per model.
  versionNumber Int @map("version_number")

  currency String @db.VarChar(3)

  /// Per **million** tokens, in integer minor units. Per million because a per-token price in
  /// minor units rounds to zero for every model in existence.
  inputPerMillionMinorUnits       Int  @map("input_per_million_minor_units")
  outputPerMillionMinorUnits      Int  @map("output_per_million_minor_units")
  /// Null means this provider does not price cached input separately — **not** that it is free.
  cachedInputPerMillionMinorUnits Int? @map("cached_input_per_million_minor_units")

  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  /// Null while this is the current version.
  supersededAt  DateTime? @map("superseded_at") @db.Timestamptz(6)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model  ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Cascade)

  calls ModelGatewayCall[]

  @@unique([providerModelId, versionNumber])
  @@index([providerModelId, supersededAt])
  @@map("pricing_versions")
}

/// One call through the Model Gateway, with the provider's own request id and exact usage.
///
/// The prompt's requirement: "Record provider request ID and exact usage when available." Both
/// halves matter — the request id is what a support ticket quotes, and the usage is what Prompt
/// 30's ledger settles against.
///
/// **This is not the cost ledger.** It records what the provider did; the ledger records what the
/// company was charged. Keeping them separate is what lets a reconciliation job compare the two.
///
/// Append-only by trigger. `producedByRealModel` travels with every row for the same reason it
/// travels with every `ModelResponse`: a report that presented mock output as a model's judgement
/// would be the fabrication the client's rules forbid.
model ModelGatewayCall {
  id String @id @default(uuid(7)) @db.Uuid

  /// Always set: a call is always attributable to one company.
  tenantId String @map("tenant_id") @db.Uuid

  /// From `LOGICAL_MODEL_PROFILES`. What the caller asked for.
  profile String @db.VarChar(40)
  /// What the call was for, e.g. `objective.analysis.detect-human-work`.
  purpose String @db.VarChar(200)

  /// Null when routing failed, which is itself worth recording.
  providerProfileId String? @map("provider_profile_id") @db.Uuid
  providerModelId   String? @map("provider_model_id") @db.Uuid
  pricingVersionId  String? @map("pricing_version_id") @db.Uuid

  /// The opaque capability that answered. Safe to show a company.
  capability String @db.VarChar(80)

  /// True when the profile's preferred model was not the one used.
  usedFallback Boolean @default(false) @map("used_fallback")

  /// The provider's own id for this request, when it gave one.
  providerRequestId String? @map("provider_request_id") @db.VarChar(200)

  /// The correlation id of the request that caused this call — Prompt 39.
  ///
  /// Nullable, because a call made by a scheduled sweep has no originating request. Indexed with
  /// the tenant so "what did this click actually spend" is one query.
  correlationId String? @map("correlation_id") @db.VarChar(80)

  inputTokens       Int @default(0) @map("input_tokens")
  outputTokens      Int @default(0) @map("output_tokens")
  cachedInputTokens Int @default(0) @map("cached_input_tokens")

  /// Priced from the cited pricing version. Null when nothing was priced.
  costMinorUnits Int?    @map("cost_minor_units")
  currency       String? @db.VarChar(3)

  /// **Never true for a mock adapter.** Stored, not inferred.
  producedByRealModel Boolean @default(false) @map("produced_by_real_model")

  /// `Succeeded`, `Failed` or `Unroutable`.
  outcome String @db.VarChar(30)
  /// Safe to show. Never a credential and never a raw provider error body.
  detail  String @default("") @db.VarChar(2000)

  latencyMs Int? @map("latency_ms")

  /// So a run's spend can be attributed without joining through the ledger.
  agentRunId String? @map("agent_run_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile?   @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  providerModel   ProviderModel?     @relation(fields: [providerModelId], references: [id], onDelete: SetNull)
  pricingVersion  PricingVersionRow? @relation(fields: [pricingVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, profile, occurredAt])
  @@index([tenantId, agentRunId])
  @@index([tenantId, correlationId])
  @@map("model_gateway_calls")
}

/// One budget at one level of the hierarchy.
///
/// Section 20's budget model is "Commercial allowance -> Company AI Budget -> Department/Cost
/// Center -> Objective Budget -> Agent/Run Limit". The commercial allowance sits above this table
/// — it is what the customer bought and lives on the subscription — and each of the four levels
/// below it is a row here.
///
/// ## Why the balance columns exist when the ledger is the source of truth
///
/// `usedMinor` and `reservedMinor` are maintained, not derived. Deriving them would mean summing
/// the whole ledger inside every pre-run check, and — worse — there would be no single row to
/// lock, so two concurrent reservations could each sum the same ledger and each decide there was
/// room. The maintained balance is what `SELECT ... FOR UPDATE` takes hold of.
///
/// The cost of maintaining them is that they can drift from the ledger. That is what
/// `reconcileBalance` and the reconciliation job exist for, and section 20 asks for the job by
/// name. Drift is reported, never silently corrected.
model BudgetWallet {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `BUDGET_SCOPES`.
  scope String @db.VarChar(20)

  /// The department, objective or engine agent this budget is for. Null at the company level,
  /// which is the one level every company has exactly one of.
  subjectId String? @map("subject_id") @db.Uuid

  currency String @db.VarChar(3)

  /// What this level may spend. Moved only by a ledger entry.
  allowanceMinor Int @default(0) @map("allowance_minor")
  /// Settled spend. Moved only by a ledger entry.
  usedMinor      Int @default(0) @map("used_minor")
  /// Currently held by live reservations. Moved only by a ledger entry.
  reservedMinor  Int @default(0) @map("reserved_minor")

  /// When the current period began, for the projected-exhaustion rate.
  periodStart DateTime  @map("period_start") @db.Timestamptz(6)
  /// Section 20's "next reset". Null for a one-off allowance that does not recur.
  resetsAt    DateTime? @map("resets_at") @db.Timestamptz(6)
  /// Section 20's "expiry". Null when the allowance does not expire.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reservations BudgetReservation[]
  entries      CostLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, scope])
  @@map("budget_wallets")
}

/// An amount set aside before a provider call, so concurrent agents cannot overspend the same
/// remaining balance.
///
/// Section 20's Estimate/Reserve step, and the reason it exists in the document's own words. One
/// reservation covers one run's one call and holds against **every** level of the hierarchy at
/// once — the rows in `budget_reservation_holds` are what make that true, because a reservation
/// that only held against the company budget would let an objective quietly exceed its own.
///
/// `Held` is the only state that counts. The other three record *why* it stopped counting, which
/// is what makes an overspend investigation possible: expired means the engine lost a run,
/// released means the run finished cheaply.
model BudgetReservation {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The company-level wallet this reservation is anchored to. Every reservation has one, which
  /// is what makes "how much is this company holding" a single query.
  walletId String @map("wallet_id") @db.Uuid

  /// From `RESERVATION_STATES`.
  state String @default("Held") @db.VarChar(20)

  /// The pessimistic estimate that was set aside.
  estimateMinor Int    @map("estimate_minor")
  currency      String @db.VarChar(3)

  /// What was actually charged, once the provider reported its usage. Null while held.
  settledMinor Int? @map("settled_minor")

  /// What the reservation was for. Nullable because a call can be raised outside a run — an
  /// Objective analysis has no run and still costs money.
  agentRunId     String? @map("agent_run_id") @db.Uuid
  objectiveId    String? @map("objective_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  engineAgentId  String? @map("engine_agent_id") @db.Uuid
  /// From `LOGICAL_MODEL_PROFILES`. Never a provider name (ADR-144).
  logicalProfile String  @map("logical_profile") @db.VarChar(40)
  purpose        String  @db.VarChar(200)

  /// The gateway call this settled against, so the ledger and the provider record agree.
  modelGatewayCallId String? @map("model_gateway_call_id") @db.Uuid

  heldAt      DateTime  @default(now()) @map("held_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason String?   @map("close_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet BudgetWallet @relation(fields: [tenantId, walletId], references: [tenantId, id], onDelete: Cascade)

  holds   BudgetReservationHold[]
  entries CostLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, state, heldAt])
  @@index([tenantId, agentRunId])
  @@map("budget_reservations")
}

/// One reservation's hold against one level of the hierarchy.
///
/// A reservation holds against the company budget *and* the department *and* the objective *and*
/// the agent, all at once. Without a row per level, an objective could be taken past its own
/// budget by runs that each fitted inside the company's — which is the hierarchy section 20
/// describes doing nothing at all.
model BudgetReservationHold {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  walletId      String @map("wallet_id") @db.Uuid

  amountMinor Int @map("amount_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation BudgetReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([reservationId, walletId])
  @@index([tenantId, walletId])
  @@map("budget_reservation_holds")
}

/// The immutable ledger.
///
/// Section 20: "Preserve every credit purchase, addition, adjustment, reallocation, deduction,
/// refund/release and approval with who, amount, reason, time, source/reference and resulting
/// balance." Every one of those is a column here, and the table is append-only by trigger.
///
/// `Reserve` and `ReleaseReserve` entries are written even though they net to zero across a run.
/// Omitting them would make the balance unexplainable at any moment *during* a run, and "why does
/// this say we have less than the sum of our spends" is the first question anybody asks.
///
/// `balanceAfter*` is section 20's "resulting balance", stored rather than recomputed: it is what
/// lets a statement be read row by row without replaying everything above it, and what makes a
/// drift visible at the exact entry where it began.
model CostLedgerEntry {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  walletId String @map("wallet_id") @db.Uuid

  /// From `LEDGER_ENTRY_KINDS`.
  kind String @db.VarChar(30)

  /// Signed. A reallocation out of one budget and into another is two entries of the same kind
  /// with opposite signs, rather than two kinds that have to stay in step.
  amountMinor Int    @map("amount_minor")
  currency    String @db.VarChar(3)

  /// Section 20's "resulting balance", as at this entry.
  balanceAfterAllowanceMinor Int @map("balance_after_allowance_minor")
  balanceAfterUsedMinor      Int @map("balance_after_used_minor")
  balanceAfterReservedMinor  Int @map("balance_after_reserved_minor")

  /// Section 20's "who". Null for an entry the engine wrote on its own behalf — a settle, a
  /// release — which is honest: no person did those.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// Section 20's "reason".
  reason String @db.VarChar(500)

  /// Section 20's "source/reference": an invoice number, a top-up request, a run.
  reference String? @db.VarChar(200)

  reservationId String? @map("reservation_id") @db.Uuid

  /// The correlation id of the request that caused this entry — Prompt 39. The end of the chain:
  /// one identifier now links a click to the money it spent.
  correlationId String? @map("correlation_id") @db.VarChar(80)

  /// Everything section 20 requires a run's ledger row to carry. Denormalised on purpose: the
  /// document says "historical cost/usage remains attached to the original run even after
  /// pricing, provider or plan changes", and a join would follow the *current* configuration.
  agentRunId        String? @map("agent_run_id") @db.Uuid
  objectiveId       String? @map("objective_id") @db.Uuid
  departmentId      String? @map("department_id") @db.Uuid
  engineAgentId     String? @map("engine_agent_id") @db.Uuid
  logicalProfile    String? @map("logical_profile") @db.VarChar(40)
  pricingVersionId  String? @map("pricing_version_id") @db.Uuid
  inputTokens       Int?    @map("input_tokens")
  outputTokens      Int?    @map("output_tokens")
  cachedInputTokens Int?    @map("cached_input_tokens")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet      BudgetWallet       @relation(fields: [tenantId, walletId], references: [tenantId, id], onDelete: Cascade)
  /// NO ACTION, not SET NULL: nulling a composite FK nulls every referencing column including
  /// `tenant_id`, which would strip the entry out of its own tenant (ADR-064). A reservation is
  /// never deleted anyway — it is settled, released or expired.
  reservation BudgetReservation? @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, walletId, occurredAt])
  @@index([tenantId, agentRunId])
  @@index([tenantId, kind, occurredAt])
  @@index([tenantId, correlationId])
  @@map("cost_ledger_entries")
}

/// A Company Admin asking for more AI credit.
///
/// The prompt's "Request / Buy More Credits", and Finance's "review request / Approve & Add
/// Credits / Adjust Amount / Reject with reason".
///
/// **"Adjust Amount" is not a separate state.** It produces the same outcome as an approval — an
/// approval for some amount — and the amount approved is recorded apart from the amount asked
/// for, so a fifth state would let two rows describe the same thing.
model CreditRequest {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `CREDIT_REQUEST_STATES`.
  state String @default("Submitted") @db.VarChar(20)

  /// What the company asked for, in integer minor units.
  requestedMinor Int    @map("requested_minor")
  currency       String @db.VarChar(3)

  /// Why they need it. Finance records this as the reason the credits were added, so it is
  /// required — a blank one leaves the trail unexplained.
  reason String @db.VarChar(1000)

  /// From `BILLING_CHOICES`. Null when the plan does not offer the choice — the prompt's
  /// "billing choice **where enabled**". **No payment is taken anywhere in this flow:** the value
  /// records an intent so Finance knows what was agreed.
  billingChoice String? @map("billing_choice") @db.VarChar(30)

  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)

  // ---- Finance's decision ----

  /// The platform operator who decided. The prompt's "operator".
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  /// Required on a rejection; optional on an approval, whose justification is the request's own
  /// reason plus the reference.
  decisionNote    String?   @map("decision_note") @db.VarChar(1000)

  /// What was actually granted — may differ from `requestedMinor`, which is "Adjust Amount".
  approvedMinor Int? @map("approved_minor")

  /// The prompt's "effective date, optional expiry, reason, invoice/reference".
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  reference     String?   @db.VarChar(200)

  /// The grant this approval created, so the request and the money are one click apart.
  grantId String? @map("grant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  grants CreditGrant[]

  @@unique([tenantId, id])
  @@index([tenantId, state, requestedAt])
  @@map("credit_requests")
}

/// One lot of credit, with its own effective date and optional expiry.
///
/// ## Why credit is granted in lots rather than as one number
///
/// **Top-up expiry forces it.** "This forty thousand expires on 31 March" cannot be expressed by a
/// single `allowance_minor`, because expiring it means knowing which part of the allowance it
/// was. A grant is that part.
///
/// Carry-forward and plan changes fall out of the same model: carrying forward is a grant that
/// survives a reset, and a plan change is a grant added or reduced with a reason. The wallet's
/// `allowance_minor` stays the running total, moved only by ledger entries — a grant does not
/// replace it, it explains it.
model CreditGrant {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  walletId String @map("wallet_id") @db.Uuid

  /// From `GRANT_SOURCES`. Enough to answer "why does this company have this money" without
  /// conflating a purchase with a promotion.
  source String @db.VarChar(30)

  amountMinor Int    @map("amount_minor")
  currency    String @db.VarChar(3)

  /// A grant that has not started is not counted, which is what makes a future-dated top-up safe
  /// to approve: the company sees it coming and cannot spend it early.
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)

  /// Set when the expiry has been written off to the ledger, so the sweep cannot charge it twice.
  writtenOffAt DateTime? @map("written_off_at") @db.Timestamptz(6)

  /// Withdrawn before expiry — a payment failure after a top-up, or a correction.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason") @db.VarChar(500)

  reason    String  @db.VarChar(500)
  /// An invoice number or contract reference.
  reference String? @db.VarChar(200)

  creditRequestId String? @map("credit_request_id") @db.Uuid

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request CreditRequest? @relation(fields: [tenantId, creditRequestId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, walletId, effectiveFrom])
  @@index([tenantId, expiresAt])
  @@map("credit_grants")
}

/// One company's commercial credit policy.
///
/// UBoss_Final_1 line 1048 requires these to be **defined**: "Define monthly reset, carry-forward
/// policy, top-up expiry, refunds/promotional/manual adjustments, plan change mid-cycle, payment
/// failure after top-up and negative-balance policy. Every commercial adjustment remains
/// auditable." No value is stated for any of them, so each is configured here with a documented
/// default — a commercial term compiled into the product is one the client cannot change without
/// a release.
model CompanyCreditPolicy {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid

  /// From `RESET_POLICIES`.
  resetPolicy String @default("MonthlyReset") @map("reset_policy") @db.VarChar(30)

  /// From `CARRY_FORWARD_POLICIES`. Defaults to `Forfeit`: the strict reading of a monthly
  /// allowance, and carrying forward by default would quietly hand a customer more than their
  /// contract says.
  carryForwardPolicy   String @default("Forfeit") @map("carry_forward_policy") @db.VarChar(30)
  carryForwardCapMinor Int?   @map("carry_forward_cap_minor")

  /// Null means a purchased top-up does not expire. **The one default that could not be defended
  /// otherwise** — expiring money somebody paid for, unasked, is not a safe default.
  defaultTopUpExpiryDays Int? @map("default_top_up_expiry_days")

  /// From `NEGATIVE_BALANCE_POLICIES`.
  negativeBalancePolicy     String @default("BlockImmediately") @map("negative_balance_policy") @db.VarChar(30)
  negativeBalanceGraceMinor Int    @default(0) @map("negative_balance_grace_minor")

  /// From `PLAN_CHANGE_POLICIES`. Defaults to `NextCycle`, which does not disturb a cycle
  /// already in progress; the other two change what a customer can spend today.
  planChangePolicy String @default("NextCycle") @map("plan_change_policy") @db.VarChar(30)

  /// The prompt's "billing choice **where enabled**".
  billingChoiceEnabled Boolean @default(true) @map("billing_choice_enabled")

  /// When the current period began and when it next rolls over.
  periodStart DateTime  @map("period_start") @db.Timestamptz(6)
  nextResetAt DateTime? @map("next_reset_at") @db.Timestamptz(6)

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("company_credit_policies")
}

// ---------------------------------------------------------------------------
// Prompt 33 — Engine Agent memory and AI output feedback
// ---------------------------------------------------------------------------

/// One company's governed behaviour for one memory mode.
///
/// ## Why a row per mode rather than columns on one row
///
/// §27.1 requires that **for each mode** UBoss define retention, visibility, deletion,
/// cross-user/objective sharing limits, sensitive-data restrictions and offboarding behaviour.
/// Four modes times six settings as columns on a single row would be twenty-four columns whose
/// names all end in a mode, and adding a setting would mean four more. A row per mode is the shape
/// the requirement actually has.
///
/// The defaults live in `DEFAULT_MEMORY_POLICIES` and the service writes them explicitly on first
/// read, for the reason Prompt 31 learned: a governance default declared both in the types package
/// and in a migration is one that can drift with nothing to notice.
model MemoryPolicyRow {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `AGENT_MEMORY_MODES`. A string rather than an enum for the same reason as every other
  /// status in this schema: the vocabulary belongs to the shared types package.
  mode String @db.VarChar(40)

  /// Null only for `ApprovedLongTermMemory`, enforced by a check constraint — a record that never
  /// expires under a mode that is not the approved one is retention nobody governed.
  retentionDays Int? @map("retention_days")

  /// From `MEMORY_VISIBILITIES`, and never wider than the mode's ceiling.
  visibility String @db.VarChar(30)

  /// From `DATA_CLASSIFICATIONS`. The most sensitive class this mode may persist at all — §19's
  /// "sensitive data classification controls whether a memory record can be persisted".
  maxClassification String @default("Internal") @map("max_classification") @db.VarChar(20)

  allowCrossUser      Boolean @default(false) @map("allow_cross_user")
  allowCrossObjective Boolean @default(false) @map("allow_cross_objective")

  /// From `MEMORY_OFFBOARDING_BEHAVIOURS`.
  offboardingBehaviour String @default("DeleteOnOffboarding") @map("offboarding_behaviour") @db.VarChar(30)

  /// True for `ApprovedLongTermMemory`, enforced by a check constraint. A long-term memory nobody
  /// approved is not what the mode is called.
  requiresApproval Boolean @default(false) @map("requires_approval")

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, mode])
  @@map("memory_policies")
}

/// A thing an Engine Agent remembered.
///
/// The Technical Architecture's `memory_records`: *"agent/objective scope, owner, classification,
/// content reference, retention/expiry"* — transcribed rather than invented.
///
/// ## The scope columns are the enforcement
///
/// `visibility` is copied from the policy **at write time**, not read from the policy at read
/// time. That is deliberate: a company narrowing Agent Memory from `SameAgent` to `SameObjective`
/// must not retroactively change what an existing record was written under, and a read that joined
/// to the current policy would do exactly that. A record carries the rule it was created with,
/// which is also what makes "why was this visible?" answerable months later.
///
/// **No cross-tenant memory is structurally impossible here**, not merely forbidden: the table is
/// tenant-owned with `FORCE ROW LEVEL SECURITY`, and `run_id` carries a composite foreign key
/// including `tenant_id` (ADR-064), so a record cannot even reference another company's run.
model MemoryRecord {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `AGENT_MEMORY_MODES` — the mode in force when this was written.
  mode String @db.VarChar(40)

  /// From `MEMORY_VISIBILITIES`, copied from the policy at write time. See the note above.
  visibility String @db.VarChar(30)

  /// The run that produced it. A memory record has a provenance or it has none.
  runId String @map("run_id") @db.Uuid

  /// Required for `ObjectiveMemory`, enforced by a check constraint: a record whose visibility is
  /// "the same Objective" and which has no Objective has no scope to be visible in.
  objectiveId String? @map("objective_id") @db.Uuid

  engineAgentId String @map("engine_agent_id") @db.Uuid

  /// Whose memory it is. Null after anonymisation on offboarding, and for a record that belongs to
  /// the agent rather than to a person.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// From `DATA_CLASSIFICATIONS`.
  classification String @default("Internal") @db.VarChar(20)

  /// A short label a person can read on a governance screen, e.g. "Preferred supplier for X".
  label String @db.VarChar(200)

  /// The remembered content. JSON so a structured fact and a paragraph are the same column.
  ///
  /// **Nulled when a record is deleted or expires**, so a deletion is a deletion rather than a
  /// tombstone with the data still in it. The row survives with its scope and its dates, because
  /// "what was deleted, when and why" is a governance question.
  content Json? @db.JsonB

  /// The approval that permitted an `ApprovedLongTermMemory` write. A verified id, not a claim.
  approvalRequestId String? @map("approval_request_id") @db.Uuid

  /// Null means it does not expire — only legitimate for `ApprovedLongTermMemory`, enforced by a
  /// check constraint against `mode`.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    AgentRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, engineAgentId, visibility, expiresAt])
  @@index([tenantId, objectiveId, expiresAt])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, expiresAt])
  @@map("memory_records")
}

/// A person's judgement of an AI output.
///
/// The Technical Architecture's `feedback`: *"run/output, rating, correction/evidence, reviewer,
/// evaluation eligibility"*.
///
/// ## One rating per reviewer per run
///
/// Enforced by a unique index. Two ratings from one person would count twice in the quality
/// figures, which is the number this table exists to produce. Amending is an update to the
/// existing row; what the reviewer previously thought is on the audit trail rather than here,
/// because this table answers "what does this reviewer think", not "what did they once think".
///
/// ## `produced_by_real_model` is copied, not joined
///
/// Prompt 29's rule is that a result always carries whether a real model produced it. Copying the
/// flag here means a quality figure computed from this table alone can never present mock output
/// as a provider's — and a report that joined to the run to find out would be one refactor away
/// from dropping the join.
model AiOutputFeedback {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  runId String @map("run_id") @db.Uuid

  /// From `FEEDBACK_RATINGS`.
  rating String @db.VarChar(30)

  /// What is wrong and what it should have said. Required for every rating but `Correct`,
  /// enforced by a check constraint — a bare "Incorrect" tells an agent's owner that something
  /// failed and nothing about what.
  correction String? @db.VarChar(4000)

  /// Where the reviewer's answer comes from. Optional even for `Incorrect`: §27.1 says
  /// "correction/evidence", not "correction and evidence".
  evidence String? @db.VarChar(4000)

  reviewerUserId String @map("reviewer_user_id") @db.Uuid

  /// False for a mock-model result. Copied from the run — see the note above.
  producedByRealModel Boolean? @map("produced_by_real_model")

  /// Whether this feedback could become an evaluation case, and why not where it could not.
  evaluationEligible Boolean @default(false) @map("evaluation_eligible")
  evaluationReason   String? @map("evaluation_reason") @db.VarChar(500)

  /// Set when somebody with `skills:EditDraft` turned this into a regression case. **Promotion is
  /// a separate act**: a regression case is a permanent assertion about how a Skill must behave,
  /// and an employee's rating is not that.
  promotedCaseId   String?   @map("promoted_case_id") @db.Uuid
  promotedAt       DateTime? @map("promoted_at") @db.Timestamptz(6)
  promotedByUserId String?   @map("promoted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    AgentRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, runId, reviewerUserId])
  @@index([tenantId, runId])
  @@index([tenantId, rating])
  @@index([tenantId, evaluationEligible, promotedAt])
  @@map("ai_output_feedback")
}

// ---------------------------------------------------------------------------
// Prompt 34 — Objective completion, outcome review and archive
// ---------------------------------------------------------------------------

/// The formal Outcome Review of a finished Objective.
///
/// ## It compares; it does not measure
///
/// Every figure here is **already recorded by the module that owns it** — Form 2 for the expected
/// result and the target, `human_tasks` for effort, the Prompt 30 ledger for AI cost,
/// `executor_exceptions` for unresolved items. What this row adds is the part that exists nowhere
/// else: the *actual* result, which is a judgement somebody makes, plus the verdict and the
/// sign-off.
///
/// ## Why the compared figures are snapshotted
///
/// A review read live would change after it was signed: a late cost settlement or a reopened
/// exception would silently alter what somebody put their name to. §27.1 asks for a *formal*
/// closure, and a signed document whose contents move is not one. The live figures stay available
/// beside the snapshot, so a drift between them is visible rather than hidden.
///
/// ## One review per objective version
///
/// Not per objective. An objective that is reopened under the versioning rule becomes a new Draft
/// version, and that version gets its own review when it finishes — the old one stays exactly as
/// it was signed. A unique index on (tenant, version) enforces it.
model ObjectiveOutcomeReview {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  objectiveId        String @map("objective_id") @db.Uuid
  /// The immutable live version this review is *of*. What was actually agreed and executed.
  objectiveVersionId String @map("objective_version_id") @db.Uuid

  /// From `OUTCOME_VERDICTS`.
  verdict String @db.VarChar(30)

  /// What actually happened, in the reviewer's words. The one field with no other source.
  actualResult String @map("actual_result") @db.VarChar(4000)

  /// Required for every verdict but a clean `Met`, enforced by a check constraint — a
  /// "partially met" with no explanation is a grade rather than a review.
  explanation String? @db.VarChar(4000)

  /// From `SLA_OUTCOMES`, computed at review time from Form 2's target and the completion date.
  slaOutcome String @map("sla_outcome") @db.VarChar(20)
  daysLate   Int?   @map("days_late")

  /// The compared figures, frozen at the moment of review. Shaped as `OutcomeComparison`.
  comparison Json @db.JsonB

  /// From `CLOSURE_SIGN_OFF_POLICIES` — the policy **in force when the review was written**, not
  /// the company's current one. A closure judged under last quarter's rule stays judged under it.
  signOffPolicy String @map("sign_off_policy") @db.VarChar(30)

  reviewedByUserId String   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  signedOffByUserId String?   @map("signed_off_by_user_id") @db.Uuid
  signedOffAt       DateTime? @map("signed_off_at") @db.Timestamptz(6)

  /// A verified, approved request id where the policy needed one. Not a boolean claim (ADR-160).
  approvalRequestId String? @map("approval_request_id") @db.Uuid

  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective        Objective        @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)
  objectiveVersion ObjectiveVersion @relation(fields: [tenantId, objectiveVersionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, objectiveVersionId])
  @@index([tenantId, objectiveId])
  @@index([tenantId, verdict])
  @@index([tenantId, closedAt])
  @@map("objective_outcome_reviews")
}

/// One pause of a live Objective, and its resume.
///
/// ## Why a table rather than two columns on the objective
///
/// §27.1 asks for "controlled" pause and resume, and the control is the record: who paused it, why,
/// and for how long. Two nullable columns on `objectives` would hold only the *current* pause, so
/// an objective paused four times in a quarter would look as though it had been paused once — and
/// "how much of this quarter did this work spend stopped" is the question a delivery review asks.
///
/// A resume closes the open row. At most one may be open at a time, enforced by a partial unique
/// index — two open pauses would make "is this paused?" a question with two answers.
model ObjectivePause {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  objectiveId String @map("objective_id") @db.Uuid

  /// From `PAUSE_REASONS`. A category as well as the text, so a list of paused objectives is
  /// readable at a glance.
  reasonKind String @map("reason_kind") @db.VarChar(40)
  reason     String @db.VarChar(1000)

  pausedByUserId String   @map("paused_by_user_id") @db.Uuid
  pausedAt       DateTime @default(now()) @map("paused_at") @db.Timestamptz(6)

  resumedByUserId String?   @map("resumed_by_user_id") @db.Uuid
  resumedAt       DateTime? @map("resumed_at") @db.Timestamptz(6)
  resumeNote      String?   @map("resume_note") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective Objective @relation(fields: [tenantId, objectiveId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, objectiveId, pausedAt])
  @@map("objective_pauses")
}

// ---------------------------------------------------------------------------
// Prompt 35 — Knowledge, files, data classification and safe uploads
// ---------------------------------------------------------------------------

/// An uploaded file: **metadata and a storage reference, never the bytes.**
///
/// The Technical Architecture's `files` store: *"tenant, classification, storage ref, scan status,
/// retention policy"*. The same rule as `secret_ref` in §22, and for the same reason — a database
/// that holds the content becomes the thing that has to be encrypted, scanned, backed up and
/// deleted, and it is the wrong place for all four.
///
/// ## Nothing reads a file that has not been scanned clean
///
/// §22: uploads pass validation and malware scanning **before use**. `scan_state` starts at
/// `Pending` and only `Clean` is usable — enforced in `fileIsUsable`, at every read path, and by
/// `usable_file_was_scanned_clean` which refuses a row claiming to be available while unscanned.
model StoredFile {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The name as uploaded, kept for display. Never used to build a storage path.
  filename    String @db.VarChar(400)
  contentType String @map("content_type") @db.VarChar(160)
  sizeBytes   Int    @map("size_bytes")

  /// **Where the content lives, not the content.** An opaque key the storage adapter understands.
  /// Nulled when the content is deleted, which is how a deletion is distinguishable from a record
  /// that never had content.
  storageRef String? @map("storage_ref") @db.VarChar(500)

  /// SHA-256 of the uploaded bytes, hex. Lets a duplicate upload be recognised and gives a
  /// deletion something to prove it removed the right thing.
  contentHash String? @map("content_hash") @db.VarChar(64)

  /// From `FILE_SCAN_STATES`.
  scanState  String    @default("Pending") @map("scan_state") @db.VarChar(20)
  scannedAt  DateTime? @map("scanned_at") @db.Timestamptz(6)
  /// What the scanner said. Free text: it names a product UBoss does not own.
  scanResult String?   @map("scan_result") @db.VarChar(500)
  /// **False for the mock scanner.** The same rule as `produced_by_real_model`: a compliance
  /// report must never present an unscanned file as scanned by a real product.
  scannedByRealScanner Boolean? @map("scanned_by_real_scanner")

  /// From `DATA_CLASSIFICATIONS`.
  classification String @default("Internal") @db.VarChar(20)

  /// Retention, from `RETENTION_ACTIONS`. Null expiry means it is kept until somebody deletes it.
  retentionAction    String    @default("DeleteContent") @map("retention_action") @db.VarChar(30)
  retentionExpiresAt DateTime? @map("retention_expires_at") @db.Timestamptz(6)

  /// **A legal hold beats everything** — retention, and an explicit request from an administrator.
  /// A hold that could be overridden by the policy it was placed against would not be one.
  onLegalHold      Boolean   @default(false) @map("on_legal_hold")
  legalHoldReason  String?   @map("legal_hold_reason") @db.VarChar(500)
  legalHoldPlacedAt DateTime? @map("legal_hold_placed_at") @db.Timestamptz(6)
  legalHoldPlacedByUserId String? @map("legal_hold_placed_by_user_id") @db.Uuid

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedReason String?   @map("deleted_reason") @db.VarChar(500)
  deletedByUserId String? @map("deleted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  knowledgeFiles KnowledgeSourceFile[]

  // ---- Prompt 40A (CR-03): a photo and a chat attachment are both just files ----
  employeePhotos  EmployeePhoto[]
  chatAttachments ChatMessageAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, scanState])
  @@index([tenantId, classification])
  @@index([tenantId, retentionExpiresAt])
  @@index([tenantId, onLegalHold])
  @@map("files")
}

/// An approved collection an Engine Agent may consult.
///
/// §Settings: *"approved knowledge sources, classification/retention policy where available"*. A
/// source is **named, approved and scoped** — not a folder. The approval and the access scope
/// belong to the source, and a file can be in more than one.
///
/// ## Why the classification is on the source as well as on each file
///
/// It is the *ceiling the source was approved at*. A source approved to hold `Internal` material
/// that later acquires a `Confidential` file is a source whose approval no longer covers its
/// contents — and a check constraint on the join table refuses exactly that, rather than letting
/// the source quietly become more sensitive than anybody agreed to.
model KnowledgeSource {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  name        String @db.VarChar(200)
  description String @default("") @db.VarChar(2000)

  /// From `KNOWLEDGE_SOURCE_KINDS`.
  kind String @db.VarChar(30)

  /// From `KNOWLEDGE_SOURCE_STATES`. Nothing consults a source that is not `Approved`.
  state String @default("Draft") @db.VarChar(20)

  /// From `KNOWLEDGE_ACCESS_SCOPES`. Defaults to the strictest.
  accessScope String @default("NamedAgentsOnly") @map("access_scope") @db.VarChar(30)

  /// Required when the scope is `Department`, enforced by a check constraint — a department
  /// source with no department has no scope to be visible in.
  departmentId String? @map("department_id") @db.Uuid

  /// The agents named on it. Bare uuids rather than a join table: the list is short, it is read
  /// whole on every access decision, and a row per agent would be three joins for one boolean.
  namedAgentIds String[] @map("named_agent_ids") @db.Uuid

  /// The most sensitive class this source is approved to hold.
  classification String @default("Internal") @db.VarChar(20)

  /// For `Connection` sources: which connection it reads. Composite FK, same company.
  connectionId String? @map("connection_id") @db.Uuid

  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredReason    String?   @map("retired_reason") @db.VarChar(500)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// **NO ACTION, not SET NULL.** A composite FK set to SET NULL nulls *every* referencing
  /// column — including `tenant_id`, which is NOT NULL — so deleting a connection a source
  /// referenced failed outright with a not-null violation. Refusing the delete is the correct
  /// behaviour anyway: retire the knowledge source first (ADR-204).
  connection Connection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: NoAction)

  files KnowledgeSourceFile[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, state])
  @@index([tenantId, accessScope])
  @@map("knowledge_sources")
}

/// Which files are in which source.
///
/// A join table rather than a column on the file, because a file legitimately belongs to more than
/// one source — the same contract can be in "Supplier agreements" and in "Q3 legal review".
model KnowledgeSourceFile {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  knowledgeSourceId String @map("knowledge_source_id") @db.Uuid
  fileId            String @map("file_id") @db.Uuid

  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [tenantId, knowledgeSourceId], references: [tenantId, id], onDelete: Cascade)
  file   StoredFile      @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, knowledgeSourceId, fileId])
  @@index([tenantId, fileId])
  @@map("knowledge_source_files")
}

/// The company's file and knowledge policy.
///
/// §27.1 asks for retention, legal hold, deletion/export and data-residency choices "governed by
/// plan/company policy" and states no values, so each is configured here with a documented,
/// conservative default — the same shape as the Prompt 31 commercial policy and the Prompt 33
/// memory policy.
model CompanyKnowledgePolicy {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid

  maxUploadBytes      Int      @default(52428800) @map("max_upload_bytes")
  allowedContentTypes String[] @map("allowed_content_types")

  /// Default retention applied to a new file. Null keeps files until somebody deletes them —
  /// deleting a company's documents on a schedule nobody set is the most damaging possible
  /// default.
  defaultRetentionDays   Int?   @map("default_retention_days")
  defaultRetentionAction String @default("DeleteContent") @map("default_retention_action") @db.VarChar(30)

  /// The two ceilings §22 asks for. Export is within the company; egress leaves it.
  exportCeiling String @default("Confidential") @map("export_ceiling") @db.VarChar(20)
  /// **Nothing above `Internal` leaves the company by default.** The strictest default here:
  /// too strict costs a settings change, too loose costs a confidential document in somebody
  /// else's system.
  externalEgressCeiling String @default("Internal") @map("external_egress_ceiling") @db.VarChar(20)

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("company_knowledge_policies")
}


/// A support ticket.
///
/// §Support & Operations: *"Tickets, support access requests, issue history, service incidents and
/// operational notes."* A ticket belongs to a company — it is raised by their people and about
/// their use of UBoss — so it is tenant-scoped and under RLS like everything else they own.
///
/// ## Why a ticket cannot grant access
///
/// `AccessRequest` is a ticket *kind*, not a second access mechanism. A company asking UBoss to
/// look at something is a conversation; the access that may follow is a break-glass session, which
/// carries its own reason, scope, expiry and approval. `BreakGlassRequest.support_ticket_id` links
/// them in that direction and never the other, so no amount of ticket activity can widen access.
model SupportTicket {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// Sequential per company, so people can say "ticket 14" rather than reading a uuid aloud.
  reference Int @map("reference")

  subject String @db.VarChar(300)
  body    String @db.VarChar(8000)

  /// From `SUPPORT_TICKET_KINDS`.
  kind String @db.VarChar(30)
  /// From `SUPPORT_PRIORITIES`. The company's view of urgency, deliberately not an incident P-level.
  priority String @default("Normal") @db.VarChar(20)
  /// From `SUPPORT_TICKET_STATES`.
  state String @default("New") @db.VarChar(30)

  /// Who raised it. A person in the company, never a platform operator: a ticket an operator
  /// invented on a customer's behalf would put words in their mouth.
  raisedByUserId String @map("raised_by_user_id") @db.Uuid

  /// The UBoss operator who owns it. Null until somebody picks it up.
  assignedOperatorUserId String? @map("assigned_operator_user_id") @db.Uuid

  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// Required once resolved, by check constraint: "fixed" with no explanation is not an answer.
  resolutionNote String?   @map("resolution_note") @db.VarChar(4000)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)

  /// The declared incident this ticket turned out to be about, when it was one. Lets an
  /// operator answer "how many companies did this outage affect" without reading every ticket.
  ///
  /// It points at `service_alerts`, which is where an incident lives — see that model's comment.
  serviceAlertId String? @map("service_alert_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Single-column SET NULL, which is safe: unlike a composite key it nulls only this column.
  incident ServiceAlert? @relation(fields: [serviceAlertId], references: [id], onDelete: SetNull)

  notes    SupportTicketNote[]
  sessions BreakGlassRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, reference])
  @@index([tenantId, state])
  @@index([state, priority])
  @@index([assignedOperatorUserId, state])
  @@map("support_tickets")
}

/// A reply on a ticket, or an operational note about it.
///
/// One table with a flag rather than two, because replies and notes interleave in time and a
/// reader needs them in order. **`isInternal` defaults to true**: a note is private unless
/// somebody deliberately shares it, because the opposite default leaks an operator's working
/// notes to a customer the first time anybody forgets.
model SupportTicketNote {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId        String @map("tenant_id") @db.Uuid
  supportTicketId String @map("support_ticket_id") @db.Uuid

  body String @db.VarChar(8000)

  /// True for an operational note between UBoss people; false for a reply the company sees.
  isInternal Boolean @default(true) @map("is_internal")

  authorUserId String  @map("author_user_id") @db.Uuid
  /// True when the author is UBoss rather than the company. Recorded rather than derived,
  /// because a person can leave the platform and the note still has to say who side it came from.
  authorIsOperator Boolean @default(false) @map("author_is_operator")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket SupportTicket @relation(fields: [tenantId, supportTicketId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, supportTicketId, createdAt])
  @@map("support_ticket_notes")
}


/// A company's exit from UBoss — Prompt 38.
///
/// One row per exit, carrying the whole seven-step lifecycle: who asked, who approved, the three
/// dates, what was exported, what was deleted and by whom. **It is itself an accountability
/// record** — `TABLE_DISPOSITION` classifies it as such — so the row survives the deletion it
/// describes. A deletion certificate that was deleted along with the data would be worthless.
///
/// ## Why this is not a second lifecycle
///
/// `tenant_lifecycle_transitions` (Prompt 11) already moves a company between `Active`,
/// `ReadOnly` and `Closed`, on a schedule, with a reason and a history. This row is the
/// **request and approval wrapper** around that machinery plus the parts it had no need for: the
/// export, the retention window, the selective deletion and the certificate. The exit *drives*
/// the lifecycle service; it does not duplicate it.
///
/// ## One open exit at a time
///
/// A partial unique index refuses a second unfinished exit for the same company. Two open exits
/// would mean two answers to "when is our data deleted", and the one a screen happened to read
/// would win.
model CompanyExit {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `EXIT_STATES`.
  state String @default("Requested") @db.VarChar(20)

  /// Why the contract is ending. Mandatory: an exit nobody explained cannot be reviewed, and this
  /// is the field a dispute is argued from.
  reason String @db.VarChar(2000)

  /// Who asked. A platform operator or a company administrator — both are legitimate, and which
  /// it was matters, so it is recorded rather than inferred.
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// True when the company asked to leave rather than UBoss ending the contract.
  requestedByCustomer Boolean @default(false) @map("requested_by_customer")

  /// **Never the requester.** A check constraint refuses it: ending a customer's contract and
  /// approving that decision are two people, the same rule as break-glass and every other
  /// high-risk act in this product.
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvalNote     String?   @map("approval_note") @db.VarChar(1000)

  /// The windows in force **when this exit was approved**, stored rather than read from settings
  /// later. A company told "your data is deleted on 14 March" must not see that date move because
  /// somebody changed a default.
  readOnlyDays  Int @default(30) @map("read_only_days")
  retentionDays Int @default(30) @map("retention_days")

  /// The three dates, computed once at approval.
  readOnlyFrom          DateTime? @map("read_only_from") @db.Timestamptz(6)
  retentionFrom         DateTime? @map("retention_from") @db.Timestamptz(6)
  deletionEligibleFrom  DateTime? @map("deletion_eligible_from") @db.Timestamptz(6)

  /// When the export package was last produced, and how many rows it carried. The package itself
  /// is not stored: it is generated on request and handed to the customer.
  exportedAt      DateTime? @map("exported_at") @db.Timestamptz(6)
  exportedByUserId String?  @map("exported_by_user_id") @db.Uuid
  exportedRowCount Int?     @map("exported_row_count")

  /// The deletion certificate — step 7. Written by the deletion itself.
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId    String?   @map("deleted_by_user_id") @db.Uuid
  /// How many rows were removed, per table, as recorded at the time. **The evidence.** A
  /// certificate that said only "deleted" would be unfalsifiable; this can be read against the
  /// classification and checked.
  deletionManifest   Json?     @map("deletion_manifest")
  deletedRowCount    Int?      @map("deleted_row_count")
  /// How many rows were deliberately kept, and under which disposition.
  preservedRowCount  Int?      @map("preserved_row_count")

  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid
  /// Required on a cancellation: stopping an exit is as consequential as starting one.
  cancellationReason String?  @map("cancellation_reason") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1) @map("row_version")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([state, deletionEligibleFrom])
  @@map("company_exits")
}


/// One entry in an incident's timeline — Prompt 39.
///
/// §30 asks for a *"timeline"*, and a timeline is **what an operator wrote**, not a reconstruction
/// from state changes. The state changes are already in the audit trail; what an audit trail
/// cannot produce is the narrative — "we thought it was the database, it was the connection pool"
/// — and that narrative is what a postmortem is written from.
///
/// Append-only by convention rather than by privilege: correcting a timeline entry during an
/// incident is legitimate, and a new entry saying so is better than an edit that hides the first
/// reading. There is deliberately no update route.
///
/// Platform-plane, like `service_alerts` itself. An incident is UBoss's, not a customer's.
model IncidentTimelineEntry {
  id String @id @default(uuid(7)) @db.Uuid

  serviceAlertId String @map("service_alert_id") @db.Uuid

  /// From `TIMELINE_KINDS`.
  kind String @db.VarChar(20)

  /// What happened, in the operator's own words. Mandatory: an empty timeline entry is a timestamp
  /// nobody can read.
  note String @db.Text

  /// When it happened, which is **not** when it was written. An operator catching up after an
  /// outage backfills entries, and a timeline that only knew when it was typed would misreport
  /// the sequence of the thing it exists to explain.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  authorUserId String   @map("author_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident ServiceAlert @relation(fields: [serviceAlertId], references: [id], onDelete: Cascade)

  @@index([serviceAlertId, occurredAt])
  @@map("incident_timeline_entries")
}

/// A corrective action from a postmortem — Prompt 39.
///
/// **Owned and dated, or it is a wish.** The commonest failure of an incident process is a
/// postmortem full of actions nobody agreed to do, so both fields are mandatory and a check
/// constraint enforces it. An action may be `Dropped` deliberately — with a reason — but it
/// cannot be left ownerless.
model CorrectiveAction {
  id String @id @default(uuid(7)) @db.Uuid

  serviceAlertId String @map("service_alert_id") @db.Uuid

  description String @db.VarChar(2000)

  /// From `CORRECTIVE_ACTION_STATES`.
  state String @default("Open") @db.VarChar(20)

  /// Mandatory. An unowned action is not an action.
  ownerUserId String   @map("owner_user_id") @db.Uuid
  dueOn       DateTime @map("due_on") @db.Date

  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  /// Required when dropped: deciding not to do something is a decision, and it needs a reason
  /// more than doing it does.
  outcomeNote       String?   @map("outcome_note") @db.VarChar(2000)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  incident ServiceAlert @relation(fields: [serviceAlertId], references: [id], onDelete: Cascade)

  @@index([serviceAlertId, state])
  @@index([state, dueOn])
  @@map("corrective_actions")
}

/// A remembered response to a mutating request — Prompt 40.
///
/// ## Why the response body is stored and not just the key
///
/// The point of idempotency is that a retry gets **the same answer**, not merely that the work is
/// not repeated twice. A client that created a run, lost the connection, and retried needs the run
/// id back — telling it "already done" without the id leaves it unable to continue, and it will
/// poll or guess. So the status code and the body are kept, and a genuine retry replays them.
///
/// ## Why the request is hashed rather than stored
///
/// Two reasons, and the second is the important one. A request body can be 340 MB (a file upload),
/// so storing it would make this table the largest in the product. And a stored body is a second
/// copy of customer content with its own lifetime, its own RLS surface and its own deletion
/// obligation — a hash carries exactly the information needed to answer "is this the same
/// request?" and nothing else.
///
/// ## Scope
///
/// A key belongs to **one actor in one plane**. `scope_key` exists so that can be a plain unique
/// index: `tenant_id` is nullable for a platform-plane request, and a NULL in a unique index makes
/// every row distinct from every other, so Postgres would happily accept a duplicate key. The
/// check constraint keeps the two columns in step.
///
/// Scoping to the actor is not tidiness — it is what stops one customer replaying another
/// customer's key and being handed their response body.
model IdempotencyRecord {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for a platform-plane request. The RLS policy is the strict one: a NULL-tenant row is a
  /// platform actor's, holds their response, and is **not** shared with tenant readers — unlike
  /// `provider_profiles`, where a NULL row is shared configuration with no company data in it.
  tenantId String? @map("tenant_id") @db.Uuid

  /// `tenant_id` as text, or the literal `platform`. See the note on this model.
  scopeKey String @map("scope_key") @db.VarChar(60)

  /// Who issued the key. Part of its identity: a key is unique per actor, never globally.
  userId String @map("user_id") @db.Uuid

  /// The client's `Idempotency-Key` header, verbatim.
  key String @db.VarChar(200)

  method String @db.VarChar(10)
  /// The route, for an operator reading the table. Not part of the key's identity — a client that
  /// reused one key on two routes made a mistake, and the request hash catches it as a conflict.
  path   String @db.VarChar(500)

  /// SHA-256 of the method, path and body. A retry with different content is a conflict, not a
  /// replay — see `decideIdempotency`.
  requestHash String @map("request_hash") @db.Char(64)

  /// Null while the first attempt is still running. That is the `InFlight` case: a retry has
  /// nothing to replay yet, and answering it would mean waiting on another request's outcome.
  statusCode   Int?  @map("status_code")
  responseBody Json? @map("response_body") @db.JsonB

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// `IDEMPOTENCY_WINDOW_HOURS` after it was created. A record past this is swept; a key reused
  /// after it is forgotten is simply a new request, which is the honest behaviour — pretending to
  /// remember forever would make the table grow without bound.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, userId, key], map: "idempotency_key_is_unique_per_actor")
  @@index([expiresAt])
  @@index([tenantId, createdAt])
  @@map("idempotency_records")
}

/// An employee's photo — Prompt 40A (CR-03) §3.
///
/// ## Why a pointer table and not a column
///
/// Three reasons, and the third is the one that decided it.
///
/// A photo is a **file**, so it belongs in the Prompt 35 file layer: that gets it the storage
/// abstraction the prompt asks for ("not base64 in normal DB fields"), the size validation, the
/// malware scan and the audit trail, none of which a bespoke column would have.
///
/// It is **company-specific**, not part of the portable UBoss identity. A photo taken at one
/// employer does not travel to the next — the same care Prompt 37A took over what crosses a company
/// boundary.
///
/// And it must **survive re-employment**. Hanging it off `EmploymentRecord` would lose it when a
/// record ends, and a person rehired six months later would silently reappear with no photo. Keyed
/// on tenant and user, it does not.
///
/// The six mandatory Add Employee fields are untouched. This is optional, and the API says so.
model EmployeePhoto {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// The file itself, in the company's own file store.
  storedFileId String @map("stored_file_id") @db.Uuid

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file   StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Cascade)

  /// One photo per person per company. Replacing means replacing, not accumulating — otherwise
  /// "remove my photo" would leave earlier ones reachable by id.
  @@unique([tenantId, userId], map: "one_photo_per_person_per_company")
  @@index([tenantId, storedFileId])
  @@map("employee_photos")
}

/// Who may run an Engine Agent — Prompt 40A (CR-03) §5.
///
/// The "assignment/share" half of the seven run preconditions. A row here says this person is
/// expected to operate this agent; it is **not** a permission and it grants nothing on its own —
/// `agents:Run`, scope, a live version, approval, connections and budget are all still checked,
/// and `firstUnmetPrecondition` reports whichever fails first.
///
/// A table rather than a column on the agent, because an agent may be operated by several people:
/// a rota, a team, a holiday cover. A single `assignedToUserId` would have forced the second
/// person to be given somebody else's login or a builder role, which are the two things this
/// amendment exists to avoid.
model EngineAgentOperator {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  engineAgentId String @map("engine_agent_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid

  /// Who shared it, so "why can this person run this?" has an answer with a name on it.
  sharedByUserId String   @map("shared_by_user_id") @db.Uuid
  sharedAt       DateTime @default(now()) @map("shared_at") @db.Timestamptz(6)

  /// Set when the share was withdrawn. Kept rather than deleted: "this person could run this,
  /// until this date" is exactly what an access review asks for.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  EngineAgent @relation(fields: [engineAgentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, engineAgentId, userId], map: "one_share_per_person_per_agent")
  @@index([tenantId, userId, revokedAt])
  @@map("engine_agent_operators")
}

/// The Job Method for one piece of assigned AI work — Prompt 40A (CR-03) §4.
///
/// Downloaded as a form, filled in offline by somebody who may have no Agent Builder access at all,
/// and imported by an authorized builder. See `packages/types/src/job-method.ts` for why this is a
/// third artifact rather than part of Form 2 (whose structure is locked) or part of the Skill.
model JobMethod {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// The work this describes. One Job Method per assignment: a second one would leave two answers
  /// to "how is this done" with nothing to say which is current.
  aiWorkAssignmentId String @map("ai_work_assignment_id") @db.Uuid

  /// The Objective version the form was aligned to. An import from an older version is refused
  /// rather than mapped, because the workflow it described has since changed.
  objectiveVersionId String @map("objective_version_id") @db.Uuid

  /// From `JOB_METHOD_FORM_VERSION`. The shape of the form, not the content.
  formVersion Int @default(1) @map("form_version")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int      @default(1) @map("row_version")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows    JobMethodRow[]
  imports JobMethodImport[]

  @@unique([tenantId, aiWorkAssignmentId], map: "one_job_method_per_assignment")
  @@index([tenantId, objectiveVersionId])
  @@map("job_methods")
}

/// One step of a Job Method: the thirteen columns.
///
/// Every cell nullable except the step, because a **partially filled form is the normal case** —
/// the person filling it in may not know the tool, and there may be no approval. Requiring all
/// thirteen would push people into typing "n/a", which is worse than an empty cell because it is
/// indistinguishable from a real answer.
model JobMethodRow {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  jobMethodId String @map("job_method_id") @db.Uuid

  /// 1-based, as the person filling the form counts.
  step Int

  whatExactWork       String? @map("what_exact_work") @db.VarChar(2000)
  inputExactInput     String? @map("input_exact_input") @db.VarChar(2000)
  whereInputSource    String? @map("where_input_source") @db.VarChar(2000)
  toolSystemWorkplace String? @map("tool_system_workplace") @db.VarChar(2000)
  howExactMethod      String? @map("how_exact_method") @db.VarChar(2000)
  ruleFormulaCheck    String? @map("rule_formula_check") @db.VarChar(2000)
  output              String? @db.VarChar(2000)
  outputDestination   String? @map("output_destination") @db.VarChar(2000)
  approval            String? @db.VarChar(2000)
  agentMustNeverDo    String? @map("agent_must_never_do") @db.VarChar(2000)
  ifMissingOrWrong    String? @map("if_missing_or_wrong") @db.VarChar(2000)
  time                String? @db.VarChar(2000)

  /// Where each value came from, keyed by column: `UploadedForm`, `Form2Prefill` or
  /// `BuilderEdit`.
  ///
  /// The prompt asks to "preserve source provenance", and this is why it matters: after a merge a
  /// draft holds some cells the company typed offline and some UBoss prefilled. Six weeks later,
  /// "did we decide this or did the system?" is unanswerable without it — and that is exactly the
  /// question asked when an agent does something unexpected.
  provenance Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobMethod JobMethod @relation(fields: [jobMethodId], references: [id], onDelete: Cascade)

  @@unique([jobMethodId, step], map: "one_row_per_step")
  @@index([tenantId, jobMethodId])
  @@map("job_method_rows")
}

/// One upload of a completed Job Method form — Prompt 40A (CR-03) §4.
///
/// Kept whether or not it was accepted, and that is the point: a **refused** import is the more
/// interesting record. "I sent that form in three weeks ago" is answered by a row saying it arrived,
/// which version it claimed, and why it was not applied.
model JobMethodImport {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId    String @map("tenant_id") @db.Uuid
  jobMethodId String @map("job_method_id") @db.Uuid

  filename String @db.VarChar(400)
  /// SHA-256 of the uploaded bytes, so the same file resubmitted is recognisable.
  contentHash String @map("content_hash") @db.Char(64)

  /// The form version the file claimed, which may be one this build refuses.
  claimedFormVersion Int? @map("claimed_form_version")

  /// From `IMPORT_STAGES`: the stage it reached. A refusal names where it stopped.
  stage String @db.VarChar(30)

  accepted Boolean

  /// Set when it was refused, in words the person who uploaded it can act on.
  refusedBecause String? @map("refused_because") @db.VarChar(2000)

  /// The flagged problems, as `ImportProblem[]`. Missing, invalid, ambiguous and unmapped are
  /// distinct kinds because only one of them is a mistake; see the types module.
  problems Json @default("[]") @db.JsonB

  rowsRead     Int @default(0) @map("rows_read")
  rowsAccepted Int @default(0) @map("rows_accepted")

  importedByUserId String   @map("imported_by_user_id") @db.Uuid
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobMethod JobMethod @relation(fields: [jobMethodId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobMethodId, importedAt])
  @@map("job_method_imports")
}

/// A Workspace Chat conversation — Prompt 40A (CR-03) §6.
model ChatConversation {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// From `CONVERSATION_KINDS`: `Direct` or `Group`.
  kind String @db.VarChar(20)

  /// Null for a direct message, which has no name.
  title String? @db.VarChar(120)

  /// For a direct message, the two participant ids sorted and joined.
  ///
  /// Exists to make a direct conversation's identity stable. Without it, two people who message
  /// each other at the same moment get two conversations and each sees half the history — a bug
  /// that presents as lost messages and is very hard to explain.
  directKey String? @map("direct_key") @db.VarChar(120)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Denormalised so a conversation list can be ordered without reading every message.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]
  contextRefs  ChatContextRefRow[]

  @@unique([tenantId, directKey], map: "one_direct_conversation_per_pair")
  @@index([tenantId, lastMessageAt])
  @@map("chat_conversations")
}

/// Somebody in a conversation, and how far they have read.
model ChatParticipant {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId       String @map("tenant_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  /// One marker per participant, not a row per message read.
  ///
  /// With a hundred people and a thousand messages the per-message table is a hundred thousand
  /// rows that exist only to render a number, and every one is a write on a screen scroll. The
  /// trade is that a marker cannot express "read the newest and skipped one in the middle" —
  /// which nobody needs, and pretending otherwise is how the hundred thousand rows get built.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId], map: "one_participant_row_per_person")
  @@index([tenantId, userId])
  @@map("chat_participants")
}

/// A message.
model ChatMessage {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId       String @map("tenant_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  authorUserId   String @map("author_user_id") @db.Uuid

  body String @db.VarChar(4000)

  /// Resolved at write time and stored, so a mention notification does not depend on re-parsing.
  /// Only ids of people **in the conversation**: a mention of somebody outside it would notify
  /// them about a conversation they cannot open, which both leaks its existence and sends them
  /// somewhere they are refused.
  mentionedUserIds String[] @map("mentioned_user_ids") @db.Uuid

  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  /// Soft delete: the row stays so the conversation keeps its shape and the reply above it still
  /// makes sense. The body is cleared by the service.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  conversation ChatConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  ChatMessageAttachment[]

  @@index([conversationId, sentAt])
  @@index([tenantId, sentAt])
  @@map("chat_messages")
}

/// An attachment on a message — a file in the company's own file store.
///
/// A join row rather than a column, so a message may carry a few, and so the file keeps its own
/// scan state, classification, retention and audit. A second file pipeline "just for chat" is
/// exactly how one upload path in a product ends up unscanned.
model ChatMessageAttachment {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId     String @map("tenant_id") @db.Uuid
  messageId    String @map("message_id") @db.Uuid
  storedFileId String @map("stored_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile  @relation(fields: [storedFileId], references: [id], onDelete: Cascade)

  @@unique([messageId, storedFileId], map: "one_attachment_row_per_file")
  @@index([tenantId, storedFileId])
  @@map("chat_message_attachments")
}

/// What a conversation is *about* — Prompt 40A (CR-03) §6.
///
/// ## A type and an id, and deliberately nothing else
///
/// No cached title, no cached status, no cached summary. A cached title is a copy of the resource's
/// content sitting outside its own authorization: the moment it is stored, anybody who can read the
/// conversation can read it, and no permission check will ever run again. It would also go stale,
/// so it would be a leak *and* wrong.
///
/// Every preview is resolved against the **viewer's** own permissions at read time, and a viewer
/// without access gets a stated refusal rather than a blank. **Chat membership grants no access to
/// the referenced resource** — that is the one rule this whole feature is built around.
model ChatContextRefRow {
  id String @id @default(uuid(7)) @db.Uuid

  tenantId       String @map("tenant_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  /// From `CHAT_CONTEXT_TYPES`. A closed set, because each type needs a resolver that knows how
  /// to check the viewer's access to that kind of thing.
  contextType String @map("context_type") @db.VarChar(40)
  resourceId  String @map("resource_id") @db.Uuid

  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, contextType, resourceId], map: "one_reference_per_resource")
  @@index([tenantId, contextType, resourceId])
  @@map("chat_context_refs")
}
