# apps/api — environment example. Copy to .env (or .env.local); never commit real values.

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated browser origins permitted to call this API.
API_CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL (Prompt 3) ----
# Matches infra/docker-compose.yml, which publishes PostgreSQL on 5442 — NOT the default 5432.
# Other UBoss-named stacks from different project directories already occupy 5432 and 5433 on
# this machine; never point this repository at those databases.
#
# Start it with:  docker compose -f infra/docker-compose.yml up -d
#
# These local credentials are development-only and are not secrets. In every real environment
# DATABASE_URL is injected from a secret manager and never written to a file.
DATABASE_URL=postgresql://uboss:uboss_local_dev@localhost:5442/uboss_dev?schema=public

# Integration tests use a separate database so they can truncate tables freely. The harness
# refuses to run against a database whose name does not contain "test".
TEST_DATABASE_URL=postgresql://uboss:uboss_local_dev@localhost:5442/uboss_test?schema=public

# ---- Not used yet. Listed so the expected shape is discoverable. ----
# Prompt 21 — Redis (cache, locks, rate limits) and BullMQ
REDIS_URL=redis://localhost:6381

# ---- Enterprise identity (Prompt 6) ----
#
# REQUIRED. Encryption keys for the three secrets UBoss must be able to *use* rather than merely
# compare: the TOTP shared secret, a company's OIDC client secret and a PKCE code verifier. See
# docs/SECURITY_DECISIONS.md S-028 for why those three cannot be hashed.
#
# Format: id:base64key[,id:base64key...]. The FIRST entry seals new values; the rest are retained
# so previously sealed values can still be opened. That is how a key is rotated — add the new key
# first, keep the old one until nothing references it, then remove it. Dropping a key too early
# fails loudly and names it.
#
# Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# The process REFUSES TO START without a valid key, deliberately: a deployment that cannot decrypt
# a TOTP secret would otherwise look healthy and fail at someone's first sign-in.
#
# NEVER commit a real value. In a real environment this comes from a secret manager
# (Prompt 20 replaces the EncryptionKeyProvider seam with a KMS/Vault implementation).
AUTH_ENCRYPTION_KEYS=

# Public origin of THIS API. Used to build the SSO redirect URI, which an identity provider
# matches exactly — so it must be the externally reachable origin and cannot be inferred from a
# request, because the Host header is attacker-controlled. Must be https in production.
AUTH_PUBLIC_API_BASE_URL=http://localhost:4000

# Origin of the web application. The ONLY place an SSO callback will send a browser, which is what
# stops the callback becoming an open redirect.
AUTH_WEB_BASE_URL=http://localhost:3000

# ---- Optional: all have safe defaults, listed so the shape is discoverable ----
# Cookie holding the short-lived "password accepted, second factor pending" token.
# AUTH_MFA_COOKIE_NAME=uboss_mfa
# How long a second factor may be outstanding. Short on purpose: this is the one window in which a
# correct password alone has value to an attacker.
# AUTH_MFA_CHALLENGE_MINUTES=5
# Failed second-factor attempts allowed against one challenge before it is destroyed.
# AUTH_MFA_MAX_ATTEMPTS=5
# TOTP clock drift accepted either side of now, in 30-second steps.
# AUTH_TOTP_WINDOW_STEPS=1
# Issuer name shown in the authenticator app.
# AUTH_TOTP_ISSUER=UBoss
# How long a company has to publish the DNS record proving it controls a domain.
# AUTH_DOMAIN_VERIFICATION_EXPIRY_HOURS=168
# How long an in-flight SSO authorization request stays valid.
# AUTH_SSO_REQUEST_MINUTES=10
