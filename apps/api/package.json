{
  "name": "@uboss/api",
  "version": "0.1.0",
  "private": true,
  "description": "UBoss backend — NestJS. Prompt 1 exposes only an unauthenticated /health endpoint.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "concurrently -n tsc,node -c gray,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/**/*.spec.js\"",
    "db:up": "docker compose -f ../../infra/docker-compose.yml up -d",
    "db:down": "docker compose -f ../../infra/docker-compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "npm run build:scripts && prisma db seed",
    "db:reset": "node scripts/reset-database.mjs",
    "db:reset:dry-run": "node scripts/reset-database.mjs --dry-run",
    "db:studio": "prisma studio",
    "build:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@node-rs/argon2": "2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@uboss/types": "0.1.0",
    "bullmq": "^5.81.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "8.3.0",
    "ioredis": "^5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2"
  }
}
