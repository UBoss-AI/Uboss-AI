# apps/web — environment example. Copy to .env.local; never commit real values.

# Next.js reads PORT for both `next dev` and `next start`.
PORT=3000

# Base URL the browser and server components use to reach apps/api.
# NEXT_PUBLIC_* values are inlined into the client bundle — never put a secret behind this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
