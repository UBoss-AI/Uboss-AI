# UBoss — root environment example.
# Copy to .env.local (never commit real values). Placeholders only: no real secrets belong in this file.
# Locked rule: no plaintext passwords or reusable provider credentials in normal UI/database fields.
# From Prompt 5 onward, secret material is referenced through KMS / Secrets Manager / Vault, never inlined.

# ---- Runtime ----
NODE_ENV=development

# ---- apps/api ----
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000

# ---- apps/web ----
WEB_PORT=3000
# Base URL the browser uses to reach apps/api. NEXT_PUBLIC_* values are exposed to the client:
# never place a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Reserved for later prompts (declared here so the shape is known) ----
# PostgreSQL (Prompt 3) — infra/docker-compose.yml publishes it on 5442, not 5432.
DATABASE_URL=postgresql://uboss:uboss_local_dev@localhost:5442/uboss_dev?schema=public
# Prompt 5  — sessions
# SESSION_SECRET_REF=vault://uboss/session-secret
# Prompt 21 — Redis / BullMQ
# REDIS_URL=redis://localhost:6379
# Prompt 25 — S3-compatible object storage
# OBJECT_STORAGE_ENDPOINT=
# Prompt 25 — AI providers (referenced by secret handle, never a raw key)
# AI_PROVIDER_KEY_REF=vault://uboss/ai-provider-key

# ---- Mail (optional) ----
# All or nothing. Set every one of HOST, USERNAME and PASSWORD to send real mail, or none of them
# to keep the logging adapter, which records messages and reports deliversRealMail:false. A partial
# set refuses to start: a host with no password is somebody halfway through setting this up, and
# quietly sending nothing is how that reaches production.
#
# STARTTLS is required on a plain port and cannot be turned off from the environment. Port 465 is
# implicit TLS instead.
UBOSS_SMTP_HOST=
UBOSS_SMTP_PORT=587
UBOSS_SMTP_USERNAME=
UBOSS_SMTP_PASSWORD=
# Defaults to the username.
UBOSS_SMTP_FROM_EMAIL=
UBOSS_SMTP_FROM_NAME=UBoss
