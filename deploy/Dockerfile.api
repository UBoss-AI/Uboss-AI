FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/config/package.json packages/config/package.json
RUN npm ci

COPY apps/api apps/api
COPY packages/types packages/types
COPY packages/ui packages/ui
COPY packages/config packages/config
RUN npm run build:packages && npm run build --workspace @uboss/api

FROM node:24-bookworm-slim AS runtime
# `unzip` is for the Skill catalogue seed: an .xlsx is a zip, and the slim image has none, so
# without it the seed fails at boot on a fresh database — after the point where the entrypoint has
# already committed to running it.
RUN apt-get update && apt-get install -y --no-install-recommends openssl unzip && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=4000
WORKDIR /workspace
COPY --from=build --chown=node:node /workspace/package.json ./package.json
COPY --from=build --chown=node:node /workspace/package-lock.json ./package-lock.json
COPY --from=build --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=node:node /workspace/apps/web/package.json ./apps/web/package.json
COPY --from=build --chown=node:node /workspace/packages/ui/package.json ./packages/ui/package.json
COPY --from=build --chown=node:node /workspace/apps/api/dist ./apps/api/dist
COPY --from=build --chown=node:node /workspace/apps/api/prisma ./apps/api/prisma
COPY --from=build --chown=node:node /workspace/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=build --chown=node:node /workspace/apps/api/scripts/bootstrap-platform-owner.mjs ./apps/api/scripts/bootstrap-platform-owner.mjs
# The model catalogue, without which ANTHROPIC_API_KEY is a credential for a call nothing knows
# how to route — see the script's own header.
COPY --from=build --chown=node:node /workspace/apps/api/scripts/seed-model-catalogue.mjs ./apps/api/scripts/seed-model-catalogue.mjs
# And the one that sends Objective analysis to OpenAI, which the client asked for by name. It
# runs after the catalogue above and repoints a single route; without OPENAI_API_KEY it does
# nothing at all.
COPY --from=build --chown=node:node /workspace/apps/api/scripts/seed-openai-planner.mjs ./apps/api/scripts/seed-openai-planner.mjs
# The Skill catalogue and the workbook it is read from. A database with no Skills makes Run
# Objective report "capability missing" on work it could have planned.
COPY --from=build --chown=node:node /workspace/apps/api/scripts/import-skill-catalog.mjs ./apps/api/scripts/import-skill-catalog.mjs
COPY --from=build --chown=node:node /workspace/apps/api/data ./apps/api/data
COPY --from=build --chown=node:node /workspace/packages/types ./packages/types
COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod 755 /usr/local/bin/api-entrypoint.sh
USER node
EXPOSE 4000
CMD ["/usr/local/bin/api-entrypoint.sh"]
