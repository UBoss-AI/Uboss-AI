{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "UBoss library package (built with tsc to dist/)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* CommonJS output on purpose: apps/api (NestJS) is CommonJS and cannot `require()` an
       ESM-only package, while Next.js consumes CommonJS without complaint. One build output
       therefore serves both consumers. See docs/ARCHITECTURE_DECISIONS.md (ADR-005).
       `module: Node16` emits CommonJS here because these packages do not declare
       `"type": "module"`, while still giving modern Node resolution semantics. */
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    /* Library packages are tested with the built-in Node test runner (node:test), so Node
       globals and module types must be visible to tsc. */
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  }
}
